+/* The client's short name, for the log: which process bound the microphone (selftest / VoiceMemos /
+ * mediaserverd itself). kp_proc.p_comm is MAXCOMLEN+1 bytes; a failed lookup says "?". */
+static const char *
+client_name(pid_t pid, char *buffer, size_t size)
+{
+	int mib[4] = { CTL_KERN, KERN_PROC, KERN_PROC_PID, (int)pid };
+	struct kinfo_proc info;
+	size_t length = sizeof(info);
+
+	buffer[0] = '\0';
+	if (sysctl(mib, 4, &info, &length, NULL, 0) == 0 && length >= sizeof(info)) {
+		snprintf(buffer, size, "%s", info.kp_proc.p_comm);
+	}
+	if (buffer[0] == '\0') {
+		snprintf(buffer, size, "?");
+	}
+	return buffer;
+}
