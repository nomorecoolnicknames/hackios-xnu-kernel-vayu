+/*
+ * S8: 120 Hz touch delivery -- the other half of a finger-driven scroll.
+ *
+ * TEST24's synthetic swipes produced 105-121 frames a second, but the application counted only
+ * 20-32 -[UIApplication sendEvent:] calls in the same seconds although 240 samples a second reached
+ * the kernel: the window server drew at 120 and handed the touch to UIKit at about 30. That is a
+ * second, separate gate from the frame-rate one, and iOS has a name for it: UIKitCore has
+ * -[<something> _shouldGenerate120HzEvents] and libMobileGestalt exports
+ * _MobileGestalt_get_touchDelivery120Hz (both in the 20F66 cache: the selector at
+ * dyld_shared_cache_arm64.01/17, the symbol in ...42.dyldlinkedit). On a device whose identity is an
+ * iPhone X (no ProMotion) the answer is expected to be NO.
+ *
+ * So, in a process that is to have it:
+ *   1. the MobileGestalt getter is asked once and its answer logged; if 0, its code is made to
+ *      answer 1 (`mov w0, #1; ret`), which is per-process and affects nothing else;
+ *   2. every class that has _shouldGenerate120HzEvents with a BOOL return has it answered YES.
+ * Both are logged with the old value, so a run says which of the two was the gate. `s8_touch=0`
+ * leaves both alone.
+ */
+typedef bool (*s8_bool_answer)(void);
+
+static BOOL
+s8_yes(id self, SEL selector)
+{
+	(void)self;
+	(void)selector;
+	return YES;
+}
+
+static void
+s8_touch_delivery(void)
+{
+	static bool said;
+	void *getter = dlsym(RTLD_DEFAULT, "_MobileGestalt_get_touchDelivery120Hz");
+	SEL selector = sel_registerName("_shouldGenerate120HzEvents");
+	Class *classes;
+	int count, replaced = 0;
+
+	if (!s8_touch_wanted()) {
+		if (!said) {
+			say("hakios: %s: s8_touch=0: 120 Hz touch delivery is left as it is\n", getprogname());
+			said = true;
+		}
+		return;
+	}
+	if (said) {
+		return;
+	}
+	said = true;
+	if (getter == NULL) {
+		say("hakios: %s: s8: no _MobileGestalt_get_touchDelivery120Hz in this process\n", getprogname());
+	} else {
+		bool answer = ((s8_bool_answer)getter)();
+
+		say("hakios: %s: s8: _MobileGestalt_get_touchDelivery120Hz at %p answers %d\n", getprogname(), getter,
+		    answer ? 1 : 0);
+		if (!answer) {
+			/*
+			 * mov w0, #1 ; ret -- bool is returned in w0. The page is in the dyld shared
+			 * cache; mprotect() makes this process's mapping writable, and the write is
+			 * private to it.
+			 */
+			static const uint32_t answer_yes[2] = { 0x52800020u, 0xd65f03c0u };
+			uintptr_t page = (uintptr_t)getter & ~(uintptr_t)0x3fffu;
+
+			if (mprotect((void *)page, 0x4000, PROT_READ | PROT_WRITE | PROT_EXEC) == 0) {
+				memcpy(getter, answer_yes, sizeof(answer_yes));
+				sys_icache_invalidate(getter, sizeof(answer_yes));
+				say("hakios: %s: s8: patched it to answer 1\n", getprogname());
+			} else {
+				say("hakios: %s: s8: mprotect(%p): %s: left at 0\n", getprogname(), (void *)page,
+				    strerror(errno));
+			}
+		}
+	}
+	count = objc_getClassList(NULL, 0);
+	classes = count > 0 ? malloc(sizeof(Class) * (size_t)count) : NULL;
+	if (classes != NULL) {
+		Method done[8];
+		unsigned done_count = 0;
+
+		count = objc_getClassList(classes, count);
+		for (int i = 0; i < count && done_count < 8; i++) {
+			Method method = class_getInstanceMethod(classes[i], selector);
+			if (method == NULL) {
+				method = class_getClassMethod(classes[i], selector);
+			}
+			const char *types = method != NULL ? method_getTypeEncoding(method) : NULL;
+			IMP old = method != NULL ? method_getImplementation(method) : NULL;
+			bool seen = false;
+
+			for (unsigned d = 0; d < done_count; d++) {
+				seen = seen || done[d] == method;
+			}
+			if (method == NULL || seen || old == (IMP)s8_yes) {
+				continue;
+			}
+			/* BOOL is 'B' (or 'c' on older encodings); anything else is not this switch. */
+			if (types == NULL || (types[0] != 'B' && types[0] != 'c')) {
+				say("hakios: %s: s8: -[%s _shouldGenerate120HzEvents] has type %s: left alone\n",
+				    getprogname(), class_getName(classes[i]), types != NULL ? types : "?");
+				continue;
+			}
+			done[done_count++] = method;
+			method_setImplementation(method, (IMP)s8_yes);
+			replaced++;
+			say("hakios: %s: s8: -[%s _shouldGenerate120HzEvents] (%s, was %p) answers YES\n", getprogname(),
+			    class_getName(classes[i]), types, old);
+		}
+		free(classes);
+	}
+	if (replaced == 0) {
+		say("hakios: %s: s8: no _shouldGenerate120HzEvents with a BOOL answer in this process\n", getprogname());
+	}
+}
