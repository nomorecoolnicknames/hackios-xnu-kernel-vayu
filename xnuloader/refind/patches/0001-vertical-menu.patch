+// HakiOS/vayu (vertical_menu true): the main menu as one column of rows for a portrait screen (1080x2400 on
+// the POCO X3 Pro): each entry a row with its icon at the left and its title beside it, the volume keys
+// (SCAN_UP/SCAN_DOWN) moving through every entry, wrapping at the ends. The rest of rEFInd as it is.
+#define VMENU_GAP (24)
+static EG_IMAGE *VMenuSelection = NULL;
+
+static BOOLEAN VMenuOn(VOID) {
+    return GlobalConfig.VerticalMenu && AllowGraphicsMode;
+}
+
+static UINTN VMenuTop(VOID) {
+    return UGAHeight / 4;
+}
+
+static UINTN VMenuRowWidth(VOID) {
+    return UGAWidth - 2 * (UGAWidth / 12);
+}
+
+static UINTN VMenuPitch(VOID) {
+    return TileSizes[0] + VMENU_GAP;
+}
+
+static UINTN VMenuMaxRows(VOID) {
+    UINTN Bottom = UGAHeight * 13 / 16, Rows;
+
+    Rows = (Bottom > VMenuTop()) ? (Bottom - VMenuTop()) / VMenuPitch() : 1;
+    return (Rows > 0) ? Rows : 1;
+}
