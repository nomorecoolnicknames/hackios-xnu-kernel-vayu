+// The title a row shows: a manual stanza's own title ("HakiOS"), else rEFInd's ("Boot ... from ...")
+static CHAR16 *VMenuTitle(REFIT_MENU_ENTRY *Entry) {
+    LOADER_ENTRY *Loader = (LOADER_ENTRY *) Entry;
+
+    if ((Entry->Tag == TAG_LOADER) && (Loader->DiscoveryType == DISCOVERY_TYPE_MANUAL) && (Loader->Title != NULL))
+        return Loader->Title;
+    return Entry->Title;
+}
+
+static VOID VMenuDrawEntry(REFIT_MENU_ENTRY *Entry, BOOLEAN Selected, UINTN Slot) {
+    UINTN RowW = VMenuRowWidth(), RowH = TileSizes[0];
+    UINTN PosX = (UGAWidth - RowW) / 2, PosY = VMenuTop() + Slot * VMenuPitch();
+    UINTN TextX = RowH + VMENU_GAP, IconX = 0, IconY = 0;
+    UINT8 Bright;
+    EG_IMAGE *Row;
+
+    if (PosY + RowH > UGAHeight)
+        return;
+    Row = egCropImage(GlobalConfig.ScreenBackground, PosX, PosY, RowW, RowH);
+    if (Row == NULL)
+        return;
+    Bright = (Row->PixelData[0].r + Row->PixelData[0].g + Row->PixelData[0].b) / 3;
+    if (Selected && VMenuSelection)
+        egComposeImage(Row, VMenuSelection, 0, 0);
+    if (Entry->Image) {
+        if (Entry->Image->Width < RowH)
+            IconX = (RowH - Entry->Image->Width) / 2;
+        if (Entry->Image->Height < RowH)
+            IconY = (RowH - Entry->Image->Height) / 2;
+        egComposeImage(Row, Entry->Image, IconX, IconY);
+    }
+    if ((TextX < RowW) && (egGetFontHeight() < RowH))
+        egRenderText(VMenuTitle(Entry), Row, TextX, (RowH - egGetFontHeight()) / 2, Bright);
+    BltImage(Row, PosX, PosY);
+    egFreeImage(Row);
+}
+
+static UINTN VMenuTextY(IN SCROLL_STATE *State) {
+    return VMenuTop() + State->MaxVisible * VMenuPitch() + VMENU_GAP;
+}
+
+static VOID VMenuPaintAll(IN REFIT_MENU_SCREEN *Screen, IN SCROLL_STATE *State) {
+    INTN i;
+
+    AdjustScrollState(State);
+    for (i = State->FirstVisible; (i <= State->LastVisible) && (i <= State->MaxIndex); i++)
+        VMenuDrawEntry(Screen->Entries[i], i == State->CurrentSelection, i - State->FirstVisible);
+}
+
+static VOID VMenuPaintSelection(IN REFIT_MENU_SCREEN *Screen, IN SCROLL_STATE *State) {
+    if ((State->CurrentSelection < State->FirstVisible) || (State->CurrentSelection > State->LastVisible)) {
+        VMenuPaintAll(Screen, State);
+        return;
+    }
+    if ((State->PreviousSelection >= State->FirstVisible) && (State->PreviousSelection <= State->LastVisible))
+        VMenuDrawEntry(Screen->Entries[State->PreviousSelection], FALSE, State->PreviousSelection - State->FirstVisible);
+    VMenuDrawEntry(Screen->Entries[State->CurrentSelection], TRUE, State->CurrentSelection - State->FirstVisible);
+}
+
+static VOID VMenuStyle(IN REFIT_MENU_SCREEN *Screen, IN SCROLL_STATE *State, IN UINTN Function, IN CHAR16 *ParamText)
+{
+    EG_IMAGE *Temp = NULL;
+
+    switch (Function) {
+        case MENU_FUNCTION_INIT:
+            InitScroll(State, Screen->EntryCount, GlobalConfig.MaxTags);
+            State->MaxVisible = VMenuMaxRows();
+            if ((GlobalConfig.MaxTags > 0) && (GlobalConfig.MaxTags < State->MaxVisible))
+                State->MaxVisible = GlobalConfig.MaxTags;
+            State->LastVisible = State->FirstVisible + State->MaxVisible - 1;
+            if (VMenuSelection == NULL) {
+                if (GlobalConfig.SelectionBigFileName != NULL)
+                    Temp = egLoadImage(SelfDir, GlobalConfig.SelectionBigFileName, TRUE);
+                if (Temp == NULL)
+                    Temp = egPrepareEmbeddedImage(&egemb_back_selected_big, TRUE);
+                if (Temp != NULL) {
+                    VMenuSelection = egScaleImage(Temp, VMenuRowWidth(), TileSizes[0]);
+                    egFreeImage(Temp);
+                }
+            }
+            InitSelection();
+            SwitchToGraphicsAndClear();
+            break;
+
+        case MENU_FUNCTION_CLEANUP:
+            break;
+
+        case MENU_FUNCTION_PAINT_ALL:
+            VMenuPaintAll(Screen, State);
+            break;
+
+        case MENU_FUNCTION_PAINT_SELECTION:
+            VMenuPaintSelection(Screen, State);
+            break;
+
+        case MENU_FUNCTION_PAINT_TIMEOUT:
+            DrawTextWithTransparency(L"", 0, VMenuTextY(State));
+            DrawTextWithTransparency(ParamText, (UGAWidth - egComputeTextWidth(ParamText)) >> 1, VMenuTextY(State));
+            break;
+    }
+}
