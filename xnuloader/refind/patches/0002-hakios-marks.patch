diff -ruN a/refind/hakios.c b/refind/hakios.c
--- a/refind/hakios.c	1970-01-01 00:00:00.000000000 +0000
+++ b/refind/hakios.c	2026-11-18 22:14:24.334308392 +0000
@@ -0,0 +1,50 @@
+/*
+ * HakiOS/vayu: see hakios.h. GPL v3, as rEFInd.
+ */
+#include "hakios.h"
+#include "lib.h"
+#include "../include/refit_call_wrapper.h"
+
+#define HAKIOS_HANDOFF_GUID { 0x6b1f6a4e, 0x2d39, 0x4c55, { 0x9a, 0x61, 0x3e, 0x0b, 0x7d, 0x52, 0xc4, 0x18 } }
+#define HAKIOS_HANDOFF_MAGIC 0x444e4652         /* "RFND" */
+
+typedef struct _hakios_handoff {
+    UINT32 Magic, Revision;
+    VOID (EFIAPI *Choose)(struct _hakios_handoff *This, UINT32 Choice);
+    /* revision 2 */
+    VOID (EFIAPI *Mark)(struct _hakios_handoff *This, CHAR16 *What, UINT32 Flags);
+    UINT32 ScanAll, TestHang;       /* TestHang: the loader's refind_test_hang=1, a test of its watchdog */
+} HAKIOS_HANDOFF;
+
+static HAKIOS_HANDOFF *Hakios = NULL;
+
+VOID HakiosInit(VOID) {
+    EFI_GUID Guid = HAKIOS_HANDOFF_GUID;
+    HAKIOS_HANDOFF *H = NULL;
+
+    if (!EFI_ERROR(refit_call3_wrapper(BS->LocateProtocol, &Guid, NULL, (VOID **) &H)) && (H != NULL) &&
+        (H->Magic == HAKIOS_HANDOFF_MAGIC) && (H->Revision >= 2) && (H->Mark != NULL))
+        Hakios = H;
+}
+
+BOOLEAN HakiosOn(VOID) {
+    return Hakios != NULL;
+}
+
+BOOLEAN HakiosScanAll(VOID) {
+    return (Hakios == NULL) || Hakios->ScanAll;
+}
+
+VOID HakiosMark(IN CHAR16 *What, IN UINTN Flags) {
+    if (Hakios != NULL)
+        Hakios->Mark(Hakios, What, (UINT32) Flags);
+}
+
+// refind_test_hang=1: rEFInd stops here for good, with no sign of life (the loader must reset the phone)
+VOID HakiosTestHang(VOID) {
+    if ((Hakios != NULL) && Hakios->TestHang) {
+        HakiosMark(L"test: hanging here", HAKIOS_MARK_STAGE);
+        for (;;)
+            refit_call1_wrapper(BS->Stall, 1000000);
+    }
+}
diff -ruN a/refind/hakios.h b/refind/hakios.h
--- a/refind/hakios.h	1970-01-01 00:00:00.000000000 +0000
+++ b/refind/hakios.h	2026-11-18 22:14:24.334308392 +0000
@@ -0,0 +1,20 @@
+/*
+ * HakiOS/vayu: the loader that started rEFInd (xnuloader/refind_menu.c in the HakiOS port) may offer a protocol;
+ * with it, rEFInd reports how far it got (HakiosMark: the loader's log and, before the menu is up, its screen) and
+ * scans only its own volume unless the loader says otherwise. Without the protocol nothing changes.
+ */
+#ifndef __HAKIOS_H_
+#define __HAKIOS_H_
+
+#include "global.h"
+
+#define HAKIOS_MARK_STAGE  1    /* a stage of the start: logged, flushed, shown */
+#define HAKIOS_MARK_SCREEN 2    /* rEFInd draws from here on: the loader stops drawing its marks */
+
+VOID HakiosInit(VOID);
+BOOLEAN HakiosOn(VOID);
+BOOLEAN HakiosScanAll(VOID);
+VOID HakiosMark(IN CHAR16 *What, IN UINTN Flags);
+VOID HakiosTestHang(VOID);
+
+#endif
