diff -ruN a/refind/hakios.c b/refind/hakios.c
--- a/refind/hakios.c	2026-11-18 23:35:13.854891937 +0000
+++ b/refind/hakios.c	2026-11-18 23:35:13.858892121 +0000
@@ -14,6 +14,8 @@
     /* revision 2 */
     VOID (EFIAPI *Mark)(struct _hakios_handoff *This, CHAR16 *What, UINT32 Flags);
     UINT32 ScanAll, TestHang;       /* TestHang: the loader's refind_test_hang=1, a test of its watchdog */
+    /* revision 3 */
+    UINT32 Gfx, Reserved;           /* HAKIOS_GFX_* */
 } HAKIOS_HANDOFF;
 
 static HAKIOS_HANDOFF *Hakios = NULL;
@@ -40,6 +42,28 @@
         Hakios->Mark(Hakios, What, (UINT32) Flags);
 }
 
+static BOOLEAN MenuDrawn = FALSE;
+
+VOID HakiosMenuDrawn(VOID) {
+    MenuDrawn = TRUE;
+}
+
+VOID HakiosMarkf(IN CONST CHAR16 *Fmt, ...) {
+    CHAR16 Line[72];
+    va_list Args;
+
+    if ((Hakios == NULL) || MenuDrawn)
+        return;
+    va_start(Args, Fmt);
+    VSPrint(Line, sizeof(Line), (CHAR16 *) Fmt, Args);
+    va_end(Args);
+    Hakios->Mark(Hakios, Line, HAKIOS_MARK_STAGE);
+}
+
+UINT32 HakiosGfx(VOID) {
+    return ((Hakios != NULL) && (Hakios->Revision >= 3)) ? Hakios->Gfx : 0;
+}
+
 // refind_test_hang=1: rEFInd stops here for good, with no sign of life (the loader must reset the phone)
