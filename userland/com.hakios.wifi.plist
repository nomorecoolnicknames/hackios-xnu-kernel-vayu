<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.hakios.wifi</string>
	<!-- Wi-Fi step 5: configd built its network services before en0 existed, so give it one for
	     the radio's interface once the interface is there (net_test's "wifi-net" step:
	     /usr/sbin/addNetworkInterface -i en0, then the DHCP fallback); the old "net_test wifi"
	     ended at once on this phone, because its gate is wifi=1 and the kernel is booted with
	     vayu_wifi=2 -->
	<key>ProgramArguments</key>
	<array>
		<string>/redwood/bin/net_test</string>
		<string>wifi-net</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/dev/console</string>
	<key>StandardErrorPath</key>
	<string>/dev/console</string>
</dict>
</plist>
