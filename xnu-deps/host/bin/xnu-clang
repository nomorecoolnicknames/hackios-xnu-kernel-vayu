#!/bin/bash
# clang wrapper for cross-building XNU on Linux:
#  - forces an Apple Mach-O target (stock Linux clang defaults to ELF)
#  - drops flags only Apple's clang understands
#  - links with the cctools ld64
HB="$(cd "$(dirname "$0")" && pwd)"
case "$(basename "$0")" in *++) drv=clang++; extra=(-fno-use-cxa-atexit);; *) drv=clang; extra=();; esac
args=()
for a in "$@"; do
  case "$a" in
    # Linux clang 14 requires this gate for -ftrivial-auto-var-init=zero;
    # do not drop it (Apple's clang does not need it, but this wrapper is Linux-only).
    -enable-trivial-auto-var-init-zero-knowing-it-will-be-removed-from-clang) args+=("$a");;
    -fapple-kext-vtable-verify|-Wno-vla-cxx-extension) ;;
    -Werror|-Werror=*|-Weverything|-pedantic-errors) ;;
    *) args+=("$a");;
  esac
done
# A distribution's clang on Linux (Ubuntu 22.04's 14) does not look for libc++ in the SDK it is given, only beside
# itself: <cstddef> is not found. Name the SDK's own.
if [ "$drv" = clang++ ]; then
  sdk=
  for ((i = 0; i < ${#args[@]}; i++)); do
    [ "${args[i]}" = -isysroot ] && sdk=${args[i+1]}
  done
  [ -n "$sdk" ] && [ -d "$sdk/usr/include/c++/v1" ] && extra+=(-stdlib++-isystem "$sdk/usr/include/c++/v1")
fi
exec /usr/bin/$drv -include "$HB/../../hostinc/xnu_clang_compat.h" -target arm64-apple-ios${XNU_SDK_VERSION:-16.5} --ld-path="$HB/ld64" \
  -w "${extra[@]}" "${args[@]}"
