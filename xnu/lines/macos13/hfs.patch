+/*
+ * RENAME_SWAP for HFS+ (boot-arg macos_abi=1 only; hfs_vnop_renamex). Apple's HFS+ refuses it (ENOTSUP): on a Mac the
+ * volumes that see it are APFS. This port's macOS Data volume is HFS+, and launchd's boot task dirs_cleaner empties
+ * /tmp and /var/run by swapping each with a fresh directory (renamex_np RENAME_SWAP) and removing the old one; without
+ * the swap nothing was emptied, the *.didRunThisBoot markers of the last boot stayed, and on the next boot logind took
+ * it for a run that had already started a loginwindow: none came (QEMU AQUA r10, r14).
+ *
+ * The swap is three catalog renames in the rename's one journal transaction -- the source to a name of its own in its
+ * directory, the target to the source's place, the source to the target's -- so a crash leaves either nothing done
+ * or all of it (the journal), never half. Hard links and directories with directory-hard-link descendants are
+ * refused (EPERM), as are items that are an ancestor of the other's parent (EINVAL).
+ */
+/* whether ANCESTOR is DIR or one of DIR's ancestors (catalog lookups, the catalog locked shared by the caller) */
+static int
+hfs_swap_is_ancestor(struct hfsmount *hfsmp, cnid_t ancestor, cnid_t dir)
+{
+	struct cat_desc desc;
+
+	for (int depth = 0; depth < 4096 && dir >= kHFSRootFolderID; depth++) {
+		if (dir == ancestor) {
+			return 1;
+		}
+		if (dir == kHFSRootFolderID) {
+			return 0;
+		}
+		bzero(&desc, sizeof(desc));
+		if (cat_idlookup(hfsmp, dir, 0, 0, &desc, NULL, NULL) != 0) {
+			return 1;       /* cannot say: refuse */
+		}
+		dir = desc.cd_parentcnid;
+		cat_releasedesc(&desc);
+	}
+	return 1;
+}
