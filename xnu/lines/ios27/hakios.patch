+/*
+ * A load or store that sweet_a64e.c emulates (LDRAA/LDRAB, LDAPUR/STLUR) could not reach its address:
+ * the thread takes the data abort the instruction would have taken itself, as handle_user_abort()
+ * answers it. The VM says what the address is: KERN_INVALID_ADDRESS (SIGSEGV) where nothing is
+ * mapped, KERN_PROTECTION_FAILURE (SIGBUS) where the mapping does not allow the access; a fault it
+ * resolves now (the page was mapped meanwhile) runs the instruction again. An address copy_validate
+ * refused (outside the user map, so no VM fault was taken) is KERN_INVALID_ADDRESS. ESR and FAR of the
+ * thread's state say what an EL0 data abort at that address says, for the crash report.
+ */
+static void
+handle_a64e_emu_fault(arm_saved_state_t *state, const struct a64e_emu_fault *f)
+{
+	mach_exception_data_type_t codes[2];
+	thread_t                   thread = current_thread();
+	vm_map_t                   map    = thread->map;
+	kern_return_t              kr     = KERN_INVALID_ADDRESS;
+
+	if (f->vm) {
+		vm_prot_t prot = f->write ? (VM_PROT_READ | VM_PROT_WRITE) : VM_PROT_READ;
+		vm_map_offset_t va = vm_map_trunc_page(VM_USER_STRIP_TBI(f->addr), vm_map_page_mask(map));
+		kr = vm_fault(map, va, prot, /* change_wiring */ FALSE, VM_KERN_MEMORY_NONE, THREAD_ABORTSAFE,
+		    /* caller_pmap */ NULL, /* caller_pmap_addr */ 0);
+		if (kr == KERN_SUCCESS || kr == KERN_ABORTED) {
+			return;
+		}
+		if (kr == KERN_FAILURE) {
+			kr = KERN_INVALID_ADDRESS;
+		}
