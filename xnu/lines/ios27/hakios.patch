+	}
+	sweet_fb_vayu_config(fb);
+	__atomic_store_n(&sweet_fb_vayu_fb, fb, __ATOMIC_RELEASE);
+}
+
+struct sweet_fb_vayu_stat {
+	uint32_t crc, lit, white, text_rows, rows;
+	uint64_t us;
+};
+
+/*
+ * The panel as it is now: one pass over its memory. Each row is first copied out of the write-combined (Normal
+ * non-cacheable) mapping with memcpy's wide loads into a cached row, then summed: word-by-word loads of uncached
+ * memory took 0.89 s a frame on the phone (ak5-p2), long enough for anything else that writes the panel to land
+ * inside the pass. One thread measures (the tests' own), so the row buffer is a static one.
+ */
+static uint32_t sweet_fb_vayu_row[VAYU_FB_MAX_DIM];
+
+static void
+sweet_fb_vayu_measure(AppleCLCD *fb, struct sweet_fb_vayu_stat *st)
+{
+	uint64_t t0 = mach_absolute_time();
+	uint32_t crc = VAYU_FB_CRC_INIT, lit = 0, white = 0, text_rows = 0;
+	uint32_t row_white = 0;
+
+	__builtin_arm_dsb(0xf);                 /* (the framebuffer's writes are write-combined: out before they are read) */
+	for (uint32_t y = 0; y < fb->fHeight; y++) {
+		uint32_t w0 = white;
+		memcpy(sweet_fb_vayu_row, (const void *)(fb->fPixels + (uint64_t)y * fb->fRowBytes), (size_t)fb->fWidth * 4);
+		crc = vayu_fb_crc_rgb_row(sweet_fb_vayu_crc_tab, crc, sweet_fb_vayu_row, fb->fWidth, &lit, &white);
+		row_white += white - w0;
+		if ((y % 32) == 31 || y + 1 == fb->fHeight) {   /* the console's text rows: 16-pixel glyphs drawn twice as large */
+			text_rows += row_white != 0;
+			row_white = 0;
+		}
+	}
+	st->crc = VAYU_FB_CRC_END(crc);
+	st->lit = lit;
+	st->white = white;
+	st->text_rows = text_rows;
+	st->rows = (fb->fHeight + 31) / 32;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &st->us);
+	st->us /= 1000;
+}
+
+/*
+ * A frame that did not match: where the panel differs from the part of the surface it should show (count, bounding
+ * box, the first pixel), and whether the panel changes again by itself (read 300 ms later, no present in between:
+ * something else writes the framebuffer -- the firmware still running on the loader's core, say).
+ */
+static void
+sweet_fb_vayu_diff(AppleCLCD *fb, SweetSurface *s, uintptr_t px, uint32_t k, uint32_t crc_was)
+{
+	uint32_t n = 0, x0 = UINT32_MAX, y0 = UINT32_MAX, x1 = 0, y1 = 0, fx = 0, fy = 0, fp = 0, fs = 0, rows = 0, last_row = 0;
+
+	for (uint32_t y = 0; y < fb->fHeight; y++) {
+		const uint32_t *src = (const uint32_t *)(px + (uint64_t)(y + fb->fOffY) * s->bytesPerRow + (uint64_t)fb->fOffX * 4);
+		bool row_differs = false;
+		memcpy(sweet_fb_vayu_row, (const void *)(fb->fPixels + (uint64_t)y * fb->fRowBytes), (size_t)fb->fWidth * 4);
+		for (uint32_t x = 0; x < fb->fWidth; x++) {
+			if (((sweet_fb_vayu_row[x] ^ src[x]) & 0xffffff) == 0) {
+				continue;
+			}
+			if (n++ == 0) {
+				fx = x;
+				fy = y;
+				fp = sweet_fb_vayu_row[x];
+				fs = src[x];
+			}
+			x0 = x < x0 ? x : x0;
+			x1 = x > x1 ? x : x1;
+			row_differs = true;
+		}
+		if (row_differs) {
+			y0 = y < y0 ? y : y0;
+			y1 = y;
+			rows += y != last_row + 1 || rows == 0;     /* (runs of rows, counted roughly) */
+			last_row = y;
+		}
+	}
+	unsigned long long shown0 = __atomic_load_n(&sweet_fb_frames_shown, __ATOMIC_ACQUIRE);
+	IOSleep(300);
+	struct sweet_fb_vayu_stat st;
+	sweet_fb_vayu_measure(fb, &st);
+	unsigned long long shown1 = __atomic_load_n(&sweet_fb_frames_shown, __ATOMIC_ACQUIRE);
+	if (n == 0) {
+		IOLog("VAYU FBTEST: frame %u: no pixel differs now (the CRC pass saw something that is gone); 300 ms later crc32 "
+		    "%08x\n", k, st.crc);
+	} else {
+		IOLog("VAYU FBTEST: frame %u: %u pixel(s) differ in (%u,%u)-(%u,%u), %u run(s) of rows; first (%u,%u) panel %06x "
+		    "surface %06x\n", k, n, x0, y0, x1, y1, rows, fx, fy, fp & 0xffffff, fs & 0xffffff);
+	}
+	IOLog("VAYU FBTEST: frame %u: 300 ms later the panel's crc32 is %08x (%s), presents %llu -> %llu%s\n", k, st.crc,
+	    st.crc == crc_was ? "as measured" : "CHANGED", shown0, shown1,
+	    st.crc != crc_was && shown0 == shown1 ? ": SOMETHING ELSE WRITES THE FRAMEBUFFER" : "");
+}
+
+static void
+sweet_fb_vayu_stat_line(AppleCLCD *fb, const char *why)
+{
+	struct sweet_fb_vayu_stat st;
+	uint64_t now_ms = 0;
+
+	sweet_fb_vayu_measure(fb, &st);
+	absolutetime_to_nanoseconds(mach_absolute_time(), &now_ms);
+	now_ms /= 1000000;
+	IOLog("VAYU FB: stat %s at %llu ms: panel %ux%u crc32 %08x lit %u white %u text rows %u/%u (%llu us); swaps %llu, "
+	    "presented %llu, vsync ticks %llu, vsync notifications %llu\n", why, now_ms, fb->fWidth, fb->fHeight, st.crc, st.lit,
+	    st.white, st.text_rows, st.rows, st.us, sweet_fb_swap_count, sweet_fb_frames_shown, fb->vsyncCount(),
+	    __atomic_load_n(&sweet_fb_vayu_notified[SWEET_FB_NOTIFY_VSYNC], __ATOMIC_RELAXED));
+}
+
+/* ---- fb_120: the refresh follows the panel ------------------------------------------------------------------ */
+
+/*
+ * vayu27=1 fb_120=1 (default 0): iOS is told the display refreshes at 120 Hz ("IOMFBDisplayRefresh": 1/120 s), a
+ * frame is presented at every tick that has one (fFlushTicks 1, unless sweetfb_hz says otherwise), and the ticks --
+ * which are also the vsync notifications (type 5) -- follow the panel: with vayu_vsync=2 armed
+ * (bsd/dev/vayu_vsync.c: hakios_vsync_next/frame from INTF1's line counter) each tick is the panel's next frame start,
+ * at least 3/4 of a frame after the one before. Without the panel's timing (not armed yet, or disarmed: the counters
+ * stopped) the timer is 60 Hz as without fb_120 -- or 120 Hz of its own with fb_120_timer=1. Every 5 s one line:
+ * "VAYU FB120: <panel|timer 120|60 Hz>, ticks/s, notifications/s, swaps/s, presents/s". The counts are separate:
+ * panel frames (vayu_vsync's own lines), ticks told, SwapEnds, presents -- 120 of one is not 120 of another.
+ */
+static uint32_t sweet_fb_vayu_fb120, sweet_fb_vayu_fb120_timer;
+static uint64_t sweet_fb_vayu_tick_at;          /* the time the last tick was armed for */
+static int sweet_fb_vayu_mode = -1;             /* 0 60 Hz, 1 the panel's, 2 own 120 Hz timer */
+static uint64_t sweet_fb_vayu_line_at, sweet_fb_vayu_line_ticks, sweet_fb_vayu_line_notes, sweet_fb_vayu_line_swaps,
+    sweet_fb_vayu_line_shown;
+
+static void
+sweet_fb_vayu_fb120_line(AppleCLCD *fb, uint64_t now)
+{
+	uint64_t ms = 0;
+	if (sweet_fb_vayu_line_at == 0) {
+		sweet_fb_vayu_line_at = now;
+		return;
+	}
+	absolutetime_to_nanoseconds(now - sweet_fb_vayu_line_at, &ms);
+	ms /= 1000000;
+	if (ms < 5000) {
+		return;
+	}
+	uint64_t ticks = fb->vsyncCount(), notes = __atomic_load_n(&sweet_fb_vayu_notified[SWEET_FB_NOTIFY_VSYNC],
+	    __ATOMIC_RELAXED), swaps = sweet_fb_swap_count, shown = sweet_fb_frames_shown;
+	IOLog("VAYU FB120: %s: in %llu ms %llu ticks (%llu/s), %llu vsync notifications, %llu swaps, %llu presents\n",
+	    sweet_fb_vayu_mode == 1 ? "the panel's frame starts" : sweet_fb_vayu_mode == 2 ? "own 120 Hz timer" : "60 Hz timer",
+	    ms, ticks - sweet_fb_vayu_line_ticks, (ticks - sweet_fb_vayu_line_ticks) * 1000 / ms, notes - sweet_fb_vayu_line_notes,
+	    swaps - sweet_fb_vayu_line_swaps, shown - sweet_fb_vayu_line_shown);
+	sweet_fb_vayu_line_at = now;
+	sweet_fb_vayu_line_ticks = ticks;
+	sweet_fb_vayu_line_notes = notes;
+	sweet_fb_vayu_line_swaps = swaps;
+	sweet_fb_vayu_line_shown = shown;
+}
+
+/* the timer's next tick (vsyncFired, on the work loop): true if armed here, false for the usual 60 Hz timeout */
+static bool
+sweet_fb_vayu_rearm(AppleCLCD *fb, IOTimerEventSource *sender)
+{
+	if (!sweet_fb_vayu_fb120) {
+		return false;
+	}
+	uint64_t now = mach_absolute_time(), period = 0, next = 0;
+	uint64_t (*panel_next)(uint64_t) = __atomic_load_n(&hakios_vsync_next, __ATOMIC_ACQUIRE);
+	uint64_t (*panel_frame)(void) = __atomic_load_n(&hakios_vsync_frame, __ATOMIC_ACQUIRE);
+	int mode = 0;
+
+	sweet_fb_vayu_fb120_line(fb, now);
+	if (panel_next != NULL && panel_frame != NULL && (period = panel_frame()) != 0 && (next = panel_next(now)) != 0) {
+		mode = 1;
+		while (next < sweet_fb_vayu_tick_at + period - period / 4) {
+			next += period;         /* (a tick that came early: no two ticks within one panel frame) */
+		}
+	} else if (sweet_fb_vayu_fb120_timer) {
+		mode = 2;
+		nanoseconds_to_absolutetime(8333333ULL, &period);
+		next = sweet_fb_vayu_tick_at + period;
+		if (next <= now + period / 8 || next > now + 2 * period) {
+			next = now + period;    /* late (a long present) or the first: no burst */
+		}
+	}
+	if (mode != sweet_fb_vayu_mode) {
+		IOLog("VAYU FB120: the ticks now %s\n", mode == 1 ? "follow the panel's frame starts (vayu_vsync=2 armed)" :
+		    mode == 2 ? "come from a 120 Hz timer of our own (fb_120_timer=1; the panel's timing not armed)" :
+		    "come from the 60 Hz timer (the panel's timing not armed; fb_120_timer=1 for a 120 Hz one)");
+		sweet_fb_vayu_mode = mode;
+	}
+	if (mode == 0) {
+		sweet_fb_vayu_tick_at = now;
+		return false;
+	}
+	sweet_fb_vayu_tick_at = next;
+	sender->wakeAtTime(next);
+	return true;
+}
+
+/* ---- K8b: the GPU's frames (fence-to-present) ------------------------------------------------------------- */
+
+/*
+ * A surface the GPU draws into carries the last submission that named it (SweetSurface::gpuFence, HakiosGPU's SUBMIT).
+ * Before the display takes such a surface -- a flip (the MDP fetches it) or a copy (the CPU reads it) -- the GPU must be
+ * done with it: asked for up to vayu_gpu_present_ms (default 50) without a lock. Not done in time: the frame is not
+ * shown (a half-drawn frame is not one), counted. For a copy the CPU's view is then refreshed (dc ivac, K8's
+ * GPU -> CPU half); a flip needs nothing more (the MDP reads memory, the GPU's CACHE_FLUSH event wrote it there).
+ */
+extern "C" {
+bool hakios_gpu_done(uint32_t fence);
+void hakios_gpu_for_cpu(void *start, uint64_t size);
+bool HakiosGPUFillSurface(uint32_t surface, uint32_t *fence);
+}
+static uint32_t sweet_fb_vayu_gpu_waits, sweet_fb_vayu_gpu_late;
+
+static bool
+sweet_fb_vayu_gpu_ready(SweetSurface *s, bool for_cpu)
+{
+	uint32_t fence = __atomic_load_n(&s->gpuFence, __ATOMIC_ACQUIRE), ms = 50;
+	uint64_t t0, patience;
+
+	if (fence == 0) {
+		return true;                    /* (the GPU has never been given it) */
+	}
+	if (!hakios_gpu_done(fence)) {
+		PE_parse_boot_argn("vayu_gpu_present_ms", &ms, sizeof(ms));
+		nanoseconds_to_absolutetime((uint64_t)(ms > 1000 ? 1000 : ms) * NSEC_PER_MSEC, &patience);
+		t0 = mach_absolute_time();
+		sweet_fb_vayu_gpu_waits++;
+		while (!hakios_gpu_done(fence)) {
+			if (mach_absolute_time() - t0 > patience) {
+				if (sweet_fb_vayu_gpu_late++ < 16) {
+					IOLog("VAYU FB: surface %u: the GPU is not done with it (fence %u) after %u ms: not shown\n", s->id,
+					    fence, ms);
+				}
+				return false;
+			}
+			delay(100);
+		}
+	}
+	if (for_cpu) {
+		uintptr_t px = s->kernelAddress();
+		if (px != 0) {
+			hakios_gpu_for_cpu((void *)px, s->allocSize);
+		}
+	}
+	return true;
+}
+
+/* ---- fb_zero: the MDP scans the frame out, no copy ----------------------------------------------------------- */
+
+/*
+ * vayu27=1 fb_zero=1 vayu_mdp=2 (default 0): a frame that is one layer, one physically contiguous surface below 4 GB
+ * of the presented size (sweet_surface_create_contig) with whole rects, is not copied: the CPU's writes are cleaned to
+ * memory and VIG0 is pointed at the surface, cropped at the panel's offset (bsd/dev/vayu_mdp.c vayu_mdp_scanout). The
+ * surface shown is held until the next flip is taken (the hardware may still fetch it); a frame that cannot be
+ * flipped (another surface, a flip not taken) is copied into the boot framebuffer and VIG0 put back on it after the
+ * copy. Userland's IOSurfaces are not contiguous today: until they are (U3G1), only the test's frames flip.
+ */
+extern "C" bool vayu_mdp_scanout(uint64_t phys, uint32_t stride, uint32_t x, uint32_t y);
+extern "C" bool vayu_mdp_unscanout(void);
+extern "C" void vayu_crumb(const char *format, ...) __printflike(1, 2);  /* vayu_crumb=1: bsd/sys/vayu_mdp.h */
+extern "C" int vayu_crumb_level(void);
+static uint32_t sweet_fb_vayu_zcrumbs;          /* frames of the fb_zero path said step by step (the first 16) */
+static uint32_t sweet_fb_vayu_zero_on;
+static bool sweet_fb_vayu_zero_copy;            /* the test's last frame: copied, so that it stays after the run */
+static SweetSurface *sweet_fb_vayu_zshown;      /* the surface VIG0 fetches now (held), or NULL: the boot framebuffer */
+static bool sweet_fb_vayu_zback;                /* a frame was copied while VIG0 fetched a surface: put it back after */
+static uint32_t sweet_fb_vayu_zflips, sweet_fb_vayu_zfails, sweet_fb_vayu_zcopies, sweet_fb_vayu_zlast_id;
+static uint64_t sweet_fb_vayu_zlast_pa;
+
+static uint64_t
+sweet_fb_vayu_zero(AppleCLCD *fb, const uint8_t *rec, uint32_t sh, uint32_t mask)
+{
+	if (!sweet_fb_vayu_zero_on) {
+		return 0;
+	}
+	uint32_t id = get32(rec, 0x54 + sh);
+	const uint8_t *a = rec + 0x64 + sh, *b = rec + 0xc4 + sh;
+	SweetSurface *s = (mask & 0xf) == 1 && id != 0 && !sweet_fb_vayu_zero_copy ? sweet_surface_copy(id) : NULL;
+	bool whole = get32(a, 0) == 0 && get32(a, 4) == 0 && get32(b, 0) == 0 && get32(b, 4) == 0 &&
+	    (get32(b, 8) == 0 || get32(b, 8) == fb->fLogicalW) && (get32(b, 12) == 0 || get32(b, 12) == fb->fLogicalH);
+	bool crumbs = s != NULL && s->contigPA != 0 && sweet_fb_vayu_zcrumbs < 16;
+	if (crumbs) {
+		sweet_fb_vayu_zcrumbs++;
+		vayu_crumb("fb_zero: swap %u: surface %u %ux%u bpr %u at %#llx (%#llx bytes), fence %u: the GPU done?\n",
+		    get32(rec, 0x50 + sh), s->id, s->width, s->height, s->bytesPerRow, s->contigPA, (uint64_t)s->contigSize,
+		    __atomic_load_n(&s->gpuFence, __ATOMIC_ACQUIRE));
+	}
+	if (s != NULL && s->contigPA != 0 && !sweet_fb_vayu_gpu_ready(s, false)) {
+		OSSafeReleaseNULL(s);
+		if (crumbs) {
+			vayu_crumb("fb_zero: the GPU not done: not shown\n");
+		}
+		return (uint64_t)fb->fWidth * fb->fHeight * 4;  /* (the GPU's frame is not done: nothing shown, nothing copied) */
+	}
+	bool fits = s != NULL && s->contigPA != 0 && whole && !fb->fScaled && s->width == fb->fLogicalW &&
+	    s->height == fb->fLogicalH && s->bytesPerElement == 4 && s->offset == 0 && fb->fOffX >= 0 && fb->fOffY >= 0;
+	if (crumbs) {
+		vayu_crumb("fb_zero: %s; the CPU's lines out to memory\n", fits ? "one whole surface" : "does not fit: copied");
+	}
+	bool synced = fits && sweet_surface_sync_for_device(s);
+	if (crumbs && fits) {
+		vayu_crumb("fb_zero: %s; VIG0 at (%d,%d)\n", synced ? "synced" : "NOT synced", fb->fOffX, fb->fOffY);
+	}
+	bool taken = synced && vayu_mdp_scanout(s->contigPA, s->bytesPerRow, (uint32_t)fb->fOffX, (uint32_t)fb->fOffY);
+	if (crumbs && synced) {
+		vayu_crumb("fb_zero: the flip %s\n", taken ? "taken" : "NOT taken: copied");
+	}
+	if (taken) {
+		SweetSurface *old = sweet_fb_vayu_zshown;
+		sweet_fb_vayu_zshown = s;               /* (the reference from sweet_surface_copy is kept) */
+		OSSafeReleaseNULL(old);                 /* the flip to s is taken: the one before is not fetched any more */
+		sweet_fb_vayu_zflips++;
+		sweet_fb_vayu_zlast_id = s->id;
+		sweet_fb_vayu_zlast_pa = s->contigPA;
+		return (uint64_t)fb->fWidth * fb->fHeight * 4;
+	}
+	if (s != NULL && s->contigPA != 0) {
+		sweet_fb_vayu_zfails++;
+	}
+	OSSafeReleaseNULL(s);
+	sweet_fb_vayu_zcopies++;
+	sweet_fb_vayu_zback = sweet_fb_vayu_zshown != NULL;
+	return 0;
+}
+
+/* after a frame was copied (present()'s end): VIG0 back on the boot framebuffer, which has the frame now */
+static void
+sweet_fb_vayu_zero_after_copy(void)
+{
+	if (sweet_fb_vayu_zback) {
+		sweet_fb_vayu_zback = false;
+		vayu_crumb("fb_zero: a frame copied: VIG0 back on the boot framebuffer\n");
+		if (vayu_mdp_unscanout()) {
+			OSSafeReleaseNULL(sweet_fb_vayu_zshown);
+		}
+	}
+}
+
+/* ---- the backlight and the panel's stream: vayu_wled=2, display_off_intf=1 ------------------------------------ */
+
+/* set by bsd/dev/vayu_wled.c (vayu_wled=2); defined here, once */
+extern "C" {
+bool (*hakios_display_power)(bool on);
+bool (*hakios_display_brightness)(uint32_t permille);
+void vayu_display_power_state(bool on);         /* bsd/dev/vayu_display_power.c */
+}
+
+/* RequestPowerChange (selector 12), after the framebuffer's own state: off -- the light first, then the stream; on --
+ * the stream first (two frames), then the light (B's order) */
+static void
+sweet_fb_vayu_power(bool off)
+{
+	if (!vayu27_enabled()) {
+		return;
+	}
+	bool (*power)(bool) = __atomic_load_n(&hakios_display_power, __ATOMIC_ACQUIRE);
+	bool done = false;
+	if (off) {
+		done = power != NULL && power(false);
+		vayu_display_power_state(false);
+	} else {
+		vayu_display_power_state(true);
+		done = power != NULL && power(true);
+	}
+	IOLog("VAYU FB: display %s: backlight %s\n", off ? "off" : "on", power == NULL ? "not driven (no vayu_wled=2)" :
+	    done ? "switched" : "NOT switched");
+}
+
+/* iOS 27's brightness in a SwapEnd record of 0x6e0 (kern_SwapSetBrightness): to the backlight when it changes */
+static void
+sweet_fb_vayu_brightness(const uint8_t *rec, uint32_t size)
+{
+	static uint64_t last = ~0ULL;
+	static uint32_t said;
+	uint64_t bits;
+
+	if (size < 0x6e0 || rec[SWEET_FB_REC27_BRIGHT_SET] == 0 || !vayu27_enabled()) {
+		return;
+	}
+	memcpy(&bits, rec + SWEET_FB_REC27_BRIGHT, sizeof(bits));
+	if (bits == last) {
+		return;
+	}
+	last = bits;
+	uint32_t nits = 500;
+	PE_parse_boot_argn("vayu_bright_nits", &nits, sizeof(nits));
+	uint32_t permille = vayu_fb_brightness_permille(bits, nits);
+	bool (*level)(uint32_t) = __atomic_load_n(&hakios_display_brightness, __ATOMIC_ACQUIRE);
+	bool done = level != NULL && permille != 0 && level(permille);
+	if (said++ < 40) {
+		IOLog("VAYU FB: swap brightness (double bits %#llx) = %u permille: %s\n", bits, permille,
+		    permille == 0 ? "not a usable number" : level == NULL ? "no backlight driver (vayu_wled=2)" :
+		    done ? "set" : "NOT set");
+	}
+}
+
+/* fb_120 and fb_zero, read once at start() (before registerService: CoreAnimation reads the refresh property) */
+static void
+sweet_fb_vayu_config(AppleCLCD *fb)
+{
+	uint32_t v = 0, hz = 0;
+	if (!vayu27_enabled()) {
+		return;
+	}
+	if (PE_parse_boot_argn("fb_120", &v, sizeof(v)) && v != 0) {
+		sweet_fb_vayu_fb120 = 1;
+		PE_parse_boot_argn("fb_120_timer", &sweet_fb_vayu_fb120_timer, sizeof(sweet_fb_vayu_fb120_timer));
+		if (!PE_parse_boot_argn("sweetfb_hz", &hz, sizeof(hz))) {
+			fb->fFlushTicks = 1;
+		}
+		uint64_t step = 0;
+		nanoseconds_to_absolutetime(8333333ULL, &step);
+		OSDictionary *refresh = OSDictionary::withCapacity(2);
+		OSNumber *interval = OSNumber::withNumber((4294967296ULL + 60) / 120, 32);  /* 1/120 s, 2^-32 s units */
+		OSNumber *ticks = OSNumber::withNumber(step, 32);
+		if (refresh != NULL && interval != NULL && ticks != NULL) {
+			refresh->setObject("displayMinRefreshInterval", interval);
+			refresh->setObject("displayRefreshStepMachTime", ticks);
+			fb->setProperty("IOMFBDisplayRefresh", refresh);
+		}
+		OSSafeReleaseNULL(interval);
+		OSSafeReleaseNULL(ticks);
+		OSSafeReleaseNULL(refresh);
+		IOLog("VAYU FB120: fb_120=1: IOMFBDisplayRefresh 1/120 s published, a present every %u tick(s), ticks on the "
+		    "panel's frames once vayu_vsync=2 arms (until then %s)\n", fb->fFlushTicks,
+		    sweet_fb_vayu_fb120_timer ? "a 120 Hz timer" : "the 60 Hz timer");
+	}
+	v = 0;
+	if (PE_parse_boot_argn("fb_zero", &v, sizeof(v)) && v != 0) {
+		sweet_fb_vayu_zero_on = 1;
+		IOLog("VAYU FB: fb_zero=1: a frame of one contiguous surface is scanned out without a copy (needs vayu_mdp=2)\n");
+	}
+}
+
+/* ---- vayu_fbtest: frames through the user client ------------------------------------------------------------ */
+
+static IOReturn
+sweet_fb_vayu_call(IOMobileFramebufferUserClient *uc, uint32_t selector, const uint64_t *in, uint32_t nin,
+    const void *rec, uint32_t size, IOMemoryDescriptor *md, uint64_t *out, uint32_t nout)
+{
+	IOExternalMethodArguments a;
+	bzero(&a, sizeof(a));
+	a.version = kIOExternalMethodArgumentsCurrentVersion;
+	a.selector = selector;
+	a.scalarInput = in;
+	a.scalarInputCount = nin;
+	a.structureInput = rec;
+	a.structureInputSize = size;
+	a.structureInputDescriptor = md;
+	a.scalarOutput = out;
+	a.scalarOutputCount = nout;
+	return uc->externalMethod(selector, &a, NULL, NULL, NULL);
+}
+
+static inline void
+sweet_fb_vayu_put32(uint8_t *rec, uint32_t off, uint32_t v)
+{
+	memcpy(rec + off, &v, 4);
+}
+
+/* a glyph of the console's font, scale x scale pixels a dot, in colour fg (only the dots are drawn) */
+static void
+sweet_fb_vayu_glyph(uint8_t *px, uint32_t bpr, uint32_t w, uint32_t h, uint32_t x0, uint32_t y0, unsigned char c,
+    uint32_t scale, uint32_t fg)
+{
+	const unsigned char *g = iso_font + c * 16;
+	for (uint32_t gy = 0; gy < 16; gy++) {
+		for (uint32_t gx = 0; gx < 8; gx++) {
+			if (!(g[gy] & (1u << gx))) {
+				continue;
+			}
+			for (uint32_t sy = 0; sy < scale; sy++) {
+				uint32_t y = y0 + gy * scale + sy;
+				if (y >= h) {
+					break;
+				}
+				uint32_t *row = (uint32_t *)(px + (uint64_t)y * bpr);
+				for (uint32_t sx = 0; sx < scale && x0 + gx * scale + sx < w; sx++) {
+					row[x0 + gx * scale + sx] = fg;
+				}
+			}
+		}
+	}
+}
+
+static void
+sweet_fb_vayu_text(uint8_t *px, uint32_t bpr, uint32_t w, uint32_t h, uint32_t x0, uint32_t y0, const char *s,
+    uint32_t scale, uint32_t fg)
+{
+	for (uint32_t i = 0; s[i] != 0; i++) {
+		sweet_fb_vayu_glyph(px, bpr, w, h, x0 + i * 8 * scale, y0, (unsigned char)s[i], scale, fg);
+	}
+}
+
+static void
+sweet_fb_vayu_fill(uint8_t *px, uint32_t bpr, uint32_t w, uint32_t h, uint32_t x0, uint32_t y0, uint32_t rw, uint32_t rh,
+    uint32_t c)
+{
+	for (uint32_t y = y0; y < y0 + rh && y < h; y++) {
+		uint32_t *row = (uint32_t *)(px + (uint64_t)y * bpr);
+		for (uint32_t x = x0; x < x0 + rw && x < w; x++) {
+			row[x] = c;
+		}
+	}
+}
+
+/* frame k of the test: eight colour bars turned by k, the title, k in digits as tall as a fifth of the screen, a square */
+static void
+sweet_fb_vayu_draw(uint8_t *px, uint32_t bpr, uint32_t w, uint32_t h, uint32_t k, uint32_t total)
+{
+	static const uint32_t bars[8] = { 0xffffffff, 0xffffff00, 0xff00ffff, 0xff00ff00, 0xffff00ff, 0xffff0000, 0xff0000ff,
+		                          0xff202020 };
+	char line[48];
+	for (uint32_t i = 0; i < 8; i++) {
+		sweet_fb_vayu_fill(px, bpr, w, h, i * w / 8, 0, (i + 1) * w / 8 - i * w / 8, h, bars[(i + k) % 8]);
+	}
+	uint32_t title = w / (8 * 20) ? w / (8 * 20) : 1;          /* 20 characters across */
+	sweet_fb_vayu_fill(px, bpr, w, h, 0, h / 16, w, 16 * title * 2 + 2 * title, 0xff000000);
+	sweet_fb_vayu_text(px, bpr, w, h, title, h / 16 + title, "VAYU XNU 12377", title, 0xffffffff);
+	snprintf(line, sizeof(line), "SweetFB test %u/%u", k, total);
+	sweet_fb_vayu_text(px, bpr, w, h, title, h / 16 + title + 16 * title, line, title, 0xff00ff00);
+	uint32_t big = h / 5 / 16 ? h / 5 / 16 : 1;
+	snprintf(line, sizeof(line), "%u", k);
+	uint32_t len = (uint32_t)strlen(line), bw = len * 8 * big;
+	uint32_t bx = bw < w ? (w - bw) / 2 : 0, by = (h - 16 * big) / 2;
+	sweet_fb_vayu_fill(px, bpr, w, h, bx > big ? bx - big : 0, by - big, bw + 2 * big, 16 * big + 2 * big, 0xff000000);
+	sweet_fb_vayu_text(px, bpr, w, h, bx, by, line, big, 0xffffffff);
+	uint32_t sq = w / 6;
+	sweet_fb_vayu_fill(px, bpr, w, h, (k * 97) % (w - sq), h * 3 / 4, sq, sq, 0xffffffff);
+}
+
+/* the CRC of what the panel shows of the surface: its part at (offx, offy) of the panel's size (0: it does not cover it) */
+static bool
+sweet_fb_vayu_expect(AppleCLCD *fb, SweetSurface *s, uintptr_t px, uint32_t *crc)
+{
+	if (fb->fScaled || fb->fOffX < 0 || fb->fOffY < 0 || (uint32_t)fb->fOffX + fb->fWidth > s->width ||
+	    (uint32_t)fb->fOffY + fb->fHeight > s->height) {
+		return false;
+	}
+	uint32_t c = VAYU_FB_CRC_INIT, lit = 0, white = 0;
+	for (uint32_t y = 0; y < fb->fHeight; y++) {
+		c = vayu_fb_crc_rgb_row(sweet_fb_vayu_crc_tab, c, (const volatile uint32_t *)(px +
+		    (uint64_t)(y + fb->fOffY) * s->bytesPerRow + (uint64_t)fb->fOffX * 4), fb->fWidth, &lit, &white);
+	}
+	*crc = VAYU_FB_CRC_END(c);
+	return true;
+}
+
+static uint32_t sweet_fb_vayu_abi_pass, sweet_fb_vayu_abi_count;
+
+static void
+sweet_fb_vayu_abi(const char *what, bool pass, IOReturn ret, uint64_t a, uint64_t b)
+{
+	sweet_fb_vayu_abi_count++;
+	sweet_fb_vayu_abi_pass += pass;
+	IOLog("VAYU FBTEST: abi %s: %s (ret 0x%x, out %llu %llu)\n", what, pass ? "PASS" : "FAIL", ret, a, b);
+}
+
+/*
+ * HakiosGPU's 0x7f: a test program's pixels (32 bits, blue first) copied onto the panel at the presented origin, for
+ * eyes and fb stats; the MDP put back on the boot framebuffer first if it was scanning a surface out (fb_zero).
+ */
+extern "C" void
+sweet_fb_vayu_show(const uint8_t *pixels, uint32_t width, uint32_t height, uint32_t rowBytes)
+{
+	AppleCLCD *fb = __atomic_load_n(&sweet_fb_vayu_fb, __ATOMIC_ACQUIRE);
+
+	if (fb == NULL || fb->fPixels == 0 || pixels == NULL || rowBytes < 4 * width) {
+		return;
+	}
+	if (sweet_fb_vayu_zshown != NULL && vayu_mdp_unscanout()) {
+		OSSafeReleaseNULL(sweet_fb_vayu_zshown);
+	}
+	uint32_t w = width < fb->fWidth ? width : fb->fWidth, h = height < fb->fHeight ? height : fb->fHeight;
+	for (uint32_t y = 0; y < h; y++) {
+		memcpy((void *)(fb->fPixels + (uint64_t)y * fb->fRowBytes), pixels + (uint64_t)y * rowBytes, (size_t)w * 4);
+	}
+	__builtin_arm_dsb(0xf);
+	IOLog("VAYU FB: HakiosGPU show: %ux%u of the caller's pixels on the panel\n", w, h);
+}
+
+/* the GPU test's gradient (BGRA): red down, green across, blue 0x80 -- HakiosGPUFillSurface() writes the same */
+static inline uint32_t
+sweet_fb_vayu_gpu_pixel(uint32_t x, uint32_t y, uint32_t w, uint32_t h)
+{
+	uint32_t r = h > 1 ? y * 255 / (h - 1) : 0, g = w > 1 ? x * 255 / (w - 1) : 0;
+
+	return 0xff000000u | r << 16 | g << 8 | 0x80u;
+}
+
+/*
+ * vayu_gpufb_test=1 (from bsd/dev/vayu_adreno.c once the GPU is kept): the GPU fills a surface of the presented size
+ * (contiguous with fb_zero=1, else a kernel buffer) with the gradient, and it goes to the panel through the same
+ * SwapEnd as a window server's frame (IOMobileFramebuffer's user client), which waits for the surface's fence. Then:
+ * the surface compared with the gradient pixel by pixel (after the fence, read through dc ivac), and the panel's CRC
+ * with the surface's (a copy) or VIG0 taking the surface (a flip). "VAYU GPUFB: ... PASS". The frame stays on.
+ */
+extern "C" void
+sweet_fb_vayu_gpu_test(void)
+{
+	AppleCLCD *fb = __atomic_load_n(&sweet_fb_vayu_fb, __ATOMIC_ACQUIRE);
+	IOMobileFramebufferUserClient *uc = NULL;
+	SweetSurface *s = NULL;
+	uint8_t *rec = NULL;
+	uint32_t fence = 0, wrong = 0, crc_want = 0, zflips0 = sweet_fb_vayu_zflips;
+	uint64_t o[1] = { 0 }, t0, waited_ms = 0, ns = 0;
+	bool zero = sweet_fb_vayu_zero_on != 0, presented = false, match = false, filled;
+	struct sweet_fb_vayu_stat st;
+
+	if (fb == NULL) {
+		IOLog("VAYU GPUFB: no framebuffer: FAIL\n");
+		return;
+	}
+	vayu_fb_crc_table(sweet_fb_vayu_crc_tab);
+	vayu_crumb("gpufb: start (fb_zero %d): a %ux%u surface\n", zero, fb->fLogicalW, fb->fLogicalH);
+	s = zero ? sweet_surface_create_contig(fb->fLogicalW, fb->fLogicalH, SWEET_FB_FORMAT_BGRA) :
+	    sweet_surface_create_buffer(fb->fLogicalW, fb->fLogicalH, SWEET_FB_FORMAT_BGRA);
+	uintptr_t px = s != NULL ? s->kernelAddress() : 0;
+	vayu_crumb("gpufb: surface %u bpr %u, %#llx bytes, at %#llx (contiguous VA %#llx), kernel at %#lx\n", s ? s->id : 0,
+	    s ? s->bytesPerRow : 0, s ? (uint64_t)s->allocSize : 0, s ? s->contigPA : 0, s ? (uint64_t)s->contigVA : 0, px);
+	if (zero && s != NULL) {
+		IOLog("VAYU GPUFB: fb_zero: surface %u is %#llx bytes at %#llx (contiguous)\n", s->id, (uint64_t)s->allocSize,
+		    s->contigPA);
+	}
+	rec = (uint8_t *)IOMallocZeroData(SWEET_FB_SWAP_REC_MAX);
+	uc = OSTypeAlloc(IOMobileFramebufferUserClient);
+	if (px == 0 || rec == NULL || uc == NULL || !uc->initWithTask(kernel_task, NULL, 0) || !uc->attach(fb)) {
+		IOLog("VAYU GPUFB: no surface, record or user client: FAIL\n");
+		OSSafeReleaseNULL(uc);
+		goto out;
+	}
+	if (!uc->start(fb)) {
+		IOLog("VAYU GPUFB: the user client does not start: FAIL\n");
+		uc->detach(fb);
+		OSSafeReleaseNULL(uc);
+		goto out;
+	}
+	t0 = mach_absolute_time();
+	vayu_crumb("gpufb: the GPU fills surface %u\n", s->id);
+	filled = HakiosGPUFillSurface(s->id, &fence);
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	vayu_crumb("gpufb: filled %d, fence %u, %llu us\n", filled, fence, ns / 1000);
+	if (!filled) {
+		IOLog("VAYU GPUFB: the GPU did not fill surface %u: FAIL\n", s->id);
+		goto close;
+	}
+	/* the frame, as the window server sends one: layer 0 = the surface, whole */
+	if (sweet_fb_vayu_call(uc, 4, NULL, 0, NULL, 0, NULL, o, 1) == kIOReturnSuccess) {
+		unsigned long long shown0 = __atomic_load_n(&sweet_fb_frames_shown, __ATOMIC_ACQUIRE);
+		sweet_fb_vayu_zero_copy = !zero;
+		sweet_fb_vayu_put32(rec, 0x50, (uint32_t)o[0]);
+		sweet_fb_vayu_put32(rec, 0x54, s->id);
+		sweet_fb_vayu_put32(rec, 0x64 + 8, s->width);
+		sweet_fb_vayu_put32(rec, 0x64 + 12, s->height);
+		sweet_fb_vayu_put32(rec, 0xc4 + 8, s->width);
+		sweet_fb_vayu_put32(rec, 0xc4 + 12, s->height);
+		sweet_fb_vayu_put32(rec, 0x104, 1);
+		vayu_crumb("gpufb: SwapEnd of swap %u\n", (uint32_t)o[0]);
+		if (sweet_fb_vayu_call(uc, 5, NULL, 0, rec, 0x6e0, NULL, NULL, 0) == kIOReturnSuccess) {
+			uint64_t t1 = mach_absolute_time();
+			/* (vayu_crumb=2 sleeps 250 ms at each of the present path's steps: ak8-g3's "presented NO" was that) */
+			uint64_t patience_ms = vayu_crumb_level() == 2 ? 15000 : 2000;
+			while (__atomic_load_n(&sweet_fb_frames_shown, __ATOMIC_ACQUIRE) == shown0 && waited_ms < patience_ms) {
+				IOSleep(5);
+				absolutetime_to_nanoseconds(mach_absolute_time() - t1, &waited_ms);
+				waited_ms /= 1000000;
+			}
+			presented = __atomic_load_n(&sweet_fb_frames_shown, __ATOMIC_ACQUIRE) != shown0;
+		}
+		sweet_fb_vayu_zero_copy = false;
+		vayu_crumb("gpufb: presented %d after %llu ms\n", presented, waited_ms);
+	}
+	/* the surface as the GPU left it, against the gradient (the fence is done: SwapEnd waited) */
+	(void)sweet_fb_vayu_gpu_ready(s, true);
+	for (uint32_t y = 0; y < s->height; y++) {
+		const volatile uint32_t *row = (const volatile uint32_t *)(px + (uint64_t)y * s->bytesPerRow);
+		for (uint32_t x = 0; x < s->width; x++) {
+			wrong += row[x] != sweet_fb_vayu_gpu_pixel(x, y, s->width, s->height);
+		}
+	}
+	if (zero) {
+		match = presented && sweet_fb_vayu_zflips == zflips0 + 1 && sweet_fb_vayu_zlast_id == s->id;
+		IOLog("VAYU GPUFB: surface %u %ux%u at %#llx filled by the GPU (fence %u, %llu us): %u of %u pixels wrong; "
+		    "presented %s after %llu ms; fb_zero: VIG0 fetches surface %u: %s\n", s->id, s->width, s->height,
+		    s->contigPA, fence, ns / 1000, wrong, s->width * s->height, presented ? "yes" : "NO", waited_ms,
+		    sweet_fb_vayu_zlast_id, match && wrong == 0 ? "PASS" : "FAIL");
+	} else {
+		bool want = sweet_fb_vayu_expect(fb, s, px, &crc_want);
+		sweet_fb_vayu_measure(fb, &st);
+		match = presented && want && st.crc == crc_want;
+		IOLog("VAYU GPUFB: surface %u %ux%u filled by the GPU (fence %u, %llu us): %u of %u pixels wrong; presented %s "
+		    "after %llu ms; panel crc32 %08x, the surface's %08x (lit %u): %s\n", s->id, s->width, s->height, fence,
+		    ns / 1000, wrong, s->width * s->height, presented ? "yes" : "NO", waited_ms, st.crc, crc_want, st.lit,
+		    match && wrong == 0 ? "PASS" : "FAIL");
+	}
+	IOLog("VAYU GPUFB: fence waits %u, frames not shown for a late GPU %u\n", sweet_fb_vayu_gpu_waits,
+	    sweet_fb_vayu_gpu_late);
+	vayu_crumb("gpufb: compared: %u wrong, %s\n", wrong, match && wrong == 0 ? "PASS" : "FAIL");
+close:
+	uc->clientClose();
+	OSSafeReleaseNULL(uc);
+out:
+	if (rec != NULL) {
+		IOFreeData(rec, SWEET_FB_SWAP_REC_MAX);
+	}
+	OSSafeReleaseNULL(s);                   /* (a flipped one is held by the scanout until VIG0 moves) */
+}
+
+static void
+sweet_fb_vayu_selftest(AppleCLCD *fb, uint32_t frames)
+{
+	uint32_t hold = 1000, matched = 0, shown = 0;
+	PE_parse_boot_argn("vayu_fbtest_ms", &hold, sizeof(hold));
+	IOLog("VAYU FBTEST: %u frame(s) through IOMobileFramebuffer's user client, %u ms each, presented as %ux%u on the "
+	    "panel's %ux%u (offset %d,%d)\n", frames, hold, fb->fLogicalW, fb->fLogicalH, fb->fWidth, fb->fHeight, fb->fOffX,
+	    fb->fOffY);
+
+	IOMobileFramebufferUserClient *uc = OSTypeAlloc(IOMobileFramebufferUserClient);
+	if (uc == NULL || !uc->initWithTask(kernel_task, NULL, 0) || !uc->attach(fb)) {
+		IOLog("VAYU FBTEST: no user client: FAILED\n");
+		OSSafeReleaseNULL(uc);
+		return;
+	}
+	if (!uc->start(fb)) {
+		IOLog("VAYU FBTEST: the user client does not start: FAILED\n");
+		uc->detach(fb);
+		uc->release();
+		return;
+	}
+	/*
+	 * fb_zero: two contiguous surfaces, drawn in turn (the one not shown), each frame flipped onto the panel without a
+	 * copy; the last frame is copied (VIG0 back on the boot framebuffer, which keeps it after the run).
+	 */
+	bool zero = sweet_fb_vayu_zero_on != 0;
+	SweetSurface *pair[2] = { NULL, NULL };
+	if (zero) {
+		pair[0] = sweet_surface_create_contig(fb->fLogicalW, fb->fLogicalH, SWEET_FB_FORMAT_BGRA);
+		pair[1] = sweet_surface_create_contig(fb->fLogicalW, fb->fLogicalH, SWEET_FB_FORMAT_BGRA);
+		IOLog("VAYU FBTEST: fb_zero: two contiguous surfaces below 4 GB: %#llx, %#llx%s\n",
+		    pair[0] != NULL ? pair[0]->contigPA : 0ULL, pair[1] != NULL ? pair[1]->contigPA : 0ULL,
+		    pair[0] != NULL && pair[1] != NULL ? "" : ": NOT THERE, frames are copied");
+		if (pair[0] == NULL || pair[1] == NULL) {
+			OSSafeReleaseNULL(pair[0]);
+			OSSafeReleaseNULL(pair[1]);
+			zero = false;
+		}
+	}
+	SweetSurface *s = zero ? pair[0] : sweet_surface_create_buffer(fb->fLogicalW, fb->fLogicalH, SWEET_FB_FORMAT_BGRA);
+	uintptr_t px = s != NULL ? s->kernelAddress() : 0;
+	uint8_t *rec = (uint8_t *)IOMallocZeroData(SWEET_FB_SWAP_REC_MAX);
+	uint8_t *big = (uint8_t *)IOMallocZeroData(VAYU_FB_REC_LIMIT + 4);
+	if (px == 0 || rec == NULL || big == NULL) {
+		IOLog("VAYU FBTEST: no test surface (%ux%u) or record: FAILED\n", fb->fLogicalW, fb->fLogicalH);
+		goto out;
+	}
+
+	/* the selectors, as IOMobileFramebuffer.framework calls them; the refusals of records no IOMFB sends */
+	{
+		uint64_t o[2] = { 0, 0 }, in1[1] = { 0 };
+		IOReturn r = sweet_fb_vayu_call(uc, 8, NULL, 0, NULL, 0, NULL, o, 2);
+		sweet_fb_vayu_abi("sel 8 GetDisplaySize = the presented size", r == kIOReturnSuccess && o[0] == fb->fLogicalW &&
+		    o[1] == fb->fLogicalH, r, o[0], o[1]);
+		o[0] = o[1] = 7;
+		r = sweet_fb_vayu_call(uc, 7, NULL, 0, NULL, 0, NULL, o, 1);
+		sweet_fb_vayu_abi("sel 7 GetID = 0", r == kIOReturnSuccess && o[0] == 0, r, o[0], 0);
+		r = sweet_fb_vayu_call(uc, 18, NULL, 0, NULL, 0, NULL, o, 1);
+		sweet_fb_vayu_abi("sel 18 IsMainDisplay = 1", r == kIOReturnSuccess && o[0] == 1, r, o[0], 0);
+		r = sweet_fb_vayu_call(uc, 28, NULL, 0, NULL, 0, NULL, o, 1);
+		sweet_fb_vayu_abi("sel 28 GetDotPitch = 458", r == kIOReturnSuccess && o[0] == SWEET_FB_DOT_PITCH, r, o[0], 0);
+		o[0] = o[1] = 7;
+		r = sweet_fb_vayu_call(uc, 74, in1, 1, NULL, 0, NULL, o, 2);
+		sweet_fb_vayu_abi("sel 74 SupportedFrameInfo without sweetfb_frameinfo = 0 keys", r == kIOReturnSuccess &&
+		    (sweet_fb_fi != 0 || o[0] == 0), r, o[0], o[1]);
+		uint64_t before = sweet_fb_swap_count;
+		r = sweet_fb_vayu_call(uc, 5, NULL, 0, rec, VAYU_FB_REC_MIN - 1, NULL, NULL, 0);
+		sweet_fb_vayu_abi("sel 5 SwapEnd of 0x3ff bytes refused", r == kIOReturnBadArgument && sweet_fb_swap_count == before,
+		    r, 0, 0);
+		r = sweet_fb_vayu_call(uc, 5, NULL, 0, big, VAYU_FB_REC_LIMIT + 4, NULL, NULL, 0);
+		sweet_fb_vayu_abi("sel 5 SwapEnd of 0x4004 bytes refused", r == kIOReturnBadArgument && sweet_fb_swap_count == before,
+		    r, 0, 0);
+		IOMemoryDescriptor *md = IOMemoryDescriptor::withAddress(rec, 0x6e0, kIODirectionOut);
+		r = md != NULL ? sweet_fb_vayu_call(uc, 5, NULL, 0, rec, 0x6e0, md, NULL, 0) : kIOReturnNoMemory;
+		sweet_fb_vayu_abi("sel 5 SwapEnd inband and a descriptor refused", r == kIOReturnBadArgument &&
+		    sweet_fb_swap_count == before, r, 0, 0);
+		OSSafeReleaseNULL(md);
+	}
+
+	for (uint32_t k = 1; k <= frames; k++) {
+		static const uint32_t sizes[4] = { 0x46c, 0x514, 0x6e0, 0x6e0 };
+		uint32_t size = sizes[(k - 1) % 4], sh = size == 0x514 ? 0x48 : 0, crc_want = 0;
+		bool via_md = (k - 1) % 4 == 3;
+		uint64_t o[1] = { 0 }, t0 = mach_absolute_time(), waited_ms = 0;
+		bool flip = zero && k < frames;        /* (zero: the last frame is copied) */
+		uint32_t zflips0 = sweet_fb_vayu_zflips;
+
+		if (zero) {
+			s = pair[k & 1];
+			px = s->kernelAddress();
+			sweet_fb_vayu_zero_copy = !flip;
+		}
+		sweet_fb_vayu_draw((uint8_t *)px, s->bytesPerRow, s->width, s->height, k, frames);
+		bool want = sweet_fb_vayu_expect(fb, s, px, &crc_want);
+		IOReturn r = sweet_fb_vayu_call(uc, 4, NULL, 0, NULL, 0, NULL, o, 1);    /* SwapBegin: the swap's id */
+		uint32_t swap = (uint32_t)o[0];
+		bzero(rec, SWEET_FB_SWAP_REC_MAX);
+		sweet_fb_vayu_put32(rec, 0x50 + sh, swap);                              /* (iPadOS 18's layout: 0x50 stays 0) */
+		sweet_fb_vayu_put32(rec, 0x54 + sh, s->id);                             /* layer 0's surface */
+		sweet_fb_vayu_put32(rec, 0x64 + sh + 8, s->width);                      /* source rect 0,0,w,h */
+		sweet_fb_vayu_put32(rec, 0x64 + sh + 12, s->height);
+		sweet_fb_vayu_put32(rec, 0xc4 + sh + 8, s->width);                      /* destination rect 0,0,w,h */
+		sweet_fb_vayu_put32(rec, 0xc4 + sh + 12, s->height);
+		sweet_fb_vayu_put32(rec, 0x104 + sh, 1);                                /* layer 0 on */
+		unsigned long long shown0 = __atomic_load_n(&sweet_fb_frames_shown, __ATOMIC_ACQUIRE);
+		IOMemoryDescriptor *md = via_md ? IOMemoryDescriptor::withAddress(rec, size, kIODirectionOut) : NULL;
+		if (r == kIOReturnSuccess) {
+			r = sweet_fb_vayu_call(uc, 5, NULL, 0, via_md ? NULL : rec, via_md ? 0 : size, md, NULL, 0);
+		}
+		OSSafeReleaseNULL(md);
+		/* the vsync timer presents it (every fFlushTicks ticks of 16.7 ms): wait for the count of presented frames */
+		while (r == kIOReturnSuccess && __atomic_load_n(&sweet_fb_frames_shown, __ATOMIC_ACQUIRE) == shown0 &&
+		    waited_ms < 2000) {
+			IOSleep(5);
+			absolutetime_to_nanoseconds(mach_absolute_time() - t0, &waited_ms);
+			waited_ms /= 1000000;
+		}
+		bool presented = r == kIOReturnSuccess && __atomic_load_n(&sweet_fb_frames_shown, __ATOMIC_ACQUIRE) != shown0;
+		struct sweet_fb_vayu_stat st;
+		bool match;
+		if (flip) {
+			/* scanned out, not copied: the proof is VIG0 taking this surface's address (vayu_mdp_scanout's flush) */
+			match = presented && sweet_fb_vayu_zflips == zflips0 + 1 && sweet_fb_vayu_zlast_id == s->id;
+			shown += presented;
+			matched += match;
+			IOLog("VAYU FBTEST: frame %u/%u swap %u record 0x%x %s%s: %s after %llu ms; fb_zero: VIG0 fetches surface %u at "
+			    "%#llx (flips %u, not taken %u, copied %u): %s\n", k, frames, swap, size, via_md ? "as a descriptor" : "inband",
+			    sh ? " (iPadOS 18 layout)" : "", presented ? "presented" : r != kIOReturnSuccess ? "REFUSED" : "NOT PRESENTED",
+			    waited_ms, sweet_fb_vayu_zlast_id, sweet_fb_vayu_zlast_pa, sweet_fb_vayu_zflips, sweet_fb_vayu_zfails,
+			    sweet_fb_vayu_zcopies, match ? "FLIPPED" : "NOT FLIPPED");
+		} else {
+			sweet_fb_vayu_measure(fb, &st);
+			match = presented && want && st.crc == crc_want;
+			shown += presented;
+			matched += match;
+			IOLog("VAYU FBTEST: frame %u/%u swap %u record 0x%x %s%s: %s after %llu ms; panel crc32 %08x, surface's %s%08x: "
+			    "%s (lit %u, %llu us)\n", k, frames, swap, size, via_md ? "as a descriptor" : "inband",
+			    sh ? " (iPadOS 18 layout)" : "", presented ? "presented" : r != kIOReturnSuccess ? "REFUSED" : "NOT PRESENTED",
+			    waited_ms, st.crc, want ? "" : "(not comparable) ", crc_want, match ? "MATCH" : "MISMATCH", st.lit, st.us);
+			if (presented && want && !match) {
+				sweet_fb_vayu_diff(fb, s, px, k, st.crc);
+			}
+		}
+		uint64_t spent_ms = 0;
+		absolutetime_to_nanoseconds(mach_absolute_time() - t0, &spent_ms);
+		spent_ms /= 1000000;
+		if (spent_ms < hold) {
+			IOSleep((uint32_t)(hold - spent_ms));
+		}
+	}
+	sweet_fb_vayu_zero_copy = false;
+	IOLog("VAYU FBTEST: SUMMARY: abi %u/%u PASS, frames %u/%u presented, %u/%u %s: %s\n", sweet_fb_vayu_abi_pass,
+	    sweet_fb_vayu_abi_count, shown, frames, matched, frames, zero ? "FLIPPED or MATCH (fb_zero)" : "MATCH",
+	    sweet_fb_vayu_abi_pass == sweet_fb_vayu_abi_count && matched == frames ? "ALL PASS" : "FAILED");
+out:
+	if (rec != NULL) {
+		IOFreeData(rec, SWEET_FB_SWAP_REC_MAX);
+	}
+	if (big != NULL) {
+		IOFreeData(big, VAYU_FB_REC_LIMIT + 4);
+	}
+	if (zero) {
+		OSSafeReleaseNULL(pair[0]);     /* (one may stay held by the scanout until VIG0 is back: its own reference) */
+		OSSafeReleaseNULL(pair[1]);
+	} else {
+		OSSafeReleaseNULL(s);           /* (the panel keeps the last frame: it was copied there) */
+	}
+	uc->clientClose();
+	uc->release();
+}
+
+static void
+sweet_fb_vayu_thread(void *arg, __unused wait_result_t wr)
+{
+	AppleCLCD *fb = (AppleCLCD *)arg;
+	uint32_t test = 0, period = 0, lines = 60;
+
+	PE_parse_boot_argn("vayu_fbtest", &test, sizeof(test));
+	PE_parse_boot_argn("vayu_fbstat", &period, sizeof(period));
+	PE_parse_boot_argn("vayu_fbstat_lines", &lines, sizeof(lines));
+	vayu_fb_crc_table(sweet_fb_vayu_crc_tab);
+	sweet_fb_vayu_stat_line(fb, "start");
+	if (test != 0) {
+		/*
+		 * vayu_fbtest_delay=N: the frames N s later. The loader watching from core 0 prints its notes of the kernel's
+		 * progress through UEFI's text console -- onto this same framebuffer -- every 2 s for its first 24 s
+		 * (xnuloader loader.c note_kernel_progress, NOTE_SECONDS): frames measured then can be drawn over (ak5-p2..p4:
+		 * 6 of 30 MISMATCH, all before 47.5 s of uptime, none after).
+		 */
+		uint32_t delay_s = 0;
+		PE_parse_boot_argn("vayu_fbtest_delay", &delay_s, sizeof(delay_s));
+		if (delay_s != 0) {
+			IOSleep((delay_s > 600 ? 600 : delay_s) * 1000);
+		}
+		sweet_fb_vayu_selftest(fb, test > 1000 ? 1000 : test);
+		sweet_fb_vayu_stat_line(fb, "after the test");
+	}
+	for (uint32_t i = 0; period != 0 && i < lines; i++) {
+		IOSleep(period * 1000);
+		sweet_fb_vayu_stat_line(fb, "tick");
+	}
+	fb->release();
+	/* (returning ends the thread: thread_continue() terminates it) */
+}
+
+static void
+sweet_fb_vayu_start(AppleCLCD *fb)
+{
+	uint32_t test = 0, period = 0;
+	thread_t thread;
+
+	PE_parse_boot_argn("vayu_fbtest", &test, sizeof(test));
+	PE_parse_boot_argn("vayu_fbstat", &period, sizeof(period));
+	if (test == 0 && period == 0) {
+		return;
+	}
+	if (!vayu27_enabled()) {
+		IOLog("SWEET FB: VAYU: vayu_fbtest/vayu_fbstat need vayu27=1: not run\n");
+		return;
+	}
+	fb->retain();
+	if (kernel_thread_start(sweet_fb_vayu_thread, fb, &thread) != KERN_SUCCESS) {
+		IOLog("SWEET FB: VAYU: no thread for the tests\n");
+		fb->release();
+		return;
+	}
+	thread_deallocate(thread);
+}
