+	set_saved_state_esr(state, ((uint64_t)ESR_EC_DABORT_EL0 << ESR_EC_SHIFT) | ESR_IL |
+	    (f->write ? ISS_DA_WNR : 0) | dfsc);
+	set_saved_state_far(state, f->addr);
+	codes[0] = kr;
+	codes[1] = f->addr;
+	exception_triage(EXC_BAD_ACCESS, codes, 2);
+	__builtin_unreachable();
