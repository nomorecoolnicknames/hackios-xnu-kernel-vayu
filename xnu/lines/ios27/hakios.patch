+/*
+ * vayu (Kryo 485, ARMv8.2: no PAC, FCMA, LRCPC2, I8MM, BF16, DIT): the arm64e emulation of the undefined-instruction
+ * trap (sweet_a64e.c, then a64e_isa_emu.c) runs only with vayu27=1 vayu_pacemu=1 (iOS 27's userland is arm64e). Without
+ * them such an instruction is a SIGILL, as on any ARMv8.2 kernel. The Exynos M3 paths that follow on the other SWEET
+ * boards (the pin to an A55, the retry there) are not this SoC's: every core here runs the same ISA.
+ */
+extern bool vayu27_enabled(void);
+extern bool vayu_arg(const char *name);
+
+static bool
+vayu_pacemu_enabled(void)
+{
+	static _Atomic int known;               /* 0: not read yet; 1: on; -1: off */
+	int v = os_atomic_load(&known, relaxed);
+
+	if (v == 0) {
+		v = vayu27_enabled() && vayu_arg("vayu_pacemu") ? 1 : -1;
+		os_atomic_store(&known, v, relaxed);
+		printf("VAYU PACEMU: the arm64e emulation is %s (vayu27=1 vayu_pacemu=1)\n", v > 0 ? "on" : "off");
+	}
+	return v > 0;
+}
+
+/*
+ * K2b: where the emulation runs, for a run that hangs (psmpA: vayu_pacemu=1 with 7 CPUs). Per CPU: the traps taken,
+ * the first one said (MIDR: an A55 or an A76), the one being emulated now ("in"); a thread that leaves the emulation
+ * on another CPU than it entered (preempted and migrated in the middle) is said once. The heartbeat (loader_return.c,
+ * every 10 s) says the counts when they moved and any CPU still in the same emulation as a beat ago; the log goes
+ * back to RAM after each of these lines.
+ */
+uint64_t vayu_pacemu_traps[MAX_CPUS];
+static uint64_t vayu_pacemu_said[MAX_CPUS];
+static uint32_t vayu_pacemu_first[MAX_CPUS];
+static uint64_t vayu_pacemu_in[MAX_CPUS], vayu_pacemu_in_seen[MAX_CPUS];
+static uint32_t vayu_pacemu_migrated_said;
+extern void loader_log_sync(void);
+extern int proc_selfpid(void);
+
+static int
+vayu_pacemu_enter(uint32_t instr, uint64_t pc)
+{
+	int cpu = cpu_number();         /* a hint while preemptible: where it was when it trapped */
+
+	if (cpu < 0 || cpu >= MAX_CPUS) {
+		return -1;
+	}
+	os_atomic_inc(&vayu_pacemu_traps[cpu], relaxed);
+	os_atomic_store(&vayu_pacemu_in[cpu], (1ULL << 63) | ((pc & 0x7fffffffULL) << 32) | instr, relaxed);
+	if (os_atomic_cmpxchg(&vayu_pacemu_first[cpu], 0, 1, relaxed)) {
+		printf("VAYU PACEMU: cpu=%d (MPIDR 0x%llx, MIDR 0x%llx) first arm64e trap: insn 0x%08x at pc 0x%llx, pid %d\n",
+		    cpu, __builtin_arm_rsr64("MPIDR_EL1") & 0xffffULL, __builtin_arm_rsr64("MIDR_EL1"), instr, pc,
+		    proc_selfpid());
+		loader_log_sync();
+	}
+	return cpu;
+}
+
+static void
+vayu_pacemu_leave(int cpu, uint32_t instr)
+{
+	if (cpu < 0) {
+		return;
+	}
+	os_atomic_store(&vayu_pacemu_in[cpu], 0, relaxed);
+	int now = cpu_number();
+	if (now != cpu && os_atomic_cmpxchg(&vayu_pacemu_migrated_said, 0, 1, relaxed)) {
+		printf("VAYU PACEMU: pid %d left the emulation of 0x%08x on cpu=%d, entered on cpu=%d (preempted and moved)\n",
+		    proc_selfpid(), instr, now, cpu);
+	}
+}
+
+void vayu_pacemu_beat(uint64_t beat);
+void
+vayu_pacemu_beat(uint64_t beat)
+{
+	char line[200];
+	size_t n = 0;
+	bool moved = false;
+
+	for (int i = 0; i < MAX_CPUS; i++) {
+		uint64_t t = os_atomic_load(&vayu_pacemu_traps[i], relaxed);
+		moved = moved || t != vayu_pacemu_said[i];
+		vayu_pacemu_said[i] = t;
+		if (n < sizeof(line)) {
+			n += (size_t)snprintf(line + n, sizeof(line) - n, " %llu", t);
+		}
+		uint64_t in = os_atomic_load(&vayu_pacemu_in[i], relaxed);
+		if (in != 0 && in == vayu_pacemu_in_seen[i]) {
+			printf("VAYU PACEMU: cpu=%d is still in the emulation of 0x%08x (pc 0x%llx) a beat later (beat %llu)\n", i,
+			    (uint32_t)in, (in >> 32) & 0x7fffffffULL, beat);
+		}
+		vayu_pacemu_in_seen[i] = in;
+	}
+	if (moved) {
+		printf("VAYU PACEMU: traps by cpu at beat %llu:%s\n", beat, line);
+	}
+}
