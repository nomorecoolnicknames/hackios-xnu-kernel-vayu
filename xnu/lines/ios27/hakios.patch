+	 * VAYU (K3): the same two paths, with the sizes checked first (vayu_mem_rules.h) and the early cursor moved by
+	 * what is mapped. Nothing is mapped or moved before every check has passed. A mapping of 0 bytes gets 0 back, not
+	 * the cursor's address, which the next early mapping would have been given as well.
+	 */
+	struct vayu_io_span span;
