diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
index 2bf4b8968dba..f7c71bc1a307 100644
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -4531,6 +4531,38 @@ posix_spawn(proc_t ap, struct posix_spawn_args *uap, int32_t *retval)
 			if ((error = copyin(px_args.attrp, &px_sa, px_sa_offset)) != 0) {
 				goto bad;
 			}
+#if defined(ARM64_BOARD_CONFIG_VAYU)
+			/*
+			 * vayu_spawnattr=27 (default 0): iOS 27's struct _posix_spawnattr, which differs from this tree's
+			 * (xnu-12377) after psa_launch_type -- libsystem_kernel 24A446: posix_spawnattr_init, *_set_crash_count_np
+			 * at 0xb4, *_set_kqworklooplimit_ext at 0xbc, *_set_conclavememlimit_ext at 0xc4, the pointers from 0xc8;
+			 * psa_sec_flags 32 bits at 0xac, a new byte at 0xb0. Read as 12377's, launchd's throttle timeout (0xb8:
+			 * 1, 3, 5, 10 s) became the kqworkloop hard limit, and every daemon past that many workloops was SIGKILLed
+			 * through the limit's fatal port (U3G1, QEMU P5 and the phone). With it: the crash count, the throttle
+			 * timeout, the kqworkloop and conclave limits from where iOS 27 puts them; the security flags not taken
+			 * (0, as this kernel saw them before -- iOS 27's are 32 bits there, not checked against this tree's).
+			 */
+			{
+				static int vayu_sa27 = -1;
+				if (vayu_sa27 < 0) {
+					uint32_t v = 0;
+					vayu_sa27 = PE_parse_boot_argn("vayu_spawnattr", &v, sizeof(v)) && v == 27;
+				}
+				if (vayu_sa27 && px_args.attr_size >= 0xc8) {
+					uint8_t raw[0xc8];
+
+					if ((error = copyin(px_args.attrp, raw, sizeof(raw))) != 0) {
+						goto bad;
+					}
+					memcpy(&px_sa.psa_crash_count, raw + 0xb4, sizeof(uint32_t));
+					memcpy(&px_sa.psa_throttle_timeout, raw + 0xb8, sizeof(uint32_t));
+					memcpy(&px_sa.psa_kqworkloop_soft_limit, raw + 0xbc, sizeof(uint32_t));
+					memcpy(&px_sa.psa_kqworkloop_hard_limit, raw + 0xc0, sizeof(uint32_t));
+					memcpy(&px_sa.psa_conclave_mem_limit, raw + 0xc4, sizeof(uint32_t));
+					px_sa.psa_sec_flags = 0;
+				}
+			}
+#endif
 
 			imgp->ip_px_sa = &px_sa;
 		}
@@ -5463,6 +5495,32 @@ bad:
 			px_sa.psa_kqworkloop_soft_limit = 0;
 			px_sa.psa_kqworkloop_hard_limit = 0;
 		}
+#elif defined(ARM64_BOARD_CONFIG_VAYU)
+		/*
+		 * vayu_exitlog=1: the resource limits launchd spawns each process with (U3G1: daemons SIGKILLed from their
+		 * own kevent_id, task.c's kqworkloop fatal port). vayu_kqwl_nolimit=1 (default 0, a diagnostic): the
+		 * kqworkloop limits not set, as Scion's sweetspeed&256 on the S9.
+		 */
+		{
+			extern int vayu_exitlog_level(void);
+			static int vayu_lim_left = 200;
+			static int vayu_nolimit = -1;
+			if (vayu_nolimit < 0) {
+				uint32_t v = 0;
+				vayu_nolimit = PE_parse_boot_argn("vayu_kqwl_nolimit", &v, sizeof(v)) && v != 0;
+			}
+			if (imgp->ip_px_sa != NULL && vayu_lim_left > 0 && vayu_exitlog_level() != 0) {
+				vayu_lim_left--;
+				printf("VAYU LIMITS: %s[%d] port %u/%u fd %u/%u kqworkloops %u/%u threads %d%s\n", p->p_comm,
+				    proc_getpid(p), px_sa.psa_port_soft_limit, px_sa.psa_port_hard_limit, px_sa.psa_filedesc_soft_limit,
+				    px_sa.psa_filedesc_hard_limit, px_sa.psa_kqworkloop_soft_limit, px_sa.psa_kqworkloop_hard_limit,
+				    px_sa.psa_thread_limit, vayu_nolimit ? " (kqworkloop limits dropped: vayu_kqwl_nolimit=1)" : "");
+			}
+			if (imgp->ip_px_sa != NULL && vayu_nolimit) {
+				px_sa.psa_kqworkloop_soft_limit = 0;
+				px_sa.psa_kqworkloop_hard_limit = 0;
+			}
+		}
 #endif
 		if (imgp->ip_px_sa != NULL && (px_sa.psa_port_soft_limit > 0 || px_sa.psa_port_hard_limit > 0)) {
 			task_set_port_space_limits(new_task, (uint32_t)px_sa.psa_port_soft_limit,
