diff --git a/bsd/kern/kern_memorystatus.c b/bsd/kern/kern_memorystatus.c
index 1914d78da542..b3aa6858efae 100644
--- a/bsd/kern/kern_memorystatus.c
+++ b/bsd/kern/kern_memorystatus.c
@@ -3539,6 +3539,11 @@ memorystatus_validate_track_flags(struct proc *target_p, uint32_t pcontrol)
  * re-enabled or the guard state cleared, depending on whether the guard deadline has passed.
  */
 
+#if defined(ARM64_BOARD_CONFIG_VAYU)
+/* vayu27=1 vayu_exitlog=1: why memorystatus kills or terminates a process (bsd/dev/vayu_proclog.c); any lock held */
+extern void vayu_memstat_note(proc_t p, const char *why, uint32_t pcontrol, uint32_t old_dirty);
+#endif
+
 int
 memorystatus_dirty_track(proc_t p, uint32_t pcontrol)
 {
@@ -3669,6 +3674,11 @@ memorystatus_dirty_track(proc_t p, uint32_t pcontrol)
 	memstat_update_priority_locked(p, priority, priority_options);
 
 exit:
+#if defined(ARM64_BOARD_CONFIG_VAYU)
+	if (kill) {
+		vayu_memstat_note(p, "dirty_track: shutdown-on-clean asked while clean", pcontrol, old_dirty);
+	}
+#endif
 	if (kill && proc_ref(p, true) == p) {
 		proc_list_unlock();
 		psignal(p, SIGKILL);
@@ -3694,6 +3704,9 @@ memorystatus_dirty_set(proc_t p, boolean_t self, uint32_t pcontrol)
 	KDBG(MEMSTAT_CODE(BSD_MEMSTAT_DIRTY_SET), proc_getpid(p), self, pcontrol);
 
 	proc_list_lock();
+#if defined(ARM64_BOARD_CONFIG_VAYU)
+	uint32_t vayu_old_dirty = p->p_memstat_dirty;
+#endif
 
 	if (proc_list_exited(p)) {
 		/*
@@ -3779,6 +3792,12 @@ memorystatus_dirty_set(proc_t p, boolean_t self, uint32_t pcontrol)
 	memstat_update_priority_locked(p, priority, MEMSTAT_PRIORITY_OPTIONS_NONE);
 
 exit:
+#if defined(ARM64_BOARD_CONFIG_VAYU)
+	if (kill) {
+		vayu_memstat_note(p, self ? "dirty_set (by itself): clean, and terminated or shutdown-on-clean" :
+		    "dirty_set (by another): the shutdown hold dropped while clean", pcontrol, vayu_old_dirty);
+	}
+#endif
 	if (kill && proc_ref(p, true) == p) {
 		proc_list_unlock();
 		psignal(p, SIGKILL);
@@ -3910,6 +3929,10 @@ memorystatus_on_terminate(proc_t p)
 		/* Dirty, terminated, or state tracking is unsupported; issue SIGTERM to allow cleanup */
 		sig = SIGTERM;
 	}
+#if defined(ARM64_BOARD_CONFIG_VAYU)
+	vayu_memstat_note(p, sig == SIGKILL ? "on_terminate (proc_terminate): clean or suspended -> SIGKILL" :
+	    "on_terminate (proc_terminate): dirty -> SIGTERM", 0, p->p_memstat_dirty);
+#endif
 
 	proc_list_unlock();
 
@@ -3929,6 +3952,11 @@ memorystatus_on_suspend(proc_t p)
 
 	/* Check if proc is marked for termination */
 	bool kill_process = _memstat_proc_is_terminating(p);
+#if defined(ARM64_BOARD_CONFIG_VAYU)
+	if (kill_process) {
+		vayu_memstat_note(p, "on_suspend: suspended while marked terminated", 0, p->p_memstat_dirty);
+	}
+#endif
 	proc_list_unlock();
 
 	if (kill_process) {
