+		} else {
+			pmap_map_bd(start, span.pa, span.pa + span.bytes, prot);
+		}
+#if KASAN
+		kasan_notify_address(start + span.offset, size);
+#endif
+	} else {
+		kma_flags_t kmaflags = KMA_NOFAIL | KMA_PAGEABLE | KMA_IO;
+
+		if (!unmappable) {
+			kmaflags |= KMA_PERMANENT;
+		}
+
+		kmem_alloc(kernel_map, &start, span.bytes, kmaflags,
+		    VM_KERN_MEMORY_IOKIT);
+		pmap_map(start, span.pa, span.pa + span.bytes, prot, flags);
+	}
+	return start + span.offset;
+#else /* !ARM64_BOARD_CONFIG_VAYU */
 	vm_offset_t start_offset = phys_addr - trunc_page(phys_addr);
 	vm_offset_t alloc_size   = round_page(size + start_offset);
