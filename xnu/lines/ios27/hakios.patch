+#if defined(ARM64_BOARD_CONFIG_VAYU)
+/*
+ * VAYU: what the loader handed over, said once the console is up. The loader ABI is this XNU's struct boot_args:
+ * a 1024-byte CommandLine, then bootFlags and memSizeActual (xnuloader's boot_args v2 with xnu=12377). A loader that
+ * writes the 8796 layout (608 bytes) leaves its bootFlags and memSizeActual inside this CommandLine, at bytes
+ * 612..627 (offsets 720 and 728 of its struct): memSizeActual there equal to memSize is that loader's mark.
+ */
+__startup_func
+static void
+vayu_boot_args_report(const boot_args *ba)
+{
+	uint64_t old_msa;
+	size_t len = strnlen(ba->CommandLine, BOOT_LINE_LENGTH);
+
+	__builtin_memcpy(&old_msa, &ba->CommandLine[620], sizeof(old_msa));
+	printf("VAYU: boot_args revision %u version %u, CommandLine %lu of %u bytes, bootFlags 0x%llx, memSize 0x%llx, "
+	    "memSizeActual 0x%llx, device tree %u bytes\n", ba->Revision, ba->Version, len, BOOT_LINE_LENGTH, ba->bootFlags,
+	    ba->memSize, ba->memSizeActual, ba->deviceTreeLength);
+	if (len < 612 && old_msa == ba->memSize) {
+		printf("VAYU: WARNING: the loader wrote the 8796 boot_args (608-byte CommandLine): bootFlags and "
+		    "memSizeActual are not this kernel's (xnuloader: xnu=12377)\n");
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_VAYU */
