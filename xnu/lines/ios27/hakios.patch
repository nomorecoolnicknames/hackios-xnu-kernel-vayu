+	vm_offset_t start;
+
+	if (why == VAYU_IO_MAP_EMPTY) {
+		return 0;
+	}
+	if (why != VAYU_IO_MAP_OK) {
+		panic("io_map: %#llx + %#lx bytes cannot be mapped (%d)", (unsigned long long)phys_addr,
+		    (unsigned long)size, why);
+	}
+	if (startup_phase < STARTUP_SUB_KMEM) {
+		uint64_t first, next;
+
+		why = vayu_io_map_take_va(virtual_space_start, span.bytes, PAGE_MASK, virtual_space_end, &first, &next);
+		if (why != VAYU_IO_MAP_OK) {
+			panic("io_map: no early address space for %#llx + %#llx bytes at %#lx (%d)", span.pa,
+			    span.bytes, (unsigned long)virtual_space_start, why);
+		}
+		start = (vm_offset_t)first;
+		virtual_space_start = (vm_offset_t)next;
+
