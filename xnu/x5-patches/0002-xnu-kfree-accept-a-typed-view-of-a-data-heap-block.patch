--- a/osfmk/kern/kalloc.c
+++ b/osfmk/kern/kalloc.c
@@ -2221,7 +2221,38 @@
 			zstats = KHEAP_KT_VAR->kh_stats;
 		}
 	} else if (zsflags.z_kheap_id != KHEAP_ID_DEFAULT) {
-		kfree_heap_confusion_panic(kheap, data, size, z);
+		/*
+		 * X5: this kernel is built by stock clang, which has none of Apple's type
+		 * builtins, so xnu-deps/hostinc/xnu_clang_compat.h describes every type as
+		 * "mixed pointers and data".  kalloc_type_view_copy() therefore never marks a
+		 * view KT_DATA_ONLY, kalloc_type_get_heap() never redirects it to
+		 * KHEAP_DATA_BUFFERS, and a block that Apple's code allocates with
+		 * kalloc_data() and frees with kfree_type() arrives here: the block is in the
+		 * data heap (data.*), the view says KT_VAR ("").  The zone and the size class
+		 * come from the same array, so such a free is sound and only the heap name
+		 * differs -- kfree_data() would have done exactly this.
+		 *
+		 * Apple's own log_stream_teardown() (bsd/kern/subr_log_stream.c) makes that
+		 * free on every close of /dev/oslog_stream, which is how a user process
+		 * closing the live os_log stream panicked the kernel (X5, TEST19:
+		 * kfree_heap_confusion_panic in diagnosticd, kalloc.c:2116).
+		 *
+		 * The mismatch is a property of this toolchain, not of the caller, so it is
+		 * accepted here and nowhere else; an Apple-clang build keeps the strict check.
+		 */
+		bool kt_view_of_data_heap = false;
+
+#if XNU_NO_TYPE_BUILTINS
+		kt_view_of_data_heap =
+		    (kheap == KHEAP_KT_VAR && zsflags.z_kheap_id == KHEAP_ID_DATA_BUFFERS);
+#endif
+		if (kt_view_of_data_heap) {
+			if (zstats == NULL) {
+				zstats = z->z_stats;
+			}
+		} else {
+			kfree_heap_confusion_panic(kheap, data, size, z);
+		}
 	}
 
 	DTRACE_VM3(kfree, vm_size_t, size, vm_size_t, zsize, void*, data);
