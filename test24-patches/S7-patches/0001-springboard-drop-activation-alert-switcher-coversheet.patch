+/*
+ * Every way SBActivationFailedAlertItem can be taken down, in the order that is safest:
+ *   1. deactivateAlertItemsOfClass:reason:animated: with the class itself -- works even when
+ *      "visibleAlertItem" is not the super-modal one;
+ *   2. the item visibleAlertItem names;
+ *   3. deactivateAlertForMenuClickOrSystemGestureWithAnimation: -- the path a menu click takes,
+ *      for an item that is presentable that way;
+ *   4. _clearAllQueuedAlertItems for anything still queued.
+ * Returns how many of those calls were made.
+ */
+static unsigned
+dismiss_alerts(void)
+{
+	Class cls = objc_getClass("SBAlertItemsController");
+	Class failed = objc_getClass("SBActivationFailedAlertItem");
+	id controller;
+	id item = nil;
+	BOOL has = NO, can = NO;
+	unsigned done = 0;
+
+	if (cls == NULL || class_method_of(cls, "sharedInstance") == NULL) {
+		say("hakios: alerts: there is no SBAlertItemsController in this SpringBoard\n");
+		return 0;
+	}
+	controller = ((id (*)(Class, SEL))objc_msgSend)(cls, sel_registerName("sharedInstance"));
+	if (controller == NULL) {
+		say("hakios: alerts: no SBAlertItemsController yet\n");
+		return 0;
+	}
+	if (method_of(controller, "hasVisibleAlert") != NULL) {
+		has = ((BOOL (*)(id, SEL))objc_msgSend)(controller, sel_registerName("hasVisibleAlert"));
+	}
+	if (method_of(controller, "visibleAlertItem") != NULL) {
+		item = ((id (*)(id, SEL))objc_msgSend)(controller, sel_registerName("visibleAlertItem"));
+	}
+	if (method_of(controller, "canDeactivateAlertForMenuClickOrSystemGesture") != NULL) {
+		can = ((BOOL (*)(id, SEL))objc_msgSend)(controller,
+		    sel_registerName("canDeactivateAlertForMenuClickOrSystemGesture"));
+	}
+	say("hakios: alerts: hasVisibleAlert %d, canDeactivate %d, visible item %s\n", has, can,
+	    item != NULL ? object_getClassName(item) : "none");
+	if (failed != NULL) {
+		if (method_of(controller, "deactivateAlertItemsOfClass:") != NULL) {
+			((void (*)(id, SEL, Class))objc_msgSend)(controller,
+			    sel_registerName("deactivateAlertItemsOfClass:"), failed);
+			done++;
+			say("hakios: alerts: deactivateAlertItemsOfClass:SBActivationFailedAlertItem\n");
+		} else if (method_of(controller, "deactivateAlertItemsOfClass:reason:") != NULL) {
+			((void (*)(id, SEL, Class, long))objc_msgSend)(controller,
+			    sel_registerName("deactivateAlertItemsOfClass:reason:"), failed, 0);
+			done++;
+			say("hakios: alerts: deactivateAlertItemsOfClass:SBActivationFailedAlertItem reason:0\n");
+		} else if (method_of(controller, "deactivateAlertItemsOfClass:reason:animated:") != NULL) {
+			((void (*)(id, SEL, Class, long, BOOL))objc_msgSend)(controller,
+			    sel_registerName("deactivateAlertItemsOfClass:reason:animated:"), failed, 0, NO);
+			done++;
+			say("hakios: alerts: deactivateAlertItemsOfClass:SBActivationFailedAlertItem reason:0 animated:NO\n");
+		}
+	}
+	if (item != NULL && method_of(controller, "deactivateAlertItem:") != NULL) {
+		((void (*)(id, SEL, id))objc_msgSend)(controller, sel_registerName("deactivateAlertItem:"), item);
+		done++;
+		say("hakios: alerts: deactivateAlertItem:%s\n", object_getClassName(item));
+	} else if (item != NULL && method_of(controller, "deactivateAlertItem:reason:animated:") != NULL) {
+		((void (*)(id, SEL, id, long, BOOL))objc_msgSend)(controller,
+		    sel_registerName("deactivateAlertItem:reason:animated:"), item, 0, NO);
+		done++;
+		say("hakios: alerts: deactivateAlertItem:%s reason:0 animated:NO\n", object_getClassName(item));
+	} else if (has && can && method_of(controller, "deactivateAlertForMenuClickOrSystemGestureWithAnimation:") != NULL) {
+		((void (*)(id, SEL, BOOL))objc_msgSend)(controller,
+		    sel_registerName("deactivateAlertForMenuClickOrSystemGestureWithAnimation:"), NO);
+		done++;
+		say("hakios: alerts: deactivateAlertForMenuClickOrSystemGestureWithAnimation:NO\n");
+	}
+	if (method_of(controller, "_clearAllQueuedAlertItems") != NULL) {
+		((void (*)(id, SEL))objc_msgSend)(controller, sel_registerName("_clearAllQueuedAlertItems"));
+		done++;
+	}
+	has = method_of(controller, "hasVisibleAlert") != NULL ?
+	    ((BOOL (*)(id, SEL))objc_msgSend)(controller, sel_registerName("hasVisibleAlert")) : has;
+	say("hakios: alerts: %u request(s) made, hasVisibleAlert now %d\n", done, has);
+	return done;
+}
