+/* The method of an object's class, or NULL (an object that is nil has none). */
+static Method
+method_of(id object, const char *selector)
+{
+	return object != NULL ? class_getInstanceMethod(object_getClass(object), sel_registerName(selector)) : NULL;
+}
+
+static Method
+class_method_of(Class cls, const char *selector)
+{
+	return cls != NULL ? class_getClassMethod(cls, sel_registerName(selector)) : NULL;
+}
