+/* Whether a window of this class is in UIApplication's list and not hidden. */
+static BOOL
+window_of_class_on_screen(const char *class_name)
+{
+	Class app = objc_getClass("UIApplication");
+	id application = app != NULL ? ((id (*)(Class, SEL))objc_msgSend)(app, sel_registerName("sharedApplication")) : nil;
+	Method windows_method = method_of(application, "windows");
+	id windows;
+	BOOL found = NO;
+
+	if (windows_method == NULL) {
+		return NO;
+	}
+	windows = ((id (*)(id, SEL))objc_msgSend)(application, sel_registerName("windows"));
+	for (unsigned i = 0; i < ((unsigned (*)(id, SEL))objc_msgSend)(windows, sel_registerName("count")); i++) {
+		id window = ((id (*)(id, SEL, unsigned))objc_msgSend)(windows, sel_registerName("objectAtIndex:"), i);
+
+		if (window != NULL && strcmp(object_getClassName(window), class_name) == 0 &&
+		    !((BOOL (*)(id, SEL))objc_msgSend)(window, sel_registerName("isHidden"))) {
+			found = YES;
+		}
+	}
+	return found;
+}
