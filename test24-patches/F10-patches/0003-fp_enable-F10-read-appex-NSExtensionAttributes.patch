+	/*
+	 * F10: the shim's -attributes is the NSExtensionAttributes dictionary (plus the three point keys
+	 * ExtensionFoundation synthesizes), but the daemon's descriptor reads the nested NSExtensionAttributes
+	 * from the appex's Info.plist: -[FPDProviderDescriptor initWithExtension:] (0x1c3c6551c) does
+	 * [bundle infoDictionary][NSExtension][NSExtensionAttributes] and takes every NSExtensionFileProvider*
+	 * key from it (0x1c3c65c14-0x1c3c66038). A record whose attributes come out short, while the Info.plist
+	 * has the nested key, is therefore usable by the daemon -- do not hold the domain-creating call back on
+	 * the shim's answer alone. The appex copy is read from disk, exactly as the daemon reads it.
+	 */
+	if ((value == nil || ![group isEqual:value]) && appex_value != nil) {
+		value = appex_value;
+		value_source = [appex_attributes isKindOfClass:[NSDictionary class]] ?
+		    "appex NSExtension.NSExtensionAttributes" : "appex NSExtension";
+		fprintf(stderr, "fp_enable: pkd: NSExtension.attributes has no usable group, but the appex's "
+		    "%s does (F10: the daemon reads this Info.plist; FileProviderDaemon 0x1c3c6551c)\n",
+		    value_source);
+	}
+	fprintf(stderr, "fp_enable: pkd: NSExtension %s: found; NSExtensionFileProviderDocumentGroup = %s "
+	    "(from %s)%s\n", [identifier UTF8String],
+	    value != nil ? [[value description] UTF8String] : "(absent)", value_source,
 	    value != nil && [group isEqual:value] ? "" : "  <- the daemon's descriptor has no usable group");
 	return [group isEqual:value] ? 1 : 0;
