+		sayf("hakios: %s: s8_touch: -[%s _shouldGenerate120HzEvents] has type %s: left alone\n", who, name,
+		    types != NULL ? types : "?");
+		return 0;
+	}
+	if (old != (IMP)s8_yes) {
+		method_setImplementation(method, (IMP)s8_yes);
+	}
+	sayf("hakios: %s: s8_touch: -[%s _shouldGenerate120HzEvents] answers YES (was %p)\n", who, name, old);
+	return 1;
+}
+
+static void
+s8_touch_delivery(void)
+{
+	static const char *const owners[] = {
+		"UIApplication", "UIResponder", "UIWindow", "UIScene", "UIWindowScene", "UIView", "UIViewController",
+		"UIScrollView", "UIPanGestureRecognizer",
+	};
+	const unsigned total = sizeof(owners) / sizeof(owners[0]);
+	int mode = s8_touch_wanted();
+	void *getter;
+	SEL selector;
+	unsigned replaced = 0;
+
+	if (mode <= 0) {
+		return;
+	}
+	sayf("hakios: %s: s8_touch=%d: 120 Hz touch delivery is to be asked for\n", who, mode);
+	getter = dlsym(RTLD_DEFAULT, "_MobileGestalt_get_touchDelivery120Hz");
+	selector = sel_registerName("_shouldGenerate120HzEvents");
+	if (getter == NULL) {
+		sayf("hakios: %s: s8_touch: no _MobileGestalt_get_touchDelivery120Hz in this process\n", who);
+	} else {
+		bool answer = ((s8_bool_answer)getter)();
+
+		sayf("hakios: %s: s8_touch: _MobileGestalt_get_touchDelivery120Hz at %p answers %d\n", who, getter,
+		    answer ? 1 : 0);
+		if (!answer) {
+			/* mov w0, #1 ; ret -- a bool comes back in w0; the page is the shared cache's, copied privately */
+			static const uint32_t answer_yes[2] = { 0x52800020u, 0xd65f03c0u };
+			uintptr_t page = (uintptr_t)getter & ~(uintptr_t)0x3fffu;
+
+			if (mprotect((void *)page, 0x4000, PROT_READ | PROT_WRITE | PROT_EXEC) == 0) {
+				memcpy(getter, answer_yes, sizeof(answer_yes));
+				sys_icache_invalidate(getter, sizeof(answer_yes));
+				sayf("hakios: %s: s8_touch: patched it to answer 1\n", who);
+			} else {
+				sayf("hakios: %s: s8_touch: mprotect(%p): %s\n", who, (void *)page, strerror(errno));
+			}
+		}
+	}
+	for (unsigned i = 0; i < total; i++) {
+		replaced += s8_touch_class(objc_getClass(owners[i]), selector, owners[i]);
+	}
+	sayf("hakios: %s: s8_touch=%d: %u of %u named class(es) answer YES\n", who, mode, replaced, total);
+	if (mode >= 2) {
+		int count = objc_getClassList(NULL, 0);
+		Class *classes = count > 0 ? malloc(sizeof(Class) * (size_t)count) : NULL;
+		unsigned swept = 0;
+
+		if (classes != NULL) {
+			int registered = count;
+
+			count = objc_getClassList(classes, count);
+			for (int i = 0; i < count; i++) {
+				const char *name = class_getName(classes[i]);
+
+				if (name == NULL || (strncmp(name, "UI", 2) != 0 && strncmp(name, "_UI", 3) != 0)) {
+					continue;
+				}
+				swept++;
+				replaced += s8_touch_class(classes[i], selector, name);
+			}
+			sayf("hakios: %s: s8_touch=2: %d classes registered, %u with a UI name, %u answer YES in all\n", who,
+			    registered, swept, replaced);
+			free(classes);
+		}
+	}
+}
