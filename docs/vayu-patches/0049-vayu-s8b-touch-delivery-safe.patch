+ * result line followed it, while the small containermanagerd printed one, and the window server
+ * never drew a frame (run 050024: 0 "hakios-gl", 0 frame windows). A constructor must not realize
+ * every class of a process: that is a runtime-wide sweep under the Objective-C lock.
+ *
+ * What is left: the MobileGestalt getter is asked and, if it answers 0, patched to answer 1 (this
+ * process's copy of the page only), and -_shouldGenerate120HzEvents is answered YES where it is
+ * found -- on nine classes by name, and in mode 2 on the UI* classes of the class list, whose names
+ * are read without realizing them. Every answer is logged. Off by default: the F12 boot (kernel
+ * test26, root without this hook) already showed 120 Hz to the owner, so this is an experiment.
+ */
+typedef bool (*s8_bool_answer)(void);
+
+static BOOL
+s8_yes(id self, SEL selector)
+{
+	(void)self;
+	(void)selector;
+	return YES;
+}
+
+/* 0: off; 1: the named classes; 2: and the UI* classes of the list. */
+static int
+s8_touch_wanted(void)
+{
+	static int mode = -1;
+
+	if (mode < 0) {
+		char arguments[4096] = "";
+		size_t size = sizeof(arguments) - 1;
+		const char *at = NULL;
+
+		mode = 0;
+		if (sysctlbyname("kern.bootargs", arguments, &size, NULL, 0) == 0) {
+			at = strstr(arguments, "s8_touch=");
+		}
+		if (at != NULL && (at == arguments || at[-1] == ' ') && at[10] >= '1' && at[10] <= '2') {
+			mode = at[10] - '0';
+		}
+	}
+	return mode;
+}
+
+/* Answer YES to -[cls _shouldGenerate120HzEvents] when it has that method and it returns a BOOL.
+ * Returns 1 when the class answers YES afterwards. */
+static unsigned
+s8_touch_class(Class cls, SEL selector, const char *name)
+{
+	Method method;
+	const char *types;
+	IMP old;
+
+	if (cls == NULL) {
+		return 0;
+	}
+	method = class_getInstanceMethod(cls, selector);
+	if (method == NULL) {
+		method = class_getClassMethod(cls, selector);
+	}
+	if (method == NULL) {
+		return 0;
+	}
+	types = method_getTypeEncoding(method);
+	old = method_getImplementation(method);
+	if (types == NULL || (types[0] != 'B' && types[0] != 'c')) {
+		say("hakios: %s: s8_touch: -[%s _shouldGenerate120HzEvents] has type %s: left alone\n", getprogname(), name,
+		    types != NULL ? types : "?");
+		return 0;
+	}
+	if (old != (IMP)s8_yes) {
+		method_setImplementation(method, (IMP)s8_yes);
+	}
+	say("hakios: %s: s8_touch: -[%s _shouldGenerate120HzEvents] answers YES (was %p)\n", getprogname(), name, old);
+	return 1;
+}
+
+static void
+s8_touch_delivery(void)
+{
+	static const char *const owners[] = {
+		"UIApplication", "UIResponder", "UIWindow", "UIScene", "UIWindowScene", "UIView", "UIViewController",
+		"UIScrollView", "UIPanGestureRecognizer",
+	};
