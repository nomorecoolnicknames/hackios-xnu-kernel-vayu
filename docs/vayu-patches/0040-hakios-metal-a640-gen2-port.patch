From a9c843cb40bc5f7ac7548cad457d3f42b6efeb2e Mon Sep 17 00:00:00 2001
From: agent <agent@local>
Date: Mon, 2 Nov 2026 04:02:13 +0300
Subject: [PATCH] A640 (vayu, a6xx gen2) port: chip facts, no LPAC copies,
 RedwoodGPU transport, probe --stages

---
 include/hakios-metal/a6xx.hpp     | 85 ++++++++++++++++---------------
 include/hakios-metal/compute.hpp  |  3 +-
 include/hakios-metal/fake_gpu.hpp | 13 +++--
 src/command.cpp                   |  6 +--
 src/compiler.cpp                  | 12 +++--
 src/fake_gpu.cpp                  | 30 +++++++----
 src/iokit_transport.cpp           | 23 +++++++--
 src/texture.cpp                   |  4 ++
 tests/a6xx_test.cpp               | 20 ++++----
 tests/c_api_test.cpp              |  2 +-
 tests/command_test.cpp            | 18 +++----
 tests/compute_test.cpp            | 21 ++++++--
 tests/render_test.cpp             | 22 ++++----
 tests/texture_test.cpp            | 12 +++--
 tools/probe.cpp                   | 27 ++++++++++
 tools/probe_fake_transport.cpp    | 10 ++++
 16 files changed, 200 insertions(+), 108 deletions(-)
 create mode 100644 tools/probe_fake_transport.cpp

diff --git a/include/hakios-metal/a6xx.hpp b/include/hakios-metal/a6xx.hpp
index b01af4c..e75a81d 100644
--- a/include/hakios-metal/a6xx.hpp
+++ b/include/hakios-metal/a6xx.hpp
@@ -1,5 +1,5 @@
 // The Adreno A6xx registers, packet words and descriptor fields a compute dispatch and one draw write, for the Adreno
-// 7c+ Gen 3 (the A635 family, chip id 0x06030500: Mesa's "a6xx gen4", the same generation as the A660).
+// 640 (SM8150, chip id 0x06040001: Mesa's "a6xx gen2"). Ported from the Adreno 7c+ Gen 3 (A635, gen4) original.
 //
 // Every number here is Mesa 25.0.7's (MIT), from the register XML in src/freedreno/registers/adreno/ (a6xx.xml,
 // adreno_pm4.xml, adreno_common.xml) through the headers Mesa's build generates from it: a6xx.xml.h,
@@ -24,21 +24,23 @@
 namespace hakios::metal::a6xx {
 
 // --- this chip -----------------------------------------------------------------------------------------------------
-// From Mesa's src/freedreno/common/freedreno_devices.py: the entry for chip_id ...06030500 ("Adreno 7c+ Gen 3", every
-// speedbin of the A635) is a6xx_base + a6xx_gen4 with num_ccu = 2.
+// From Mesa's src/freedreno/common/freedreno_devices.py: the entry GPUId(640) (chip_id 0x060400ff, the patch level a
+// wildcard) is a6xx_base + a6xx_gen2 with num_ccu = 2. This port: the Adreno 640 of the POCO X3 Pro (SM8150, vayu),
+// whose kernel (bsd/dev/vayu_adreno.c vayu_gpu_parameter) answers CHIP_ID 0x06040001 and GMEM_SIZE 1 MiB.
 
-inline constexpr uint32_t kChipId = 0x06030500;             // not-in-headers: freedreno_devices.py GPUId(chip_id=0x..06030500)
-inline constexpr bool kHasLpac = true;                       // not-in-headers: freedreno_devices.py a6xx_gen4.has_lpac
+inline constexpr uint32_t kChipId = 0x06040001;             // not-in-headers: vayu_adreno.c GMU_CHIP_ID; Mesa matches it to GPUId(640)
+inline constexpr bool kHasLpac = false;                      // not-in-headers: freedreno_devices.py a6xx_gen2 (has_lpac only in a6xx_gen4)
 inline constexpr bool kSupportsDoubleThreadsize = true;      // not-in-headers: freedreno_devices.py a6xx_base.supports_double_threadsize
-// CP_LOAD_STATE6_0_NUM_UNIT for a shader (ST6_SHADER) is capped at this many instruction groups: Mesa's comment says
-// the blob allows 128 but 128 hangs this generation, so 127 it is (a longer shader is fetched past the preload).
-inline constexpr uint32_t kInstrCacheSize = 127;             // not-in-headers: freedreno_devices.py a6xx_gen4.instr_cache_size
-inline constexpr uint32_t kFibersPerSp = 128 * 2 * 16;       // not-in-headers: freedreno_devices.py, the A635 entry (fibers_per_sp)
-inline constexpr uint32_t kNumSpCores = 2;                   // not-in-headers: freedreno_devices.py num_sp_cores = num_ccu for the A635
-inline constexpr uint32_t kCsSharedMemSize = 32 * 1024;      // not-in-headers: freedreno_devices.py, the A635 entry (cs_shared_mem_size)
+// CP_LOAD_STATE6_0_NUM_UNIT for a shader (ST6_SHADER) is capped at this many instruction groups (a longer shader is
+// fetched past the preload). a6xx_gen2 says 64 (marked TODO in Mesa: not measured on an A640 by anybody yet).
+inline constexpr uint32_t kInstrCacheSize = 64;              // not-in-headers: freedreno_devices.py a6xx_gen2.instr_cache_size
+inline constexpr uint32_t kRegSizeVec4 = 96;                 // not-in-headers: freedreno_devices.py a6xx_gen2.reg_size_vec4
+inline constexpr uint32_t kFibersPerSp = 128 * 4 * 16;       // not-in-headers: freedreno_devices.py, the A640 entry (fibers_per_sp)
+inline constexpr uint32_t kNumSpCores = 2;                   // not-in-headers: freedreno_devices.py num_sp_cores = num_ccu for the A640
+inline constexpr uint32_t kCsSharedMemSize = 32 * 1024;      // not-in-headers: freedreno_devices.py, the A640 entry (cs_shared_mem_size)
 inline constexpr uint32_t kThreadsizeBase = 64;              // not-in-headers: freedreno_devices.py A6xxGPUInfo default threadsize_base
 inline constexpr uint32_t kMaxWaves = 16;                    // not-in-headers: freedreno_devices.py A6xxGPUInfo default max_waves
-inline constexpr uint32_t kWaveGranularity = 2;              // not-in-headers: freedreno_devices.py, the A635 entry (wave_granularity)
+inline constexpr uint32_t kWaveGranularity = 2;              // not-in-headers: freedreno_devices.py, the A640 entry (wave_granularity)
 // ir3's "no register": regid(63, 0) = 63 << 2 | 0. The *CONSTID / *REGID fields take it for a value the shader does
 // not read (the work group size and offset constants, the linear local id), and it is what Mesa writes there.
 inline constexpr uint32_t kRegidNone = 0xfc;                 // not-in-headers: ir3/instr-a3xx.h INVALID_REG = regid(63, 0)
@@ -1388,33 +1390,34 @@ struct RegWrite {
     uint32_t value;
 };
 
-// Mesa's per-chip "magic" values, as its generated freedreno_devices.h has them for this chip (__info14, the entry every
-// A635 chip id maps to). Mesa does not know what most of them mean either; they are what the blob writes.
-inline constexpr uint32_t kMagicPcPowerCntl = 1;                  // not-in-headers: freedreno_devices.h __info14 .magic.PC_POWER_CNTL
-inline constexpr uint32_t kMagicTpl1DbgEcoCntl = 0x05008000;      // not-in-headers: freedreno_devices.h __info14 .magic.TPL1_DBG_ECO_CNTL (83918848)
-inline constexpr uint32_t kMagicGrasDbgEcoCntl = 0;               // not-in-headers: freedreno_devices.h __info14 .magic.GRAS_DBG_ECO_CNTL
-inline constexpr uint32_t kMagicSpChickenBits = 0x00001400;       // not-in-headers: freedreno_devices.h __info14 .magic.SP_CHICKEN_BITS (5120)
-inline constexpr uint32_t kMagicUcheClientPf = 0x00000084;        // not-in-headers: freedreno_devices.h __info14 .magic.UCHE_CLIENT_PF (132)
-inline constexpr uint32_t kMagicPcModeCntl = 0x1f;                // not-in-headers: freedreno_devices.h __info14 .magic.PC_MODE_CNTL (31)
-inline constexpr uint32_t kMagicSpDbgEcoCntl = 0x00000006;        // not-in-headers: freedreno_devices.h __info14 .magic.SP_DBG_ECO_CNTL
-inline constexpr uint32_t kMagicRbDbgEcoCntl = 0x04100000;        // not-in-headers: freedreno_devices.h __info14 .magic.RB_DBG_ECO_CNTL (68157440)
-inline constexpr uint32_t kMagicHlsqDbgEcoCntl = 0;               // not-in-headers: freedreno_devices.h __info14 .magic.HLSQ_DBG_ECO_CNTL
-inline constexpr uint32_t kMagicRbUnknown8E01 = 0;                // not-in-headers: freedreno_devices.h __info14 .magic.RB_UNKNOWN_8E01
-inline constexpr uint32_t kMagicVpcDbgEcoCntl = 0x02000000;       // not-in-headers: freedreno_devices.h __info14 .magic.VPC_DBG_ECO_CNTL (33554432)
-inline constexpr uint32_t kMagicUcheUnknown0E12 = 1;              // not-in-headers: freedreno_devices.h __info14 .magic.UCHE_UNKNOWN_0E12
+// Mesa's per-chip "magic" values, as freedreno_devices.py has them for GPUId(640) (magic_regs of that entry). Mesa does
+// not know what most of them mean either; they are what the blob writes.
+inline constexpr uint32_t kMagicPcPowerCntl = 1;                  // not-in-headers: freedreno_devices.py A640 magic_regs PC_POWER_CNTL
+inline constexpr uint32_t kMagicTpl1DbgEcoCntl = 0x00008000;      // not-in-headers: freedreno_devices.py A640 magic_regs TPL1_DBG_ECO_CNTL
+inline constexpr uint32_t kMagicGrasDbgEcoCntl = 0;               // not-in-headers: freedreno_devices.py A640 magic_regs GRAS_DBG_ECO_CNTL
+inline constexpr uint32_t kMagicSpChickenBits = 0x00000420;       // not-in-headers: freedreno_devices.py A640 magic_regs SP_CHICKEN_BITS
+inline constexpr uint32_t kMagicUcheClientPf = 0x00000004;        // not-in-headers: freedreno_devices.py A640 magic_regs UCHE_CLIENT_PF
+inline constexpr uint32_t kMagicPcModeCntl = 0x1f;                // not-in-headers: freedreno_devices.py A640 magic_regs PC_MODE_CNTL
+inline constexpr uint32_t kMagicSpDbgEcoCntl = 0x00000000;        // not-in-headers: freedreno_devices.py A640 magic_regs SP_DBG_ECO_CNTL
+inline constexpr uint32_t kMagicRbDbgEcoCntl = 0x04100000;        // not-in-headers: freedreno_devices.py A640 magic_regs RB_DBG_ECO_CNTL
+inline constexpr uint32_t kMagicHlsqDbgEcoCntl = 0;               // not-in-headers: freedreno_devices.py A640 magic_regs HLSQ_DBG_ECO_CNTL
+inline constexpr uint32_t kMagicRbUnknown8E01 = 1;                // not-in-headers: freedreno_devices.py A640 magic_regs RB_UNKNOWN_8E01
+inline constexpr uint32_t kMagicVpcDbgEcoCntl = 0x02000000;       // not-in-headers: freedreno_devices.py A640 magic_regs VPC_DBG_ECO_CNTL
+inline constexpr uint32_t kMagicUcheUnknown0E12 = 1;              // not-in-headers: freedreno_devices.py A640 magic_regs UCHE_UNKNOWN_0E12
 // and the chip facts fd6_emit_static_regs and fd6_emit_ccu_cntl branch on
-inline constexpr bool kHasGmemFastClear = true;                   // not-in-headers: freedreno_devices.h __info14 .has_gmem_fast_clear
-inline constexpr bool kConcurrentResolve = false;                 // not-in-headers: freedreno_devices.h __info14 has no .concurrent_resolve (false)
-inline constexpr bool kHasEarlyPreamble = false;                  // not-in-headers: freedreno_devices.h __info14 has no .has_early_preamble (a6xx_gen4 leaves it off)
-inline constexpr uint32_t kNumCcu = 2;                            // not-in-headers: freedreno_devices.h __info14 .num_ccu
-inline constexpr uint32_t kSysmemPerCcuDepthCacheSize = 0x10000;  // not-in-headers: freedreno_devices.h __info14 .sysmem_per_ccu_depth_cache_size (65536)
-inline constexpr uint32_t kSysmemPerCcuColorCacheSize = 0x10000;  // not-in-headers: freedreno_devices.h __info14 .sysmem_per_ccu_color_cache_size (65536)
-// tiled rendering: the on-chip memory and the tile grid (a6xx_gen4 / adreno_7c3 in freedreno_devices.py)
-inline constexpr uint32_t kGmemBytes = 512 * 1024;                // not-in-headers: freedreno_devices.py adreno_7c3 gmem_size (Linux a6xx_gpu adreno_7c3 SZ_512K)
-inline constexpr uint32_t kGmemCcuColorCacheFraction = 4;          // not-in-headers: freedreno_devices.py a6xx_gen4 gmem_ccu_color_cache_fraction QUARTER
-inline constexpr uint32_t kTileAlignW = 32, kTileAlignH = 16;      // not-in-headers: freedreno_devices.py a6xx_gen4 tile_align_w/h
-inline constexpr uint32_t kGmemAlignW = 16, kGmemAlignH = 4;       // not-in-headers: freedreno_devices.py a6xx_gen4 gmem_align_w/h (the event blit's granule)
-inline constexpr uint32_t kTileMaxW = 1024, kTileMaxH = 1008;      // not-in-headers: freedreno_devices.py a6xx_gen4 tile_max_w/h
+inline constexpr bool kHasGmemFastClear = true;                   // not-in-headers: freedreno_devices.py a6xx_base has_gmem_fast_clear (gen2 keeps it)
+inline constexpr bool kConcurrentResolve = false;                 // not-in-headers: a6xx_gen2 has no concurrent_resolve
+inline constexpr bool kHasEarlyPreamble = false;                  // not-in-headers: a6xx_gen2 has no has_early_preamble
+inline constexpr bool kHasTexFilterCubic = false;                 // not-in-headers: a6xx_gen2 has no has_tex_filter_cubic (gen3/gen4 only)
+inline constexpr uint32_t kNumCcu = 2;                            // not-in-headers: freedreno_devices.py A640 num_ccu
+inline constexpr uint32_t kSysmemPerCcuDepthCacheSize = 0x10000;  // not-in-headers: a6xx_base sysmem_per_ccu_depth_cache_size (65536)
+inline constexpr uint32_t kSysmemPerCcuColorCacheSize = 0x10000;  // not-in-headers: a6xx_base sysmem_per_ccu_color_cache_size (65536)
+// tiled rendering: the on-chip memory and the tile grid (A640 entry + A6xxGPUInfo defaults in freedreno_devices.py)
+inline constexpr uint32_t kGmemBytes = 1024 * 1024;               // not-in-headers: Linux adreno_device.c A640 SZ_1M; vayu_adreno.c GMEM_SIZE 0x100000
+inline constexpr uint32_t kGmemCcuColorCacheFraction = 4;          // not-in-headers: a6xx_base gmem_ccu_color_cache_fraction QUARTER
+inline constexpr uint32_t kTileAlignW = 32, kTileAlignH = 16;      // not-in-headers: freedreno_devices.py A640 tile_align_w/h
+inline constexpr uint32_t kGmemAlignW = 16, kGmemAlignH = 4;       // not-in-headers: A6xxGPUInfo gmem_align_w/h (the event blit's granule)
+inline constexpr uint32_t kTileMaxW = 1024, kTileMaxH = 1008;      // not-in-headers: A6xxGPUInfo tile_max_w/h for CHIP.A6XX
 // the border color table both TP base registers point at: Gallium's is FD6_MAX_BORDER_COLORS (256) entries of
 // sizeof(struct fd6_bcolor_entry) (128 bytes: 32 fp32/fp16/int words); zeros are a valid table (black, transparent)
 inline constexpr uint32_t kBorderColorBytes = 256 * 128;          // not-in-headers: fd6_texture.h FD6_MAX_BORDER_COLORS * FD6_BORDER_COLOR_SIZE
@@ -4085,18 +4088,18 @@ constexpr uint32_t binControlGmem(bool lrzFeedback, uint32_t binw, uint32_t binh
 }
 // RB_CCU_CNTL for tiled rendering: the colour cache shrunk to its GMEM fraction and moved to GMEM's end, so the tiles
 // own everything below it (tu_cmd_buffer.cc tu6_emit_ccu_cntl, gmem: ccu_offset_gmem = gmem - num_ccu * color cache /
-// fraction); depth cache unused (no depth attachment in a GMEM pass here). 0x3c400000 on this chip
+// fraction); depth cache unused (no depth attachment in a GMEM pass here). 0x7c400000 on the A640 (1 MiB: offset 0xf8000)
 constexpr uint32_t kGmemCcuColorOffset = kGmemBytes - kNumCcu * kSysmemPerCcuColorCacheSize / kGmemCcuColorCacheFraction;
 constexpr uint32_t rbCcuCntlGmem() {
     return (kHasGmemFastClear ? 0u : A6XX_RB_CCU_CNTL_GMEM_FAST_CLEAR_DISABLE) | A6XX_RB_CCU_CNTL_COLOR_OFFSET_HI(kGmemCcuColorOffset >> 21) |
            A6XX_RB_CCU_CNTL_COLOR_CACHE_SIZE(CCU_CACHE_SIZE_QUARTER) | A6XX_RB_CCU_CNTL_COLOR_OFFSET(kGmemCcuColorOffset & 0x1fffff);
 }
-static_assert(rbCcuCntlGmem() == 0x3c400000, "the GMEM CCU layout turnip computes for this chip");
+static_assert(rbCcuCntlGmem() == 0x7c400000, "the GMEM CCU layout turnip computes for this chip (A640, 1 MiB GMEM)");
 
 // hardware binning (fd6_gmem.cc emit_binning_pass, update_vsc_pipe, fd6_emit_tile_prep): the binning pass runs every draw's
 // vertex stage once over the whole window and the VSC writes, for each pipe of bins, which draws and primitives reach
 // each bin; a tile then draws only those (CP_SET_BIN_DATA5, CP_SET_VISIBILITY_OVERRIDE 0, the draws USE_VISIBILITY)
-inline constexpr uint32_t kNumVscPipes = 32;                      // not-in-headers: freedreno_devices.py A635 num_vsc_pipes
+inline constexpr uint32_t kNumVscPipes = 32;                      // not-in-headers: freedreno_devices.py A640 num_vsc_pipes
 inline constexpr uint32_t REG_A6XX_VSC_BIN_SIZE = 0x0c02;                                    // a6xx.xml.h:4147  WIDTH >> 5 at 0, HEIGHT >> 4 at 8
 inline constexpr uint32_t REG_A6XX_VSC_DRAW_STRM_SIZE_ADDRESS = 0x0c03;                      // a6xx.xml.h:4164  64-bit: each pipe's draw-stream size written back
 inline constexpr uint32_t REG_A6XX_VSC_BIN_COUNT = 0x0c06;                                   // a6xx.xml.h:4167  NX at 1, NY at 11
diff --git a/include/hakios-metal/compute.hpp b/include/hakios-metal/compute.hpp
index 147a5d5..c0aeb24 100644
--- a/include/hakios-metal/compute.hpp
+++ b/include/hakios-metal/compute.hpp
@@ -25,6 +25,7 @@
 #include <string>
 #include <vector>
 
+#include "hakios-metal/a6xx.hpp"
 #include "hakios-metal/kernel.hpp"
 #include "hakios-metal/pm4.hpp"
 
@@ -106,7 +107,7 @@ static_assert(kTableIbosAt + kMaxIbos * 64 <= kTableTexConstAt && kTableTexConst
 struct Options {
     bool prelude = true;        // SP_MODE_CONTROL, SP_PERFCTR_ENABLE, SP_FLOAT_CNTL, as computerator opens with
     bool invalidateCmd = true;  // HLSQ_INVALIDATE_CMD before the program
-    bool hlsqCopies = true;     // the gen4 (has_lpac) copies: HLSQ_CS_CTRL_REG1, SP_CS_CNTL_0/1
+    bool hlsqCopies = a6xx::kHasLpac;   // the gen4 (has_lpac) copies: HLSQ_CS_CTRL_REG1, SP_CS_CNTL_0/1; off on the A640 (gen2)
     bool pvtmemZero = true;     // the private-memory registers written as zero (Gallium does; computerator leaves them)
     bool invalidate = true;     // CP_EVENT_WRITE CACHE_INVALIDATE before the dispatch (Gallium's barrier)
     bool marker = true;         // CP_SET_MARKER RM6_COMPUTE
diff --git a/include/hakios-metal/fake_gpu.hpp b/include/hakios-metal/fake_gpu.hpp
index fbc45d4..e28e17b 100644
--- a/include/hakios-metal/fake_gpu.hpp
+++ b/include/hakios-metal/fake_gpu.hpp
@@ -50,8 +50,8 @@
 // the CCU holds, like a draw. The packing is this model's reading of the registers; whether the GPU packs the same
 // way is again the phone's to say.
 //
-// What it answers is what hakios's kernel driver answers (bsd/dev/hakios.adreno.c, hakios_gpu_parameter): GPU_ID 0,
-// the chip id 0x06030500 with a speed bin above it, 512 KiB of GMEM, 550 MHz. And it fails as that kernel fails. A
+// What it answers is what the vayu kernel's driver answers (bsd/dev/vayu_adreno.c, vayu_gpu_parameter): GPU_ID 640,
+// the chip id 0x06040001 with no speed bin above it, 1 MiB of GMEM, 499 MHz. And it fails as that kernel fails. A
 // submission the GPU never finishes is a hang there, found by the wait's timeout alone (the GPU raises no fault for
 // it, and none of the measured hangs set a fault register); then either the kernel resets the GPU and gives up what it
 // had (boot-arg gpu_recover=1: the fence word is set to the last submission's number, so every wait ends, and FAULTS
@@ -187,11 +187,10 @@ public:
     void resume();
 
     // what the kernel says about this GPU, for the fake to say the same and for a test to check it does
-    static constexpr uint64_t kChipId = 0x06030500;      // dt qcom,chipid: an A635-family part, "Adreno 7c+ Gen 3" to Mesa
-    static constexpr uint64_t kSpeedBin = 0x75;          // the phone's fuse value above the chip id, as the probe read it
-                                                         // (0x7506030500 on 28 October); Mesa's named row for this part
-    static constexpr uint64_t kGmemBytes = 512 * 1024;
-    static constexpr uint64_t kMaxFrequencyHz = 550000000;
+    static constexpr uint64_t kChipId = 0x06040001;      // vayu_adreno.c GMU_CHIP_ID: the Adreno 640 (Mesa GPUId(640))
+    static constexpr uint64_t kSpeedBin = 0;             // vayu_gpu_parameter answers the chip id alone, no fuse above it
+    static constexpr uint64_t kGmemBytes = 1024 * 1024;  // vayu_gpu_parameter GMEM_SIZE 0x100000
+    static constexpr uint64_t kMaxFrequencyHz = 499200000;   // the 499 MHz level the vayu kernel runs the core at
 
 private:
     struct UboDescriptor {
