diff --git a/src/compiler.cpp b/src/compiler.cpp
index 719d6d7..9f527ad 100644
--- a/src/compiler.cpp
+++ b/src/compiler.cpp
@@ -51,7 +51,7 @@ namespace {
 
 std::mutex gCompilerLock;   // ir3 keeps state in the compiler object; one compilation at a time
 
-// one compiler for the chip, as the kernel names it: Mesa's table resolves 0x06030500 to the Adreno 7c+ Gen 3 row
+// one compiler for the chip, as the kernel names it: Mesa's table resolves 0x06040001 to the GPUId(640) row (0x060400ff)
 ir3_compiler* theCompiler() {
     static ir3_compiler* compiler = [] {
         fd_dev_id id{};
@@ -75,6 +75,12 @@ bool refuse(std::string* why, const std::string& text) {
     return false;
 }
 
+std::string chipName() {
+    char text[16];
+    snprintf(text, sizeof text, "0x%08x", unsigned(a6xx::kChipId));
+    return text;
+}
+
 // KernelTextureDim from the NIR's sampler dimension; false, with the dimension's name, for the ones no Texture can be
 // made of yet (a buffer texture, a rectangle, a multisampled or subpass image): the dispatch would otherwise bind a 2D
 // texture to a txf_ms and read numbers neither right nor obviously wrong
@@ -1070,7 +1076,7 @@ bool hasCompiler() { return theCompiler() != nullptr; }
 std::unique_ptr<CompiledKernel> compileAir(const void* bitcode, size_t size, std::string* why, const FunctionConstants& constants) {
     std::lock_guard<std::mutex> g(gCompilerLock);
     if (theCompiler() == nullptr) {
-        refuse(why, "ir3 has no compiler for chip 0x06030500");
+        refuse(why, "ir3 has no compiler for chip " + chipName());
         return nullptr;
     }
     Translation t;
@@ -1259,7 +1265,7 @@ std::unique_ptr<CompiledStage> compileStage(const void* bitcode, size_t size, st
                                            const KnownBuffer* known) {
     std::lock_guard<std::mutex> g(gCompilerLock);
     if (theCompiler() == nullptr) {
-        refuse(why, "ir3 has no compiler for chip 0x06030500");
+        refuse(why, "ir3 has no compiler for chip " + chipName());
         return nullptr;
     }
     const std::string cached = stageCachePath(bitcode, size, constants, iboBase, known);
diff --git a/src/fake_gpu.cpp b/src/fake_gpu.cpp
index 4fb84ff..0838828 100644
--- a/src/fake_gpu.cpp
+++ b/src/fake_gpu.cpp
@@ -667,12 +667,20 @@ bool FakeGpu::execCs(const uint32_t* p, uint32_t count, bool indirect) {
         fault("SP_CS_CTRL_REG0 and HLSQ_CS_CNTL_1 disagree about the thread size");
