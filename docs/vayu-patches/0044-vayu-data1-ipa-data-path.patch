+static int say(const char *format, ...) __printflike(1, 2);
+static int
+say(const char *format, ...)
+{
+	char line[320];
+	va_list list;
+	int length;
+	va_start(list, format);
+	length = vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	for (const char *c = line; *c != 0; c++) loader_log_putc(*c);
+	printf("%s", line);
+	return length;
+}
+
+static vm_offset_t ipa_regs, ipa_debug, gsi_regs;
+static LCK_GRP_DECLARE(ipa_data_lock_group, "vayu-ipa-data");
+static LCK_MTX_DECLARE(ipa_data_lock, &ipa_data_lock_group);
+
+static inline uint32_t
+ipa_rd(uint32_t off) { return *(volatile uint32_t *)(ipa_regs + off); }
+static inline void
+ipa_wr(uint32_t off, uint32_t value)
+{
+	*(volatile uint32_t *)(ipa_regs + off) = value;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+static inline uint32_t
+debug_rd(uint32_t off) { return *(volatile uint32_t *)(ipa_debug + off); }
+static inline uint32_t
+gsi_rd(uint32_t off) { return *(volatile uint32_t *)(gsi_regs + off); }
+static inline void
+gsi_wr(uint32_t off, uint32_t value)
+{
+	*(volatile uint32_t *)(gsi_regs + off) = value;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+static inline uint64_t
+sram_rd64(vm_offset_t sram, uint32_t off) { return *(volatile uint64_t *)(sram + off); }
+
+struct dma {
+	vm_offset_t virt;
+	uint64_t phys;
+};
+
+static uint8_t ipa_pool[IPA_POOL_SIZE] __attribute__((aligned(IPA_POOL_ALIGN)));
+static uint64_t pool_phys;
+static size_t pool_used;
+
+static bool
+pool_init(void)
+{
+	pool_phys = kvtophys((vm_offset_t)ipa_pool);
+	if (pool_phys < 0x80000000ULL || pool_phys + sizeof(ipa_pool) - 1 > 0xffffffffULL ||
+	    (pool_phys & 0xfff)) {
+		say("vayu-ipa-data: pool phys %#llx is outside the IPA SMMU DDR identity window\n",
+		    (unsigned long long)pool_phys);
+		return false;
+	}
+	for (size_t at = 0; at < sizeof(ipa_pool); at += PAGE_SIZE) {
+		if (kvtophys((vm_offset_t)ipa_pool + at) != pool_phys + at) {
+			say("vayu-ipa-data: pool is not contiguous at %#zx\n", at);
+			return false;
+		}
+	}
+	pool_used = 0;                       /* a failed/stopped prepare may be retried */
+	memset(ipa_pool, 0, sizeof(ipa_pool));
+	say("vayu-ipa-data: DMA pool %#llx..%#llx, physically contiguous, IOVA=PA\n",
+	    (unsigned long long)pool_phys, (unsigned long long)(pool_phys + sizeof(ipa_pool) - 1));
+	return true;
+}
+
+static bool
+pool_take(struct dma *d, size_t size, size_t align)
+{
+	size_t at = (pool_used + align - 1) & ~(align - 1);
+
+	if (align == 0 || (align & (align - 1)) || at > sizeof(ipa_pool) || size > sizeof(ipa_pool) - at) {
+		say("vayu-ipa-data: pool exhausted: used %#zx need %#zx align %#zx\n", pool_used, size, align);
+		return false;
+	}
+	d->virt = (vm_offset_t)ipa_pool + at;
+	d->phys = pool_phys + at;
+	pool_used = at + size;
+	memset((void *)d->virt, 0, size);
+	return true;
+}
+
+static void
+dma_sync(vm_offset_t virt, size_t size)
+{
+	vm_offset_t from = virt & ~63ul;
+
+	FlushPoC_DcacheRegion(from, ((virt + size + 63) & ~63ul) - from);
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+struct tre {
+	uint64_t addr;
+	uint16_t len_opcode;
+	uint16_t reserved;
+	uint32_t flags;
+};
+struct event {
+	uint64_t xfer;
+	uint16_t len;
+	uint8_t reserved1;
+	uint8_t code;
+	uint16_t reserved2;
+	uint8_t type;
+	uint8_t chid;
+};
+static_assert(sizeof(struct tre) == 16, "GSI TRE is 16 bytes");
+static_assert(sizeof(struct event) == 16, "GSI event is 16 bytes");
+
+struct channel {
+	const char *name;
+	uint8_t id, endpoint;
+	uint32_t event_id;
+	bool to_ipa, command, qmap, aggregate, close_eof;
+	uint32_t slots, buffer_size, low_weight;
+	struct dma tre_ring, event_ring, data;
+	uint32_t next, done, events;
+	bool event_allocated, allocated, started;
+	uint64_t packets, bytes, dropped, errors;
+};
+
+static struct channel channels[] = {
+	{ .name = "cmd", .id = 4, .endpoint = 5, .event_id = ~0u, .to_ipa = true,
+	  .command = true, .slots = 16, .buffer_size = 256, .low_weight = 15 },
+	{ .name = "lan-rx", .id = 5, .endpoint = 10, .event_id = ~0u,
+	  .aggregate = true, .slots = 8, .buffer_size = 8192, .low_weight = 1 },
+	{ .name = "wan-tx", .id = 3, .endpoint = 2, .event_id = ~0u, .to_ipa = true,
+	  .qmap = true, .slots = 64, .buffer_size = 2048, .low_weight = 1 },
+	{ .name = "wan-rx", .id = 6, .endpoint = 11, .event_id = ~0u,
+	  .qmap = true, .aggregate = true, .close_eof = true, .slots = 16,
+	  .buffer_size = 16384, .low_weight = 1 },
+};
+#define NCHANNELS (sizeof(channels) / sizeof(channels[0]))
+#define COMMAND (&channels[0])
+#define LAN_RX (&channels[1])
+#define WAN_TX (&channels[2])
+#define WAN_RX (&channels[3])
+static uint32_t max_event_rings;
+static bool prepared, ready, filter_failed, stopping, thread_running;
+static uint32_t trace;
+static bool first_packet_seen;
+
+/* vayu-data: S10: the first packet either way, once. The counters in vayu_cell_net_get_status()
+ * carry the rest. */
+static void
+first_packet(const char *way, const char *channel, uint32_t bytes)
+{
+	if (first_packet_seen) return;
+	first_packet_seen = true;
+	say("vayu-data: S10 FIRST PACKET: OK %s via %s, %u bytes\n", way, channel, bytes);
+}
+
+static inline vm_offset_t
+slot_virt(const struct channel *ch, uint32_t slot)
+{
+	return ch->data.virt + (vm_offset_t)slot * ch->buffer_size;
+}
+static inline uint64_t
+slot_phys(const struct channel *ch, uint32_t slot)
+{
+	return ch->data.phys + (uint64_t)slot * ch->buffer_size;
+}
+static inline struct tre *
+tre_at(struct channel *ch, uint32_t index)
+{
+	return (struct tre *)(ch->tre_ring.virt + (index % ch->slots) * ELEMENT_SIZE);
+}
+
+static void
+gsi_error(const char *what)
+{
+	uint32_t log = gsi_rd(GSI_ERROR_LOG);
+
+	say("vayu-ipa-data: %s: GSI status %#x error %#x (code %u type %u EE %u index %u), global %#x general %#x\n",
+	    what, gsi_rd(GSI_STATUS), log, (log >> 12) & 0xf, (log >> 24) & 0xf,
+	    log >> 28, (log >> 19) & 0x1f, gsi_rd(CNTXT_GLOB_IRQ_STTS), gsi_rd(CNTXT_GSI_IRQ_STTS));
+}
+
+static uint32_t
+channel_state(const struct channel *ch, bool event)
+{
+	return (gsi_rd(event ? EV_CNTXT(ch->event_id, 0) : CH_CNTXT(ch->id, 0)) >> 20) & 0xf;
+}
+
+static bool
+gsi_command(struct channel *ch, bool event, uint32_t opcode, uint32_t wanted)
+{
+	uint32_t number = event ? ch->event_id : ch->id, state = 0;
+
+	gsi_wr(event ? GSI_EV_CMD : GSI_CH_CMD, number | opcode << 24);
+	for (unsigned us = 0; us < 250000; us += 100) {
+		state = channel_state(ch, event);
+		if (state == wanted) break;
+		delay_for_interval(100, NSEC_PER_USEC);
+	}
+	gsi_wr(event ? CNTXT_SRC_EV_IRQ_CLR : CNTXT_SRC_CH_IRQ_CLR, 1u << number);
+	if (state != wanted) {
+		say("vayu-ipa-data: %s command %#x on %s %u: state %u, expected %u\n",
+		    ch->name, opcode, event ? "event" : "channel", number, state, wanted);
+		gsi_error(ch->name);
+		return false;
+	}
+	return true;
+}
+
+static void
+gsi_interrupts_off(void)
+{
+	gsi_wr(CNTXT_INTSET, 1);               /* IRQ mode, but every source is polled/masked */
+	gsi_wr(CNTXT_MSI_LSB, 0);
+	gsi_wr(CNTXT_MSI_MSB, 0);
+	gsi_wr(GSI_ERROR_LOG, 0);
+	gsi_wr(CNTXT_TYPE_IRQ_MSK, 0);
+	gsi_wr(CNTXT_SRC_CH_IRQ_MSK, 0);
+	gsi_wr(CNTXT_SRC_EV_IRQ_MSK, 0);
+	gsi_wr(CNTXT_SRC_IEOB_IRQ_MSK, 0);
+	gsi_wr(CNTXT_GLOB_IRQ_EN, 0);
+	gsi_wr(CNTXT_GSI_IRQ_EN, 0);
+	gsi_wr(CNTXT_SRC_CH_IRQ_CLR, ~0u);
+	gsi_wr(CNTXT_SRC_EV_IRQ_CLR, ~0u);
+	gsi_wr(CNTXT_SRC_IEOB_IRQ_CLR, ~0u);
+	gsi_wr(CNTXT_GLOB_IRQ_CLR, ~0u);
+	gsi_wr(CNTXT_GSI_IRQ_CLR, ~0u);
+	gsi_wr(GSI_ERROR_LOG_CLR, ~0u);
+	gsi_wr(CNTXT_SCRATCH_0, 0);
+	gsi_wr(CNTXT_SCRATCH_1, 0);
+}
+
+static bool
+event_claim(struct channel *ch)
+{
+	for (uint32_t e = 0; e < max_event_rings; e++) {
+		bool used = false;
+		for (unsigned i = 0; i < NCHANNELS; i++) {
+			if (channels[i].event_allocated && channels[i].event_id == e) used = true;
+		}
+		if (!used && ((gsi_rd(EV_CNTXT(e, 0)) >> 20) & 0xf) == 0) {
+			ch->event_id = e;
+			return true;
+		}
+	}
+	say("vayu-ipa-data: %s: no free event ring\n", ch->name);
+	return false;
+}
+
+static bool
+endpoint_check(const struct channel *ch)
+{
+	uint32_t expected = 1u << 16 | (uint32_t)ch->id << 8, cfg = 0;
+
+	/* TZ/FW owns this binding. It may still be finishing ipa_fws startup; never
+	 * write the register, but allow a bounded 100 ms for it to appear. */
+	for (unsigned ms = 0; ms < 100; ms++) {
+		cfg = debug_rd(ENDP_GSI_CFG1(ch->endpoint));
+		if ((cfg & 0x11f0f) == expected) return true;
+		delay_for_interval(1, NSEC_PER_MSEC);
+	}
+	say("vayu-ipa-data: EP%u GSI_CFG1 %#x, expected %#x after 100 ms (TZ owns binding); refusing\n",
+	    ch->endpoint, cfg, expected);
+	return false;
+}
+
+static void
+endpoint_program(const struct channel *ch)
+{
+	uint32_t ep = ch->endpoint, value;
+
+	ipa_wr(ENDP_CTRL(ep), 0);
+	ipa_wr(ENDP_CFG(ep), 0);                    /* no checksum offload */
+	ipa_wr(ENDP_NAT(ep), 0);
+	value = 0;
+	if (ch->qmap) {
+		value = 4 | 1u << 6 | 2u << 20;
+		if (!ch->to_ipa) {
+			/* RX: metadata in header byte 1 and packet size at bytes 2..3 is valid. */
+			value |= 1u << 7 | 1u << 19;
+		}
+	}
+	/* LAN exceptions have no header at this stage: IPA_ROUTE does not retain one. */
+	ipa_wr(ENDP_HDR(ep), value);
+	value = 0;
+	if (ch->qmap) {
+		value = 1 | 1u << 1 | 1u << 3;        /* big endian, pad valid, length includes pad */
+		if (ch->to_ipa) value |= 2u << 10;    /* 4-byte alignment */
+	} else if (!ch->to_ipa) {
+		value = 1 | 1u << 1 | 2u << 10;       /* LAN header padding */
+	}
+	ipa_wr(ENDP_HDR_EXT(ep), value);
+	ipa_wr(ENDP_METADATA_MASK(ep), !ch->to_ipa && ch->qmap ? 0xff000000 : 0);
+	if (ch->to_ipa) ipa_wr(ENDP_MODE(ep), ch->command ? 3 | LAN_RX->endpoint << 4 : 0);
+	value = 0;
+	if (!ch->to_ipa && ch->aggregate) {
+		uint32_t kb = ch->qmap ? 14 : 6;       /* WDA 0x3800 = 14 KiB; stock LAN = 6 */
+		uint32_t packets = ch->qmap ? 16 : 0;
+		value = 1 | 4u << 2 | kb << 5 | 1u << 10 | packets << 15 |
+		    (ch->close_eof ? 1u << 21 : 0);  /* generic, 0.5 ms tick */
+	} else if (ch->to_ipa && ch->qmap) {
+		value = 2 | 6u << 2;                  /* deaggregate QCMAP */
+	}
+	ipa_wr(ENDP_AGGR(ep), value);
+	if (ch->to_ipa) ipa_wr(ENDP_DEAGGR(ep), 0);
+	else ipa_wr(ENDP_HOLB(ep), 0);
+	ipa_wr(ENDP_RSRC_GRP(ep), 1);              /* IPA_v4_0_GROUP_UL_DL */
+	if (ch->to_ipa) ipa_wr(ENDP_SEQ(ep), ch->command ? 0 : 0x804);
+	ipa_wr(ENDP_STATUS(ep), 0);
+}
+
+static bool
+channel_setup(struct channel *ch)
+{
+	uint32_t c = ch->id;
+
+	if (!event_claim(ch) || !endpoint_check(ch)) return false;
+	if (((gsi_rd(CH_CNTXT(c, 0)) >> 20) & 0xf) != 0) {
+		say("vayu-ipa-data: %s channel %u is already in use\n", ch->name, c);
+		return false;
+	}
+	if (!gsi_command(ch, true, GSI_ALLOCATE, 1)) return false;
+	ch->event_allocated = true;
+	uint32_t e = ch->event_id;
+	gsi_wr(EV_CNTXT(e, 0), GSI_EVT_TYPE_GPI | 1u << 16 | ELEMENT_SIZE << 24);
+	gsi_wr(EV_CNTXT(e, 1), ch->slots * ELEMENT_SIZE);
+	gsi_wr(EV_CNTXT(e, 2), (uint32_t)ch->event_ring.phys);
+	gsi_wr(EV_CNTXT(e, 3), (uint32_t)(ch->event_ring.phys >> 32));
+	for (unsigned n = 8; n <= 13; n++) gsi_wr(EV_CNTXT(e, n), 0);
+	gsi_wr(EV_DOORBELL(e) + 4, (uint32_t)(ch->event_ring.phys >> 32));
+	gsi_wr(EV_DOORBELL(e), (uint32_t)(ch->event_ring.phys + (ch->slots - 1) * ELEMENT_SIZE));
+
+	if (!gsi_command(ch, false, GSI_ALLOCATE, 1)) return false;
+	ch->allocated = true;
+	gsi_wr(CH_CNTXT(c, 0), GSI_TYPE_GPI | (ch->to_ipa ? 1u << 3 : 0) |
+	    e << 14 | ELEMENT_SIZE << 24);
+	gsi_wr(CH_CNTXT(c, 1), ch->slots * ELEMENT_SIZE);
+	gsi_wr(CH_CNTXT(c, 2), (uint32_t)ch->tre_ring.phys);
+	gsi_wr(CH_CNTXT(c, 3), (uint32_t)(ch->tre_ring.phys >> 32));
+	gsi_wr(CH_QOS(c), ch->low_weight);         /* direct mode, one prefetch, no escape-only */
+	for (unsigned n = 0; n < 4; n++) gsi_wr(CH_SCRATCH(c, n), 0); /* v4.0+: no MCS smart prefetch */
+	gsi_wr(CH_DOORBELL(c) + 4, (uint32_t)(ch->tre_ring.phys >> 32));
+	endpoint_program(ch);
+	return true;
+}
+
+static void
+tre_fill(struct channel *ch, uint32_t index, uint64_t addr, uint16_t len_opcode, uint32_t flags)
+{
+	struct tre *t = tre_at(ch, index);
+	t->addr = addr;
+	t->len_opcode = len_opcode;
+	t->reserved = 0;
+	t->flags = flags;
+	dma_sync((vm_offset_t)t, sizeof(*t));
+}
+
+static void
+channel_doorbell(struct channel *ch)
+{
+	gsi_wr(CH_DOORBELL(ch->id), (uint32_t)(ch->tre_ring.phys + (ch->next % ch->slots) * ELEMENT_SIZE));
+}
+
+static void
+receive_post(struct channel *ch)
+{
+	tre_fill(ch, ch->next, slot_phys(ch, ch->next % ch->slots),
+	    (uint16_t)ch->buffer_size, TRE_TYPE_XFER | TRE_IEOT | TRE_BEI);
+	ch->next++;
+}
+
+static bool
+channel_start(struct channel *ch)
+{
+	if (!gsi_command(ch, false, GSI_START, 2)) return false;
+	ch->started = true;
+	if (!ch->to_ipa) {
+		for (uint32_t slot = 0; slot + 1 < ch->slots; slot++) receive_post(ch);
+		channel_doorbell(ch);                 /* slots-1: write==read means empty */
+	}
+	say("vayu-ipa-data: %s started: EP%u ch%u event %u, %u slots, buffers %u bytes\n",
+	    ch->name, ch->endpoint, ch->id, ch->event_id, ch->slots, ch->buffer_size);
+	return true;
+}
+
+static unsigned
+channel_events(struct channel *ch, void (*each)(struct channel *, const struct event *, void *), void *context)
+{
+	uint32_t base = (uint32_t)ch->event_ring.phys, wp = gsi_rd(EV_CNTXT(ch->event_id, 4));
+	unsigned count = 0;
+
+	if (wp < base || wp >= base + ch->slots * ELEMENT_SIZE || ((wp - base) & 0xf)) {
+		if (ch->errors++ < 4) say("vayu-ipa-data: %s event WP %#x outside ring %#x\n", ch->name, wp, base);
+		return 0;
+	}
+	uint32_t target = (wp - base) / ELEMENT_SIZE;
+	while (ch->events % ch->slots != target) {
+		struct event *e = (struct event *)(ch->event_ring.virt + (ch->events % ch->slots) * ELEMENT_SIZE);
+		dma_sync((vm_offset_t)e, sizeof(*e));
+		each(ch, e, context);
+		ch->events++;
+		count++;
+		/* vayu_qup_spi and vendor gsi.c: after advancing the software index,
+	 * the doorbell points at that next position in the event ring. */
+		gsi_wr(EV_DOORBELL(ch->event_id), (uint32_t)(ch->event_ring.phys + (ch->events % ch->slots) * ELEMENT_SIZE));
+	}
+	return count;
+}
+
+static bool
+event_slot(const struct channel *ch, const struct event *e, uint32_t *slot)
+{
+	if (e->xfer < ch->tre_ring.phys || e->xfer >= ch->tre_ring.phys + ch->slots * ELEMENT_SIZE ||
+	    ((e->xfer - ch->tre_ring.phys) & 0xf)) return false;
+	*slot = (uint32_t)((e->xfer - ch->tre_ring.phys) / ELEMENT_SIZE);
+	return true;
+}
+
+static bool
+event_ok(const struct event *e)
+{
+	return e->code == GSI_EVT_SUCCESS || e->code == GSI_EVT_EOT || e->code == GSI_EVT_EOB;
+}
+
+struct command_done {
+	uint64_t tre;
+	bool done;
+	uint8_t code;
+};
+static void
+command_event(struct channel *ch, const struct event *e, void *context)
+{
+	struct command_done *waiting = context;
+	if (e->xfer == waiting->tre) {
+		waiting->done = true;
+		waiting->code = e->code;
+	}
+	ch->done++;
+}
+
+static bool
+ipa_command(const char *what, uint8_t opcode, const void *payload, size_t size)
+{
+	struct channel *ch = COMMAND;
+	uint32_t slot = ch->next % ch->slots;
+	struct command_done waiting = { .tre = ch->tre_ring.phys + slot * ELEMENT_SIZE };
+
+	if (size > ch->buffer_size || ch->next - ch->done >= ch->slots - 1) return false;
+	memcpy((void *)slot_virt(ch, slot), payload, size);
+	dma_sync(slot_virt(ch, slot), size);
+	tre_fill(ch, ch->next, slot_phys(ch, slot), opcode, TRE_TYPE_COMMAND | TRE_IEOT);
+	ch->next++;
+	channel_doorbell(ch);
+	for (unsigned us = 0; us < 250000 && !waiting.done; us += 100) {
+		channel_events(ch, command_event, &waiting);
+		if (!waiting.done) delay_for_interval(100, NSEC_PER_USEC);
+	}
+	if (!waiting.done || !event_ok(&(struct event){ .code = waiting.code })) {
+		say("vayu-ipa-data: immediate command %s (%#x) failed: done %u code %#x state %u\n",
+		    what, opcode, waiting.done, waiting.code, channel_state(ch, false));
+		gsi_error(what);
+		ch->errors++;
+		return false;
+	}
+	say("vayu-ipa-data: immediate command %s completed (code %u)\n", what, waiting.code);
+	return true;
+}
+
+static struct dma zero_rule, route_image, filter_image, header_image, proc_image;
+
+static bool
+table_images(void)
+{
+	uint64_t *route, *filter;
+	uint32_t restricted = vayu_ipa_restricted_bytes();
+
+	if (!pool_take(&zero_rule, 8, 128) || !pool_take(&route_image, 15 * 8, 128) ||
+	    !pool_take(&filter_image, 9 * 8, 128) || !pool_take(&header_image, 0x140, 128) ||
+	    !pool_take(&proc_image, 0x400, 128)) return false;
+	route = (uint64_t *)route_image.virt;
+	filter = (uint64_t *)filter_image.virt;
+	for (unsigned i = 0; i < 15; i++) route[i] = zero_rule.phys;
+	filter[0] = 0x3cfULL << 1;                /* vayu EP 0,1,2,3,6,7,8,9: eight filters */
+	for (unsigned i = 1; i <= 8; i++) filter[i] = zero_rule.phys;
+	for (unsigned i = 0; i < 5; i++) {
+		struct dma *images[] = { &zero_rule, &route_image, &filter_image, &header_image, &proc_image };
+		dma_sync(images[i]->virt, i == 0 ? 8 : i == 1 ? 15 * 8 : i == 2 ? 9 * 8 : i == 3 ? 0x140 : 0x400);
+	}
+	say("vayu-ipa-data: table images: zero rule %#llx, filter bitmap %#llx, restricted %#x\n",
+	    (unsigned long long)zero_rule.phys, (unsigned long long)filter[0], restricted);
+	return true;
+}
+
+static bool
+table_init(const char *what, uint8_t opcode, bool filter, uint32_t hash_off, uint32_t nhash_off)
+{
+	struct { uint64_t hash, flags, nhash; } payload;
+	struct dma *image = filter ? &filter_image : &route_image;
+	uint32_t size = filter ? 9 * 8 : 15 * 8;
+	uint32_t o = vayu_ipa_restricted_bytes();
+
+	payload.hash = image->phys;
+	payload.nhash = image->phys;
+	payload.flags = (uint64_t)size | (uint64_t)(o + hash_off) << 12 |
+	    (uint64_t)size << 28 | (uint64_t)(o + nhash_off) << 40;
+	return ipa_command(what, opcode, &payload, sizeof(payload));
+}
+
+static bool
+tables_setup(void)
+{
+	uint32_t o = vayu_ipa_restricted_bytes();
+	struct { uint64_t source, flags; } header = {
+		.source = header_image.phys,
+		.flags = 0x140 | (uint64_t)(o + 0x688) << 12,
+	};
+	struct { uint64_t flags, source; } proc = {
+		.flags = (uint64_t)0x400 << 16 | (uint64_t)(o + 0x7d0) << 32,
+		.source = proc_image.phys,
+	};
+
+	if (!ipa_command("header table init", IPA_CMD_HDR_LOCAL, &header, sizeof(header)) ||
+	    !ipa_command("header processing contexts", IPA_CMD_DMA_SHARED, &proc, sizeof(proc)) ||
+	    !table_init("IPv4 route table init", IPA_CMD_V4_ROUTE, false, 0x488, 0x508) ||
+	    !table_init("IPv6 route table init", IPA_CMD_V6_ROUTE, false, 0x588, 0x608) ||
+	    !table_init("IPv4 filter table init", IPA_CMD_V4_FILTER, true, 0x288, 0x308) ||
+	    !table_init("IPv6 filter table init", IPA_CMD_V6_FILTER, true, 0x388, 0x408)) return false;
+	ipa_wr(IPA_LOCAL_PROC_BASE, o + 0x7d0);
+	ipa_wr(IPA_HASH_FLUSH, 0x1111);
+	return true;
+}
+
+static bool
+tables_verify(void)
+{
+	/* The readback window must be the same SRAM the immediate commands targeted:
+	 * vayu_ipa_sram=1 moves it to 0x1e47000 (+restricted) for IPA 4.1. */
+	uint32_t base = vayu_ipa_sram_base();
+	vm_offset_t sram = ml_io_map_unmappable(base, IPA_SRAM_SIZE, VM_WIMG_IO);
+	uint32_t o = vayu_ipa_restricted_bytes();
+	bool ok = sram != 0;
+
+	if (!ok) {
+		say("vayu-ipa-data: SRAM readback window %#x did not map\n", base);
+		return false;
+	}
+#define EXPECT64(off, value) do { \
+	uint64_t got = sram_rd64(sram, (off)); \
+	if (got != (uint64_t)(value)) { \
+		say("vayu-ipa-data: SRAM %#x = %#llx, expected %#llx\n", (off), \
+		    (unsigned long long)got, (unsigned long long)(uint64_t)(value)); \
+		ok = false; \
+	} \
+} while (0)
+	EXPECT64(o + 0x488, zero_rule.phys);
+	EXPECT64(o + 0x508, zero_rule.phys);
+	EXPECT64(o + 0x288, 0x3cfULL << 1);
+	EXPECT64(o + 0x290, zero_rule.phys);
+	EXPECT64(o + 0x308, 0x3cfULL << 1);
+	EXPECT64(o + 0x310, zero_rule.phys);
+	EXPECT64(o + 0x688, 0);
+	EXPECT64(o + 0x7d0, 0);
+#undef EXPECT64
+	if (ok) say("vayu-ipa-data: SRAM route/filter/header/proc table readback PASSED\n");
+	return ok;
+}
+
+static void
+transmit_event(struct channel *ch, const struct event *e, void *context __unused)
+{
+	uint32_t slot;
+	if (!event_slot(ch, e, &slot)) {
+		ch->errors++;
+		return;
+	}
+	if (slot != ch->done % ch->slots || !event_ok(e)) ch->errors++;
+	ch->done++;
+}
+
+static void
+receive_event(struct channel *ch, const struct event *e, void *context __unused)
+{
+	uint32_t slot;
+	if (!event_slot(ch, e, &slot)) {
+		ch->errors++;
+		ch->done++;                            /* one bad event must not pin the ring forever */
+		return;
+	}
+	if (slot != ch->done % ch->slots || !event_ok(e)) ch->errors++;
+	ch->done++;
+	uint32_t length = e->len > ch->buffer_size ? ch->buffer_size : e->len;
+	const uint8_t *buffer = (const uint8_t *)slot_virt(ch, slot);
+	dma_sync((vm_offset_t)buffer, length);
+	ch->bytes += length;
+	if (trace) say("vayu-ipa-data: %s slot %u: %u bytes code %u\n", ch->name, slot, length, e->code);
+	if (ch->qmap) {
+		const uint8_t *cursor = buffer;
+		size_t remaining = length;
+		while (remaining) {
+			struct vayu_qmap_header header;
+			const uint8_t *packet;
+			size_t packet_length;
+			if (!vayu_qmap_next(&cursor, &remaining, &header, &packet, &packet_length)) {
+				ch->dropped++;
+				break;
+			}
+			if (header.command || header.next_header) {
+				ch->dropped++;
+				continue;
+			}
+			ch->packets++;
+			first_packet("received", ch->name, (uint32_t)packet_length);
+			/* ifnet_input may generate an ICMP/TCP reply and re-enter transmit. Do not
+			 * hold the IPA lock across it; only this thread consumes this RX channel. */
+			lck_mtx_unlock(&ipa_data_lock);
+			vayu_cell_net_input(header.mux_id, packet, packet_length);
+			lck_mtx_lock(&ipa_data_lock);
+		}
+	} else {
+		ch->packets++;                            /* LAN exceptions are deliberately dropped. */
+	}
+	receive_post(ch);
+	channel_doorbell(ch);
+}
+
+bool
+vayu_ipa_data_transmit(uint8_t mux, const void *packet, size_t length)
+{
+	struct channel *ch = WAN_TX;
+	struct vayu_qmap_header header = { .mux_id = mux };
+	uint32_t slot, pad;
+	uint8_t *buffer;
+	bool accepted = false;
+
+	if (!ready || packet == NULL || length == 0 || length > 1500) return false;
+	pad = (4 - (length & 3)) & 3;
+	header.pad_len = (uint8_t)pad;
+	header.length = (uint16_t)(length + pad);
+	if (length + pad + VAYU_QMAP_HEADER_LEN > ch->buffer_size) return false;
+	lck_mtx_lock(&ipa_data_lock);
+	channel_events(ch, transmit_event, NULL);
+	if (!ready || ch->next - ch->done >= ch->slots - 1) {
+		ch->dropped++;
+		goto out;
+	}
+	slot = ch->next % ch->slots;
+	buffer = (uint8_t *)slot_virt(ch, slot);
+	if (!vayu_qmap_header_encode(buffer, &header)) goto out;
+	memcpy(buffer + VAYU_QMAP_HEADER_LEN, packet, length);
+	memset(buffer + VAYU_QMAP_HEADER_LEN + length, 0, pad);
+	dma_sync((vm_offset_t)buffer, VAYU_QMAP_HEADER_LEN + length + pad);
+	tre_fill(ch, ch->next, slot_phys(ch, slot), (uint16_t)(VAYU_QMAP_HEADER_LEN + length + pad),
+	    TRE_TYPE_XFER | TRE_IEOT | TRE_BEI);
+	ch->next++;
+	channel_doorbell(ch);
+	ch->packets++;
+	ch->bytes += length;
+	first_packet("sent", ch->name, (uint32_t)length);
+	accepted = true;
+out:
+	lck_mtx_unlock(&ipa_data_lock);
+	return accepted;
+}
+
+static void
+ipa_data_thread(void *argument __unused, wait_result_t wait __unused)
+{
+	while (!stopping) {
+		if (ready) {
+			lck_mtx_lock(&ipa_data_lock);
+			channel_events(WAN_RX, receive_event, NULL);
+			channel_events(LAN_RX, receive_event, NULL);
+			channel_events(WAN_TX, transmit_event, NULL);
+			lck_mtx_unlock(&ipa_data_lock);
+		}
+		delay_for_interval(2, NSEC_PER_MSEC);
+	}
+	thread_running = false;
+	thread_terminate(current_thread());
+}
+
+static bool
+channel_memory(void)
+{
+	for (unsigned i = 0; i < NCHANNELS; i++) {
+		struct channel *ch = &channels[i];
+		ch->next = ch->done = ch->events = 0;
+		ch->event_allocated = ch->allocated = ch->started = false;
+		ch->packets = ch->bytes = ch->dropped = ch->errors = 0;
+		if (!pool_take(&ch->tre_ring, ch->slots * ELEMENT_SIZE, ch->slots * ELEMENT_SIZE) ||
+		    !pool_take(&ch->event_ring, ch->slots * ELEMENT_SIZE, ch->slots * ELEMENT_SIZE) ||
+		    !pool_take(&ch->data, ch->slots * ch->buffer_size, PAGE_SIZE)) return false;
+	}
+	return true;
+}
+
+static bool
+registers_map_and_check(void)
+{
+	ipa_regs = ml_io_map_unmappable(IPA_PHYS, IPA_SIZE, VM_WIMG_IO);
+	ipa_debug = ml_io_map_unmappable(IPA_DEBUG_PHYS, IPA_DEBUG_SIZE, VM_WIMG_IO);
+	gsi_regs = ml_io_map_unmappable(GSI_PHYS, GSI_SIZE, VM_WIMG_IO);
+	if (!ipa_regs || !ipa_debug || !gsi_regs) {
+		say("vayu-ipa-data: cannot map IPA/debug/GSI windows\n");
+		return false;
+	}
+	uint32_t status = gsi_rd(GSI_STATUS), version = gsi_rd(GSI_SW_VERSION), params = gsi_rd(GSI_HW_PARAM_2);
+	uint32_t channels_hw = (params >> 3) & 0x1f;
+	max_event_rings = (params >> 8) & 0x1f;
+	uint32_t pipes = ipa_rd(IPA_ENABLED_PIPES);
+	say("vayu-ipa-data: GSI status %#x version %#x params %#x: %u channels %u events; IPA pipes %#x\n",
+	    status, version, params, channels_hw, max_event_rings, pipes);
+	if (!(status & 1) || version == 0 || version == ~0u || channels_hw <= 6 ||
+	    max_event_rings < NCHANNELS || (pipes & ((1u << 2) | (1u << 5) | (1u << 10) | (1u << 11))) !=
+	    ((1u << 2) | (1u << 5) | (1u << 10) | (1u << 11))) {
+		say("vayu-ipa-data: GSI 2.0 preflight failed; no channel writes\n");
+		return false;
+	}
+	return true;
+}
+
+static bool
+channels_down(void)
+{
+	bool ok = true;
+
+	for (unsigned i = NCHANNELS; i-- > 0;) {
+		struct channel *ch = &channels[i];
+		if (ch->started) {
+			if (!gsi_command(ch, false, GSI_STOP, 3)) {
+				say("vayu-ipa-data: %s would not stop; leaving its SMMU/context allocated\n", ch->name);
+				ok = false;
+				continue;
+			}
+			ch->started = false;
+		}
+		if (ch->allocated) {
+			if (gsi_command(ch, false, GSI_RESET, 1)) gsi_command(ch, false, GSI_DEALLOCATE, 0);
+			ch->allocated = false;
+		}
+		if (ch->event_allocated) {
+			if (gsi_command(ch, true, GSI_RESET, 1)) gsi_command(ch, true, GSI_DEALLOCATE, 0);
+			ch->event_allocated = false;
+		}
+	}
+	return ok;
+}
+
+bool
+vayu_ipa_data_prepare(void)
+{
+	uint32_t enabled = 0;
+
+	if (prepared) return ready;
+	if (!PE_parse_boot_argn("vayu_ipa_data", &enabled, sizeof(enabled)) || enabled == 0) return true;
+	if (enabled != 1) {
+		say("vayu-ipa-data: vayu_ipa_data=%u refused: only 1 enables GSI\n", enabled);
+		return false;
+	}
+	PE_parse_boot_argn("vayu_ipa_data_trace", &trace, sizeof(trace));
+	stopping = false;
+	filter_failed = false;
+	ready = false;
+	/* Empty-table initialization covers modem-owned areas too. It is legal only
+	 * before MPSS; never rewrite them after the modem accepted INIT_MODEM_DRIVER. */
+	if (vayu_ipa_modem_started()) {
+		say("vayu-ipa-data: MPSS already started; refusing to rewrite modem-owned tables\n");
+		return false;
+	}
+	/* Small table images first: allocating the large packet buffers first would
+	 * waste the last pool bytes on PAGE_SIZE alignment before the zero rule. */
+	if (!registers_map_and_check() || !pool_init() || !table_images() || !channel_memory()) return false;
+	/* The whole pool was zeroed through the cacheable CPU mapping. Push those dirty
+	 * zero lines out before any doorbell: a later dc civac on a device-written event
+	 * or RX buffer must never write stale zeros over the hardware's fresh data. */
+	dma_sync((vm_offset_t)ipa_pool, sizeof(ipa_pool));
+	gsi_interrupts_off();
+	for (unsigned i = 0; i < NCHANNELS; i++) {
+		if (!channel_setup(&channels[i])) {
+			(void)channels_down();
+			return false;
+		}
+	}
+	for (unsigned i = 0; i < NCHANNELS; i++) {
+		if (!channel_start(&channels[i])) {
+			(void)channels_down();
+			return false;
+		}
+	}
+	if (!tables_setup() || !tables_verify()) {
+		say("vayu-ipa-data: tables are not initialized; stopping channels, no data_ready\n");
+		(void)channels_down();
+		return false;
+	}
+	thread_t thread;
+	thread_running = true;                    /* readiness cannot race the new thread */
+	if (kernel_thread_start(ipa_data_thread, NULL, &thread) != KERN_SUCCESS) {
+		thread_running = false;
+		say("vayu-ipa-data: no polling thread\n");
+		(void)channels_down();
+		return false;
+	}
+	thread_deallocate(thread);
+	prepared = true;
+	ready = true;
+	say("vayu-ipa-data: GSI/tables READY; runtime modem filter rules still fail closed; no internet claim\n");
+	say("vayu-data: S2 GSI CHANNELS: OK 4 channels (cmd ch4/EP5, lan-rx ch5/EP10, wan-tx ch3/EP2, "
+	    "wan-rx ch6/EP11), event rings, tables read back\n");
+	return true;
+}
+
+bool
+vayu_ipa_data_ready(void)
+{
+	return prepared && ready && thread_running && !filter_failed && !stopping;
+}
+
+void
+vayu_ipa_data_filter_error(void)
+{
+	if (!filter_failed) say("vayu-ipa-data: modem requested unimplemented filter installation; WDS/data blocked\n");
+	filter_failed = true;
+	ready = false;
+}
+
+bool
+vayu_ipa_data_stop(void)
+{
+	bool ok;
+
+	if (!prepared && !thread_running) return true;
+	stopping = true;
+	ready = false;
+	for (unsigned ms = 0; ms < 2000 && thread_running; ms += 10) delay_for_interval(10, NSEC_PER_MSEC);
+	if (thread_running) {
+		say("vayu-ipa-data: polling thread did not stop; IPA firmware must stay up\n");
+		return false;
+	}
+	ok = channels_down();
+	prepared = !ok;
+	say("vayu-ipa-data: %s\n", ok ? "stopped" : "channel stop failed; IPA firmware must stay up");
+	return ok;
+}
--- a/bsd/dev/vayu_cell_net.c
+++ b/bsd/dev/vayu_cell_net.c
@@ -0,0 +1,871 @@
+/*
+ * en1: the modem's raw IPv4 data path as a real interface, for the POCO X3 Pro (vayu, SM8150-AC).
+ *
+ * The control plane (bsd/dev/vayu_cell_data.c) leaves an IPv4 session behind: WDS says the
+ * address, mask, gateway, DNS and MTU, and WDA says the packets are raw IP inside QMAP on mux 1.
+ * This file is the smallest interface that can carry that: no Ethernet header, no ARP, no DHCP,
+ * no link-layer address, no CommCenter and no configd. en1 is IFNET_FAMILY_CELLULAR/IFT_CELLULAR,
+ * a point-to-point link whose peer is the WDS gateway, BPF sees DLT_RAW, and inbound packets are
+ * handed to PF_INET with proto_input() after the QMAP layer has removed its 4-byte header
+ * (sys/vayu_cell_qmap.h). en0 and en2 are not touched.
+ *
+ * The shape of the address setup is the proven one of bsd/dev/vayu_usbnet_ecm.c (itself the
+ * ifconfig path): SIOCPROTOATTACH for PF_INET through the plumber this file registers, then
+ * SIOCAIFADDR with the address, the netmask, and -- because the link is point-to-point -- the
+ * gateway in ifra_broadaddr, then SIOCGIFFLAGS/SIOCSIFFLAGS with IFF_UP. IFF_RUNNING is added
+ * afterwards, directly and only after the address and peer were installed, so no KEV_DL_LINK_ON
+ * is ever posted. bsd/net/if_gif.c is the model for the raw, headerless interface: ifnet_demux
+ * reads the IP version nibble, ifnet_attach_protocol registers an input that only calls
+ * proto_input(), and BPF is attached with DLT_RAW. Unlike gif there is no encapsulation and no
+ * ifra_dstaddr configuration here.
+ *
+ * What this file does NOT do, and does not pretend to: it does not make the IPA data path work
+ * (vayu_ipa_data_transmit() is the main agent's side), it does not tell configd or CommCenter that
+ * there is a network service, it does not publish DNS, and it adds no default route unless
+ * vayu_cell_net_default=1. IFF_RUNNING means "the address and peer were installed", not "the
+ * Internet works". No KEV_DL_LINK_ON/OFF is posted, so no DHCP client is told that a link came up.
+ *
+ * Boot args:
+ *   vayu_cell_net=0          nothing (the default)
+ *   vayu_cell_net=1          attach en1 and start the configuration thread
+ *   vayu_cell_net_default=1  also add a global default route via the session's gateway
+ *
+ * Threading: vayu_cell_net_session() only copies its arguments under a mutex and wakes the thread;
+ * vayu_cell_net_input() and the output callback never sleep, never open a socket and never log.
+ * All socket/ioctl/route work happens in the one thread this file starts. Teardown only removes
+ * the route and the address it added and clears the flags; the ifnet stays attached, so a later
+ * session can reuse it, and every teardown step is tolerant of being already done.
+ */
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <net/bpf.h>
+#include <net/if.h>
+#include <net/if_types.h>
+#include <net/kpi_interface.h>
+#include <net/kpi_protocol.h>
+#include <net/route.h>
+#include <netinet/in.h>
+#include <pexpert/pexpert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <sys/errno.h>
+#include <sys/kpi_mbuf.h>
+#include <sys/kpi_socket.h>
+#include <sys/param.h>
+#include <sys/sockio.h>
+#include <sys/systm.h>
+#include <sys/vayu_cell_net.h>
+
+extern void loader_log_putc(char c);
+/* The main agent's IPA transmit; it must copy the bytes before returning (the mbuf is freed below). */
+extern bool vayu_ipa_data_transmit(uint8_t mux, const void *packet, size_t length);
+/* bsd/net/route.c; net/route.h keeps the flags but not the prototype. */
+extern int rtrequest(int req, struct sockaddr *dst, struct sockaddr *gateway,
+    struct sockaddr *netmask, int flags, struct rtentry **ret_nrt);
+
+#define CELL_NET_NAME           "en1"
+#define CELL_NET_PREFIX         "en"
+#define CELL_NET_UNIT           1
+#define CELL_NET_UNIQUEID       "vayu-cell-net"
+#define CELL_NET_IPV4_MIN       20      /* the smallest IPv4 header */
+
+static int say(const char *format, ...) __printflike(1, 2);
+
+static int
+say(const char *format, ...)
+{
+	char line[300];
+	va_list list;
+	int length;
+
+	va_start(list, format);
+	length = vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	for (const char *c = line; *c != 0; c++) {
+		loader_log_putc(*c);
+	}
+	printf("%s", line);
+	return length;
+}
+
+/* Same index line shape as vayu_cell_data.c: vayu-data: S9 EN1 IFNET: OK|ERROR ... */
+static void
+cell_net_stage(const char *result, const char *format, ...)
+{
+	char detail[180], line[260];
+	va_list list;
+
+	va_start(list, format);
+	vsnprintf(detail, sizeof(detail), format, list);
+	va_end(list);
+	snprintf(line, sizeof(line), "vayu-data: S9 EN1 IFNET: %s %s\n", result, detail);
+	for (const char *c = line; *c != 0; c++) loader_log_putc(*c);
+	printf("%s", line);
+}
+
+/* The WDS numbers are host order; the log shows them the way ip4_string does in vayu_cell_data.c. */
+static void
+ip4_string(char *to, size_t size, uint32_t address)
+{
+	snprintf(to, size, "%u.%u.%u.%u", (address >> 24) & 0xff, (address >> 16) & 0xff,
+	    (address >> 8) & 0xff, address & 0xff);
+}
+
+/* ---- state --------------------------------------------------------------------------------------- */
+
+struct cell_net_request {
+	bool     up;
+	uint32_t address;
+	uint32_t mask;
+	uint32_t gateway;
+	uint32_t dns1;
+	uint32_t dns2;
+	uint32_t mtu;
+	uint32_t generation;
+};
+
+/* What the interface currently has; owned by the configuration thread, copied under the lock. */
+struct cell_net_applied {
+	bool     address_set;
+	bool     route_set;
+	bool     fully_configured;
+	uint32_t address;
+	uint32_t mask;
+	uint32_t gateway;
+	uint32_t dns1;
+	uint32_t dns2;
+	uint32_t mtu;
+};
+
+static struct {
+	ifnet_t ifp;
+	bool    started;
+	bool    thread_started;
+	bool    default_route;
+	struct cell_net_request request;
+	bool     pending;
+	uint32_t request_generation;    /* the last request copied into `request` */
+	struct cell_net_applied applied;
+	uint32_t applied_generation;
+	/* statistics; approximate by nature, the data path does not take the lock */
+	volatile uint64_t rx_packets, rx_bytes, rx_dropped;
+	volatile uint64_t tx_packets, tx_bytes, tx_dropped;
+} cell_net;
+
+static LCK_GRP_DECLARE(cell_net_lock_group, "vayu-cell-net");
+static LCK_MTX_DECLARE(cell_net_lock, &cell_net_lock_group);
+
+/* ---- helpers ------------------------------------------------------------------------------------- */
+
+static bool
+cell_net_mask_valid(uint32_t mask)
+{
+	uint32_t host;
+
+	if (mask == 0) {
+		return false;
+	}
+	host = ~mask;
+	return (host & (host + 1)) == 0;        /* the host part is 2^k - 1 */
+}
+
+/*
+ * A complete IPv4 datagram: version 4, a header that fits, a total length that is at least the
+ * header and no larger than what was handed over. `length` comes back as the datagram's own total
+ * length; the module trims trailing bytes (padding that survived a QMAP layer) rather than passing
+ * them to IP.
+ */
+static bool
+cell_net_ipv4_valid(const uint8_t *packet, size_t available, size_t *length)
+{
+	size_t header_length, total_length;
+
+	if (packet == NULL || available < CELL_NET_IPV4_MIN || (packet[0] >> 4) != 4) {
+		return false;
+	}
+	header_length = (size_t)(packet[0] & 0x0f) * 4;
+	if (header_length < CELL_NET_IPV4_MIN || header_length > available) {
+		return false;
+	}
+	total_length = ((size_t)packet[2] << 8) | packet[3];
+	if (total_length < header_length || total_length > available) {
+		return false;
+	}
+	if (length != NULL) {
+		*length = total_length;
+	}
+	return true;
+}
+
+static bool
+cell_net_open_socket(socket_t *so)
+{
+	errno_t error;
+
+	if (*so != NULL) {
+		return true;
+	}
+	error = sock_socket(PF_INET, SOCK_DGRAM, 0, NULL, NULL, so);
+	if (error != 0) {
+		*so = NULL;
+		say("vayu-cell-net: no PF_INET socket: %d\n", error);
+		return false;
+	}
+	return true;
+}
+
+/*
+ * The usbnet pattern's last step: SIOCGIFFLAGS/SIOCSIFFLAGS with IFF_UP. This is what lets the
+ * rest of the stack see an administratively up interface; IFF_RUNNING is not part of it and is
+ * added separately, only when the address and peer were really installed.
+ */
+static int
+cell_net_set_up(socket_t so)
+{
+	struct ifreq ifr;
+	int error;
+
+	bzero(&ifr, sizeof(ifr));
+	strlcpy(ifr.ifr_name, CELL_NET_NAME, sizeof(ifr.ifr_name));
+	error = sock_ioctl(so, SIOCGIFFLAGS, &ifr);
+	if (error == 0) {
+		ifr.ifr_flags |= IFF_UP;
+		error = sock_ioctl(so, SIOCSIFFLAGS, &ifr);
+	}
+	return error;
+}
+
+/* ---- the address, route and flags (only ever called from cell_net_thread) ------------------------ */
+
+/*
+ * struct in_aliasreq as bsd/netinet/in.c casts the SIOCAIFADDR argument: three sockaddr_in after
+ * the name, the second one being the point-to-point destination (ifra_broadaddr in if.h).
+ */
+struct cell_net_aliasreq {
+	char ifra_name[IFNAMSIZ];
+	struct sockaddr_in ifra_addr;
+	struct sockaddr_in ifra_broadaddr;
+	struct sockaddr_in ifra_mask;
+};
+
+static int
+cell_net_address_set(socket_t so, const struct cell_net_request *request)
+{
+	struct cell_net_aliasreq ifra;
+	struct sockaddr_in *sin;
+	bool numbered = request->gateway == 0;
+	int error;
+
+	bzero(&ifra, sizeof(ifra));
+	strlcpy(ifra.ifra_name, CELL_NET_NAME, sizeof(ifra.ifra_name));
+	sin = &ifra.ifra_addr;
+	sin->sin_len = sizeof(*sin);
+	sin->sin_family = AF_INET;
+	sin->sin_addr.s_addr = htonl(request->address);
+	sin = &ifra.ifra_broadaddr;
+	sin->sin_len = sizeof(*sin);
+	sin->sin_family = AF_INET;
+	sin->sin_addr.s_addr = htonl(request->gateway);
+	sin = &ifra.ifra_mask;
+	sin->sin_len = sizeof(*sin);
+	sin->sin_family = AF_INET;
+	sin->sin_addr.s_addr = htonl(request->mask);
+
+	/*
+	 * in_control() refuses a point-to-point SIOCAIFADDR with a zero destination (EDESTADDRREQ,
+	 * bsd/netinet/in.c). With no gateway there is no peer to name, but the requirement is to
+	 * keep a valid address: make this one call as a numbered link address, then put the
+	 * interface back to point-to-point. The state stays "not fully configured", no peer route
+	 * is made and no default route is added; the log says why.
+	 */
+	if (numbered) {
+		ifnet_set_flags(cell_net.ifp, 0, IFF_POINTOPOINT);
+	}
+	error = sock_ioctl(so, SIOCAIFADDR, &ifra);
+	if (numbered) {
+		ifnet_set_flags(cell_net.ifp, IFF_POINTOPOINT, IFF_POINTOPOINT);
+	}
+	return error;
+}
+
+static bool
+cell_net_route_add(uint32_t gateway)
+{
+	struct sockaddr_in dst = { .sin_len = sizeof(dst), .sin_family = AF_INET };
+	struct sockaddr_in mask = { .sin_len = sizeof(mask), .sin_family = AF_INET };
+	struct sockaddr_in peer = { .sin_len = sizeof(peer), .sin_family = AF_INET };
+	char gateway_text[16];
+	int error;
+
+	ip4_string(gateway_text, sizeof(gateway_text), gateway);
+	peer.sin_addr.s_addr = htonl(gateway);
+	error = rtrequest(RTM_ADD, (struct sockaddr *)&dst, (struct sockaddr *)&peer,
+	    (struct sockaddr *)&mask, RTF_UP | RTF_GATEWAY | RTF_STATIC, NULL);
+	if (error != 0) {
+		say("vayu-cell-net: default route via %s was not added: %d\n", gateway_text, error);
+		return false;
+	}
+	say("vayu-cell-net: default route via %s added (vayu_cell_net_default=1)\n", gateway_text);
+	return true;
+}
+
+static void
+cell_net_route_delete(uint32_t gateway)
+{
+	struct sockaddr_in dst = { .sin_len = sizeof(dst), .sin_family = AF_INET };
+	struct sockaddr_in mask = { .sin_len = sizeof(mask), .sin_family = AF_INET };
+	struct sockaddr_in peer = { .sin_len = sizeof(peer), .sin_family = AF_INET };
+	char gateway_text[16];
+	int error;
+
+	ip4_string(gateway_text, sizeof(gateway_text), gateway);
+	peer.sin_addr.s_addr = htonl(gateway);
+	error = rtrequest(RTM_DELETE, (struct sockaddr *)&dst, (struct sockaddr *)&peer,
+	    (struct sockaddr *)&mask, RTF_UP | RTF_GATEWAY | RTF_STATIC, NULL);
+	if (error != 0) {
+		say("vayu-cell-net: default route via %s delete: %d (already gone)\n", gateway_text, error);
+	} else {
+		say("vayu-cell-net: default route via %s removed\n", gateway_text);
+	}
+}
+
+/*
+ * Remove only what this module installed: the default route it added, the address it set, and
+ * the interface flags. Not the ifnet: en1 stays attached for the next session. Idempotent; the
+ * address is named exactly, so en0 and en2 cannot be touched.
+ */
+static void
+cell_net_teardown(struct cell_net_applied *applied, socket_t *so)
+{
+	bool had_address = applied->address_set;
+	bool had_route = applied->route_set;
+
+	if ((had_address || had_route) && cell_net_open_socket(so)) {
+		if (had_route) {
+			cell_net_route_delete(applied->gateway);
+		}
+		if (had_address) {
+			struct ifreq ifr;
+			struct sockaddr_in *sin;
+			char address[16];
+			int error;
+
+			bzero(&ifr, sizeof(ifr));
+			strlcpy(ifr.ifr_name, CELL_NET_NAME, sizeof(ifr.ifr_name));
+			sin = (struct sockaddr_in *)&ifr.ifr_addr;
+			sin->sin_len = sizeof(*sin);
+			sin->sin_family = AF_INET;
+			sin->sin_addr.s_addr = htonl(applied->address);
+			error = sock_ioctl(*so, SIOCDIFADDR, &ifr);
+			ip4_string(address, sizeof(address), applied->address);
+			if (error != 0 && error != EADDRNOTAVAIL) {
+				say("vayu-cell-net: address %s remove: %d\n", address, error);
+			} else {
+				say("vayu-cell-net: address %s removed\n", address);
+			}
+		}
+	} else if (had_address || had_route) {
+		say("vayu-cell-net: no socket to remove the address or route; flags dropped\n");
+	}
+
+	bzero(applied, sizeof(*applied));
+	if (cell_net.ifp != NULL) {
+		ifnet_set_flags(cell_net.ifp, 0, IFF_UP | IFF_RUNNING);
+	}
+}
+
+static void
+cell_net_apply(const struct cell_net_request *request, struct cell_net_applied *applied,
+    socket_t *so)
+{
+	char address[16], mask[16], gateway_text[16], dns1_text[16], dns2_text[16];
+	uint32_t mtu;
+	int error;
+
+	if (!request->up) {
+		cell_net_teardown(applied, so);
+		say("vayu-cell-net: session down, en1 stays attached\n");
+		return;
+	}
+
+	ip4_string(address, sizeof(address), request->address);
+	ip4_string(mask, sizeof(mask), request->mask);
+	ip4_string(gateway_text, sizeof(gateway_text), request->gateway);
+	ip4_string(dns1_text, sizeof(dns1_text), request->dns1);
+	ip4_string(dns2_text, sizeof(dns2_text), request->dns2);
+
+	mtu = request->mtu != 0 ? request->mtu : VAYU_CELL_NET_MTU_DEFAULT;
+	if (request->address == 0 || !cell_net_mask_valid(request->mask) ||
+	    mtu < VAYU_CELL_NET_MTU_MIN || mtu > VAYU_CELL_NET_MTU_MAX) {
+		say("vayu-cell-net: session refused: address %s mask %s mtu %u\n", address, mask, mtu);
+		cell_net_teardown(applied, so);
+		return;
+	}
+
+	if (!cell_net_open_socket(so)) {
+		cell_net_teardown(applied, so);
+		return;
+	}
+
+	/* A new session replaces the previous one; remove its route and address first. */
+	cell_net_teardown(applied, so);
+
+	error = ifnet_set_mtu(cell_net.ifp, mtu);
+	if (error != 0) {
+		say("vayu-cell-net: MTU %u refused: %d\n", mtu, error);
+		return;
+	}
+
+	{
+		struct ifreq ifr;
+
+		bzero(&ifr, sizeof(ifr));
+		strlcpy(ifr.ifr_name, CELL_NET_NAME, sizeof(ifr.ifr_name));
+		error = sock_ioctl(*so, SIOCPROTOATTACH, &ifr);
+		if (error != 0 && error != EEXIST) {
+			say("vayu-cell-net: SIOCPROTOATTACH: %d\n", error);
+			return;
+		}
+	}
+
+	error = cell_net_address_set(*so, request);
+	if (error != 0) {
+		say("vayu-cell-net: address %s/%s peer %s: %d\n", address, mask, gateway_text, error);
+		cell_net_teardown(applied, so);  /* in_ifinit() may have raised IFF_UP before failing */
+		return;
+	}
+
+	applied->address_set = true;
+	applied->address = request->address;
+	applied->mask = request->mask;
+	applied->gateway = request->gateway;
+	applied->dns1 = request->dns1;
+	applied->dns2 = request->dns2;
+	applied->mtu = mtu;
+	applied->fully_configured = request->gateway != 0;
+
+	if (cell_net.default_route && applied->fully_configured) {
+		applied->route_set = cell_net_route_add(request->gateway);
+	}
+
+	error = cell_net_set_up(*so);
+	if (error != 0) {
+		say("vayu-cell-net: SIOCGIFFLAGS/SIOCSIFFLAGS up: %d\n", error);
+	}
+	error = ifnet_set_flags(cell_net.ifp, IFF_UP | (applied->fully_configured ? IFF_RUNNING : 0),
+	    IFF_UP | IFF_RUNNING);
+	if (error != 0) {
+		say("vayu-cell-net: flags: %d\n", error);
+	}
+
+	say("vayu-cell-net: en1 address %s mask %s peer %s mtu %u, DNS %s %s (recorded only), "
+	    "link %s\n", address, mask, gateway_text, mtu, dns1_text, dns2_text,
+	    applied->fully_configured ? "configured" : "address only (gateway 0)");
+	cell_net_stage(applied->fully_configured ? "OK" : "ERROR",
+	    "en1 %s/%s peer %s mtu %u, flags %s%s", address, mask, gateway_text, mtu,
+	    applied->fully_configured ? "UP|RUNNING" : "address only",
+	    applied->route_set ? ", default route added" : "");
+	if (!applied->fully_configured) {
+		say("vayu-cell-net: gateway 0: address kept, no default route, not fully configured\n");
+	}
+}
+
+/* ---- the configuration thread -------------------------------------------------------------------- */
+
+static void
+cell_net_thread(void *argument __unused, wait_result_t wait __unused)
+{
+	struct cell_net_request request;
+	socket_t so = NULL;
+
+	lck_mtx_lock(&cell_net_lock);
+	for (;;) {
+		struct cell_net_applied applied;
+
+		while (!cell_net.pending) {
+			msleep(&cell_net.pending, &cell_net_lock, PZERO, "vayu-cell-net", NULL);
+		}
+		request = cell_net.request;
+		cell_net.pending = false;
+		applied = cell_net.applied;
+		lck_mtx_unlock(&cell_net_lock);
+
+		cell_net_apply(&request, &applied, &so);
+
+		lck_mtx_lock(&cell_net_lock);
+		cell_net.applied = applied;
+		cell_net.applied_generation = request.generation;
+	}
+}
+
+/* ---- the ifnet ------------------------------------------------------------------------------------ */
+
+static errno_t
+cell_net_output(ifnet_t ifp, mbuf_t packet)
+{
+	size_t length = mbuf_pkthdr_len(packet);
+	size_t total = 0;
+	const uint8_t *data = NULL;
+	mbuf_t flat = NULL;
+	bool sent = false;
+
+	if (length < CELL_NET_IPV4_MIN || length > ifnet_mtu(ifp) ||
+	    (ifnet_flags(ifp) & (IFF_UP | IFF_RUNNING)) != (IFF_UP | IFF_RUNNING)) {
+		goto done;
+	}
+
+	if (mbuf_next(packet) == NULL && mbuf_len(packet) >= length) {
+		data = mbuf_data(packet);
+	} else {
+		unsigned int chunks = 1;
+
+		if (mbuf_allocpacket(MBUF_DONTWAIT, length, &chunks, &flat) != 0) {
+			goto done;
+		}
+		if (mbuf_copydata(packet, 0, length, mbuf_data(flat)) != 0) {
+			goto done;
+		}
+		data = mbuf_data(flat);
+	}
+	if (!cell_net_ipv4_valid(data, length, &total) || total != length) {
+		goto done;
+	}
+
+	bpf_tap_out(ifp, DLT_RAW, packet, NULL, 0);
+	sent = vayu_ipa_data_transmit(VAYU_CELL_NET_MUX, data, length);
+
+done:
+	if (flat != NULL) {
+		mbuf_freem(flat);
+	}
+	if (sent) {
+		cell_net.tx_packets++;
+		cell_net.tx_bytes += length;
+		(void)ifnet_stat_increment_out(ifp, 1, (uint32_t)length, 0);
+	} else {
+		cell_net.tx_dropped++;
+		(void)ifnet_stat_increment_out(ifp, 0, 0, 1);
+	}
+	mbuf_freem(packet);
+	return 0;
+}
+
+static errno_t
+cell_net_demux(ifnet_t ifp __unused, mbuf_t packet, char *frame_header __unused,
+    protocol_family_t *protocol)
+{
+	const uint8_t *data;
+
+	while (packet != NULL && mbuf_len(packet) < 1) {
+		packet = mbuf_next(packet);
+	}
+	if (packet == NULL) {
+		return ENOENT;
+	}
+	data = mbuf_data(packet);
+	if (data == NULL || (data[0] >> 4) != 4) {
+		return ENOENT;
+	}
+	*protocol = PF_INET;
+	return 0;
+}
+
+static errno_t
+cell_net_add_proto(ifnet_t ifp __unused, protocol_family_t protocol,
+    const struct ifnet_demux_desc *demux_array __unused, u_int32_t demux_count __unused)
+{
+	return protocol == PF_INET ? 0 : ENOPROTOOPT;
+}
+
+static errno_t
+cell_net_del_proto(ifnet_t ifp __unused, protocol_family_t protocol)
+{
+	return protocol == PF_INET ? 0 : ENOPROTOOPT;
+}
+
+static errno_t
+cell_net_proto_input(ifnet_t ifp, protocol_family_t protocol, mbuf_t packet,
+    char *frame_header __unused)
+{
+	if (proto_input(protocol, packet) != 0) {
+		(void)ifnet_stat_increment_in(ifp, 0, 0, 1);
+		mbuf_freem(packet);
+	}
+	return 0;
+}
+
+static errno_t
+cell_net_attach_proto(ifnet_t ifp, protocol_family_t protocol)
+{
+	struct ifnet_attach_proto_param register_param;
+	errno_t error;
+
+	if (protocol != PF_INET) {
+		return ENOPROTOOPT;
+	}
+	bzero(&register_param, sizeof(register_param));
+	register_param.input = cell_net_proto_input;
+	error = ifnet_attach_protocol(ifp, protocol, &register_param);
+	if (error != 0 && error != EEXIST) {
+		say("vayu-cell-net: PF_INET attach: %d\n", error);
+	}
+	return error;
+}
+
+static errno_t
+cell_net_ioctl(ifnet_t ifp, u_long command, void *data)
+{
+	struct ifreq *request = data;
+	uint16_t flags;
+	bool configured;
+
+	switch (command) {
+	case SIOCSIFADDR:
+		/* bsd/netinet/in.c calls this with a struct ifaddr while it installs the address. */
+		ifnet_set_flags(ifp, IFF_UP, IFF_UP);
+		break;
+	case SIOCSIFFLAGS:
+		lck_mtx_lock(&cell_net_lock);
+		configured = cell_net.applied.fully_configured;
+		lck_mtx_unlock(&cell_net_lock);
+		flags = ifnet_flags(ifp);
+		ifnet_set_flags(ifp, ((flags & IFF_UP) && configured) ? IFF_RUNNING : 0, IFF_RUNNING);
+		break;
+	case SIOCSIFMTU:
+		if (request == NULL || request->ifr_mtu < VAYU_CELL_NET_MTU_MIN ||
+		    request->ifr_mtu > VAYU_CELL_NET_MTU_MAX) {
+			return EINVAL;
+		}
+		return ifnet_set_mtu(ifp, (uint32_t)request->ifr_mtu);
+	case SIOCADDMULTI:
+	case SIOCDELMULTI:
+		break;                          /* no link layer and no multicast on this mux */
+	default:
+		return EOPNOTSUPP;
+	}
+	return 0;
+}
+
+static bool
+cell_net_attach(void)
+{
+	struct ifnet_init_eparams init;
+	errno_t error;
+
+	bzero(&init, sizeof(init));
+	init.ver = IFNET_INIT_CURRENT_VERSION;
+	init.len = sizeof(init);
+	init.flags = IFNET_INIT_LEGACY | IFNET_INIT_NX_NOAUTO;
+	init.uniqueid = CELL_NET_UNIQUEID;
+	init.uniqueid_len = (u_int32_t)strlen(CELL_NET_UNIQUEID);
+	init.name = CELL_NET_PREFIX;
+	init.unit = CELL_NET_UNIT;
+	init.family = IFNET_FAMILY_CELLULAR;
+	init.type = IFT_CELLULAR;
+	init.output = cell_net_output;
+	init.demux = cell_net_demux;
+	init.add_proto = cell_net_add_proto;
+	init.del_proto = cell_net_del_proto;
+	init.ioctl = cell_net_ioctl;
+
+	error = ifnet_allocate_extended(&init, &cell_net.ifp);
+	if (error != 0) {
+		say("vayu-cell-net: en1 cannot be made: %d (already taken?)\n", error);
+		cell_net.ifp = NULL;
+		return false;
+	}
+	ifnet_set_capabilities_enabled(cell_net.ifp, 0, (u_int32_t)-1);
+	ifnet_set_offload(cell_net.ifp, 0);
+	ifnet_set_mtu(cell_net.ifp, VAYU_CELL_NET_MTU_DEFAULT);
+	ifnet_set_hdrlen(cell_net.ifp, 0);
+	ifnet_set_flags(cell_net.ifp, IFF_POINTOPOINT, IFF_POINTOPOINT);
+
+	error = ifnet_attach(cell_net.ifp, NULL);
+	if (error != 0) {
+		say("vayu-cell-net: en1 cannot be attached: %d\n", error);
+		ifnet_release(cell_net.ifp);
+		cell_net.ifp = NULL;
+		return false;
+	}
+	bpfattach(cell_net.ifp, DLT_RAW, 0);
+	say("vayu-cell-net: en1 attached, IFT_CELLULAR, raw IPv4, link down\n");
+	return true;
+}
+
+/* ---- what the rest of the kernel calls --------------------------------------------------------- */
+
+void
+vayu_cell_net_init(void)
+{
+	uint32_t enabled = 0;
+	uint32_t default_route = 0;
+	thread_t thread;
+	errno_t error;
+
+	if (!PE_parse_boot_argn("vayu_cell_net", &enabled, sizeof(enabled)) || enabled == 0) {
+		return;
+	}
+	if (enabled != 1) {
+		say("vayu-cell-net: vayu_cell_net=%u is refused: only 1 creates en1\n", enabled);
+		return;
+	}
+
+	lck_mtx_lock(&cell_net_lock);
+	if (cell_net.started) {
+		lck_mtx_unlock(&cell_net_lock);
+		return;
+	}
+	cell_net.started = true;
+	lck_mtx_unlock(&cell_net_lock);
+
+	PE_parse_boot_argn("vayu_cell_net_default", &default_route, sizeof(default_route));
+	cell_net.default_route = default_route == 1;
+
+	error = proto_register_plumber(PF_INET, IFNET_FAMILY_CELLULAR, cell_net_attach_proto, NULL);
+	if (error != 0 && error != EEXIST) {
+		say("vayu-cell-net: proto_register_plumber: %d\n", error);
+		return;
+	}
+
+	if (!cell_net_attach()) {
+		return;
+	}
+	if (kernel_thread_start(cell_net_thread, NULL, &thread) != KERN_SUCCESS) {
+		say("vayu-cell-net: no configuration thread; en1 stays down\n");
+		return;
+	}
+	thread_deallocate(thread);
+
+	lck_mtx_lock(&cell_net_lock);
+	cell_net.thread_started = true;
+	lck_mtx_unlock(&cell_net_lock);
+	say("vayu-cell-net: ready, vayu_cell_net=1 vayu_cell_net_default=%u; no CommCenter, no configd, "
+	    "no DNS publication\n", cell_net.default_route ? 1 : 0);
+}
+
+bool
+vayu_cell_net_ready(void)
+{
+	bool ready;
+
+	lck_mtx_lock(&cell_net_lock);
+	ready = cell_net.ifp != NULL && cell_net.thread_started;
+	lck_mtx_unlock(&cell_net_lock);
+	return ready;
+}
+
+void
+vayu_cell_net_session(bool up, uint32_t address, uint32_t mask, uint32_t gateway,
+    uint32_t dns1, uint32_t dns2, uint32_t mtu)
+{
+	lck_mtx_lock(&cell_net_lock);
+	/* Copied even before vayu_cell_net_init() has started the thread: the thread will take
+	 * the latest request when it appears. Without the opt-in nothing ever reads it. */
+	cell_net.request.up = up;
+	cell_net.request.address = address;
+	cell_net.request.mask = mask;
+	cell_net.request.gateway = gateway;
+	cell_net.request.dns1 = dns1;
+	cell_net.request.dns2 = dns2;
+	cell_net.request.mtu = mtu;
+	cell_net.request.generation = ++cell_net.request_generation;
+	cell_net.pending = true;
+	wakeup(&cell_net.pending);
+	lck_mtx_unlock(&cell_net_lock);
+}
+
+void
+vayu_cell_net_input(uint8_t mux, const uint8_t *packet, size_t length)
+{
+	struct ifnet_stat_increment_param stats = { .packets_in = 1 };
+	size_t total = 0;
+	unsigned int chunks = 1;
+	mbuf_t mbuf;
+	ifnet_t ifp;
+
+	if (mux != VAYU_CELL_NET_MUX || !cell_net_ipv4_valid(packet, length, &total)) {
+		cell_net.rx_dropped++;
+		return;
+	}
+	ifp = cell_net.ifp;
+	if (ifp == NULL || total > ifnet_mtu(ifp) ||
+	    (ifnet_flags(ifp) & (IFF_UP | IFF_RUNNING)) != (IFF_UP | IFF_RUNNING)) {
+		cell_net.rx_dropped++;
+		return;
+	}
+	if (mbuf_allocpacket(MBUF_DONTWAIT, total, &chunks, &mbuf) != 0) {
+		cell_net.rx_dropped++;
+		return;
+	}
+	if (mbuf_copyback(mbuf, 0, total, packet, MBUF_DONTWAIT) != 0) {
+		mbuf_freem(mbuf);
+		cell_net.rx_dropped++;
+		return;
+	}
+	mbuf_pkthdr_setrcvif(mbuf, ifp);
+	bpf_tap_in(ifp, DLT_RAW, mbuf, NULL, 0);
+	stats.bytes_in = (u_int32_t)total;
+	if (ifnet_input(ifp, mbuf, &stats) == 0) {
+		cell_net.rx_packets++;
+		cell_net.rx_bytes += total;
+	} else {
+		cell_net.rx_dropped++;
+	}
+}
+
+void
+vayu_cell_net_get_status(struct vayu_cell_net_status *status)
+{
+	struct cell_net_applied applied;
+	ifnet_t ifp;
+	bool thread_started;
+
+	if (status == NULL) {
+		return;
+	}
+	bzero(status, sizeof(*status));
+	lck_mtx_lock(&cell_net_lock);
+	applied = cell_net.applied;
+	ifp = cell_net.ifp;
+	thread_started = cell_net.thread_started;
+	status->generation = cell_net.applied_generation;
+	status->rx_packets = cell_net.rx_packets;
+	status->rx_bytes = cell_net.rx_bytes;
+	status->rx_dropped = cell_net.rx_dropped;
+	status->tx_packets = cell_net.tx_packets;
+	status->tx_bytes = cell_net.tx_bytes;
+	status->tx_dropped = cell_net.tx_dropped;
+	lck_mtx_unlock(&cell_net_lock);
+
+	if (ifp != NULL) {
+		uint16_t flags = ifnet_flags(ifp);
+
+		status->flags |= VAYU_CELL_NET_FLAG_ATTACHED;
+		if ((flags & IFF_UP) != 0) {
+			status->flags |= VAYU_CELL_NET_FLAG_UP;
+		}
+		if ((flags & IFF_RUNNING) != 0) {
+			status->flags |= VAYU_CELL_NET_FLAG_RUNNING;
+		}
+	}
+	if (thread_started) {
+		status->flags |= VAYU_CELL_NET_FLAG_THREAD;
+	}
+	if (applied.address_set) {
+		status->flags |= VAYU_CELL_NET_FLAG_ADDRESS;
+		status->address = applied.address;
+		status->mask = applied.mask;
+		status->gateway = applied.gateway;
+		status->dns1 = applied.dns1;
+		status->dns2 = applied.dns2;
+		status->mtu = applied.mtu;
+	}
+	if (applied.route_set) {
+		status->flags |= VAYU_CELL_NET_FLAG_DEFAULT_ROUTE;
+	}
+	if (applied.fully_configured) {
+		status->flags |= VAYU_CELL_NET_FLAG_FULLY_CONFIGURED;
+	}
+}
--- a/bsd/sys/vayu_ipa_data.h
+++ b/bsd/sys/vayu_ipa_data.h
@@ -0,0 +1,23 @@
+/* vayu IPA 4.1 / GSI 2.0 packet transport (separate from the modem QMI handshake). */
+#ifndef _SYS_VAYU_IPA_DATA_H_
+#define _SYS_VAYU_IPA_DATA_H_
+
+#ifdef KERNEL
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/* After ipa_fws and IPA HW init, before MPSS: channels, endpoints and empty tables.
+ * vayu_ipa_data=1 opts in; 0 leaves only the control-plane handshake available. */
+bool vayu_ipa_data_prepare(void);
+/* False if the polling thread or a channel did not stop: caller must leave IPA powered. */
+bool vayu_ipa_data_stop(void);
+/* True only when all four channels started, RX was primed and all table commands completed.
+ * A modem filter request which is not implemented clears this again; WDS must fail closed. */
+bool vayu_ipa_data_ready(void);
+void vayu_ipa_data_filter_error(void);
+/* Raw IP packet, copied into a QMAP/TX slot before returning. */
+bool vayu_ipa_data_transmit(uint8_t mux, const void *packet, size_t length);
+#endif
+
+#endif /* _SYS_VAYU_IPA_DATA_H_ */
--- a/bsd/sys/vayu_cell_net.h
+++ b/bsd/sys/vayu_cell_net.h
@@ -0,0 +1,93 @@
+/*
+ * The cellular data interface, en1: raw IPv4 in QMAP mux 1, for the POCO X3 Pro (vayu, SM8150-AC).
+ * bsd/dev/vayu_cell_net.c is the implementation; this header is what the rest of the kernel uses.
+ *
+ * en1 is not Ethernet and carries no Ethernet header: the modem hands over IP packets in QMAP
+ * mux 1 (sys/vayu_cell_qmap.h), vayu_cell_net_input() passes them to PF_INET unchanged, and the
+ * output path hands raw IPv4 to vayu_ipa_data_transmit() for the same mux. There is no ARP, no
+ * DHCP, no link-layer address and no link header -- DLT_RAW on BPF. en0 and en2 are not touched.
+ *
+ * What is deliberately absent: CommCenter and configd know nothing of this interface (it is made
+ * with IFNET_INIT_NX_NOAUTO and no KEV_DL_LINK_ON/OFF is posted), DNS is recorded in the status and
+ * the log only, and no default route is added unless the boot arg vayu_cell_net_default=1 says so.
+ * A link that is UP and RUNNING means only that the address/mask/peer were installed; it is not a
+ * claim that the modem, IPA or the network beyond it can carry a packet.
+ *
+ * Boot args (bsd/dev/vayu_cell_net.c):
+ *   vayu_cell_net=1         create en1 and start its configuration thread (default 0: nothing)
+ *   vayu_cell_net_default=1 also add a global default route via the session's gateway (default 0)
+ *
+ * Addresses are host order, the way vayu_cell_data.c holds the WDS words (it prints them with
+ * shifts and applies htonl only when building a sockaddr). vayu_cell_net_session() copies the
+ * arguments and wakes its thread; it never opens a socket or sleeps on the configuration work.
+ * The caller must still be a sleepable kernel thread (QMI/driver threads here), not an ISR:
+ * a short mutex protects the request. vayu_cell_net_input() does no allocation that can wait.
+ */
+#ifndef _SYS_VAYU_CELL_NET_H_
+#define _SYS_VAYU_CELL_NET_H_
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/* The one mux this port binds (WDS Bind Mux Data Port, vayu_cell_data.c). */
+#define VAYU_CELL_NET_MUX               1
+#define VAYU_CELL_NET_MTU_DEFAULT       1500
+#define VAYU_CELL_NET_MTU_MIN           576
+#define VAYU_CELL_NET_MTU_MAX           1500
+
+/* vayu_cell_net_get_status(): what exists and what was last applied. */
+#define VAYU_CELL_NET_FLAG_ATTACHED     0x00000001u     /* en1 was made and attached */
+#define VAYU_CELL_NET_FLAG_THREAD       0x00000002u     /* the configuration thread runs */
+#define VAYU_CELL_NET_FLAG_UP           0x00000004u     /* IFF_UP */
+#define VAYU_CELL_NET_FLAG_RUNNING      0x00000008u     /* IFF_RUNNING: address and peer installed */
+#define VAYU_CELL_NET_FLAG_ADDRESS      0x00000010u     /* en1 has the IPv4 address below */
+#define VAYU_CELL_NET_FLAG_DEFAULT_ROUTE 0x00000020u    /* the module added the default route */
+#define VAYU_CELL_NET_FLAG_FULLY_CONFIGURED 0x00000040u /* address, mask and a non-zero gateway */
+
+struct vayu_cell_net_status {
+	uint32_t flags;                 /* VAYU_CELL_NET_FLAG_* */
+	uint32_t address;               /* host order, 0 when none */
+	uint32_t mask;
+	uint32_t gateway;               /* 0: address kept, link not RUNNING, no default route */
+	uint32_t dns1;                  /* recorded and logged only, never published to configd */
+	uint32_t dns2;
+	uint32_t mtu;
+	uint32_t generation;            /* the last session request taken up */
+	uint64_t rx_packets;
+	uint64_t rx_bytes;
+	uint64_t rx_dropped;
+	uint64_t tx_packets;
+	uint64_t tx_bytes;
+	uint64_t tx_dropped;
+};
+
+#ifdef KERNEL
+
+/* Opt-in vayu_cell_net=1: attach en1 and start the thread. Idempotent; nothing without the arg. */
+void vayu_cell_net_init(void);
+/* True only when en1 and its configuration thread exist; says nothing about configuration. */
+bool vayu_cell_net_ready(void);
+
+/*
+ * Ask for a session or its end. `up` false means teardown (route and address removed, flags
+ * down) and ignores the other arguments. For up: address and mask must be valid, mtu 0 means
+ * VAYU_CELL_NET_MTU_DEFAULT, and gateway 0 means "keep the address but do not claim a complete
+ * configuration". Copies only; the socket and route work happens in the module's thread.
+ */
+void vayu_cell_net_session(bool up, uint32_t address, uint32_t mask, uint32_t gateway,
+    uint32_t dns1, uint32_t dns2, uint32_t mtu);
+
+/*
+ * One raw IPv4 packet from the modem, already stripped of its QMAP header (sys/vayu_cell_qmap.h
+ * does the aggregation walk). Only mux 1, only a complete IPv4 header/packet, only while en1 is
+ * UP and RUNNING; anything else is counted and dropped. No sleep, no socket, no link header.
+ */
+void vayu_cell_net_input(uint8_t mux, const uint8_t *packet, size_t length);
+
+/* Copy the state and counters; safe from any thread, takes only the module lock. */
+void vayu_cell_net_get_status(struct vayu_cell_net_status *status);
+
+#endif /* KERNEL */
+
+#endif /* _SYS_VAYU_CELL_NET_H_ */
--- a/bsd/sys/vayu_cell_qmap.h
+++ b/bsd/sys/vayu_cell_qmap.h
@@ -0,0 +1,153 @@
+/*
+ * The 4-byte QMAP/MAP header of the modem's data path (vayu, bsd/dev/vayu_cell_net.c).
+ *
+ * This is the v1 MAP header the modem uses after WDA Set Data Format asks for QMAP aggregation
+ * (bsd/dev/vayu_cell_data.c): Qualcomm's QMAP header, written down in Linux's
+ * include/linux/if_rmnet.h as
+ *
+ *     struct rmnet_map_header { u8 flags; u8 mux_id; __be16 pkt_len; };
+ *
+ * and filled the same way by qcom-usb-kernel-drivers' qmap.h (cd_rsvd_pad, mux_id, pkt_len).
+ *
+ * Bits 0..5 of `flags` are the padding, bit 6 "next header", bit 7 "command"; `mux_id` follows;
+ * `pkt_len` is big-endian and counts the payload *including* the padding but not the 4-byte
+ * header (Documentation/networking/device_drivers/cellular/qualcomm/rmnet.rst, "MAP packet v1").
+ * That one multi-byte field is big-endian, unlike the WDS address words, which vayu_cell_data.c
+ * prints with shifts and therefore holds in host order.
+ *
+ * Everything here is pure: it reads only the bytes handed to it, never more than `available`, and
+ * decides nothing about which mux id is useful. The boundary (bsd/dev/vayu_cell_net.c, and the IPA
+ * receive path to come) accepts mux 1 and rejects command frames; a command frame still decodes so
+ * that the receiver can count it and say why it was dropped. The `next` bit is reported, not
+ * followed: this port asks WDA for no checksum offload, so the only header there can be is one
+ * this code does not understand, and its payload will fail the IPv4 nibble check at the boundary.
+ *
+ * No unbounded reads: the header needs 4 bytes, the payload length is a 16-bit bound, and a
+ * packet whose header length or padding does not fit in `available` is refused.
+ *
+ * The test of this file is tools/cell-net-test (host, ASan/UBSan).
+ */
+#ifndef _SYS_VAYU_CELL_QMAP_H_
+#define _SYS_VAYU_CELL_QMAP_H_
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define VAYU_QMAP_HEADER_LEN    4
+#define VAYU_QMAP_PAD_MAX       0x3f
+#define VAYU_QMAP_LENGTH_MAX    0xffff
+#define VAYU_QMAP_MUX_MAX       0xff
+#define VAYU_QMAP_FLAG_NEXT     0x40
+#define VAYU_QMAP_FLAG_COMMAND  0x80
+
+struct vayu_qmap_header {
+	uint8_t  pad_len;       /* bytes of padding after the payload */
+	bool     next_header;   /* bit 6: another header follows the MAP header */
+	bool     command;       /* bit 7: a MAP command, not a data packet */
+	uint16_t length;        /* payload plus padding, not the 4-byte header */
+	uint8_t  mux_id;
+};
+
+/* Decode the header at `packet`. Only the 4 header bytes are looked at. */
+static inline bool
+vayu_qmap_header_decode(const uint8_t *packet, size_t available,
+    struct vayu_qmap_header *header)
+{
+	uint8_t flags;
+
+	if (packet == NULL || header == NULL || available < VAYU_QMAP_HEADER_LEN) {
+		return false;
+	}
+	flags = packet[0];
+	header->pad_len = flags & VAYU_QMAP_PAD_MAX;
+	header->next_header = (flags & VAYU_QMAP_FLAG_NEXT) != 0;
+	header->command = (flags & VAYU_QMAP_FLAG_COMMAND) != 0;
+	header->mux_id = packet[1];
+	header->length = (uint16_t)(((uint16_t)packet[2] << 8) | packet[3]);
+	return true;
+}
+
+/* Build a header; refuses a padding field that does not fit in its six bits. */
+static inline bool
+vayu_qmap_header_encode(uint8_t *packet, const struct vayu_qmap_header *header)
+{
+	if (packet == NULL || header == NULL || header->pad_len > VAYU_QMAP_PAD_MAX) {
+		return false;
+	}
+	packet[0] = (uint8_t)(header->pad_len |
+	    (header->next_header ? VAYU_QMAP_FLAG_NEXT : 0) |
+	    (header->command ? VAYU_QMAP_FLAG_COMMAND : 0));
+	packet[1] = header->mux_id;
+	packet[2] = (uint8_t)(header->length >> 8);
+	packet[3] = (uint8_t)header->length;
+	return true;
+}
+
+/*
+ * Decode one element of a MAP aggregation: the header, then `length` payload bytes, of which the
+ * last `pad_len` are padding. The element must fit in `available`; bytes past it belong to the
+ * next element and are left for the caller. `payload` points into the caller's buffer, so it is
+ * valid exactly as long as that buffer is.
+ *
+ * An empty payload (length 0, or all of the length is padding) is refused: the receiver has
+ * nothing to hand to IP, and Linux's rmnet_map_deaggregate() refuses `pkt_len == 0` for the same
+ * reason.
+ */
+static inline bool
+vayu_qmap_packet_decode(const uint8_t *packet, size_t available,
+    struct vayu_qmap_header *header, const uint8_t **payload,
+    size_t *payload_length)
+{
+	size_t total, data_length;
+
+	if (!vayu_qmap_header_decode(packet, available, header)) {
+		return false;
+	}
+	if (header->length == 0 || header->pad_len > header->length) {
+		return false;
+	}
+	total = VAYU_QMAP_HEADER_LEN + (size_t)header->length;
+	if (total > available) {
+		return false;
+	}
+	data_length = (size_t)header->length - header->pad_len;
+	if (data_length == 0) {
+		return false;
+	}
+	if (payload != NULL) {
+		*payload = packet + VAYU_QMAP_HEADER_LEN;
+	}
+	if (payload_length != NULL) {
+		*payload_length = data_length;
+	}
+	return true;
+}
+
+/*
+ * Walk a whole aggregation, one element per call. On success `*cursor` and `*remaining` advance
+ * past the element (header + payload + padding); on failure neither is changed, so the caller
+ * can drop the rest without having to reason about a partial step.
+ */
+static inline bool
+vayu_qmap_next(const uint8_t **cursor, size_t *remaining,
+    struct vayu_qmap_header *header, const uint8_t **payload,
+    size_t *payload_length)
+{
+	size_t step, available;
+
+	if (cursor == NULL || remaining == NULL || header == NULL) {
+		return false;
+	}
+	available = *remaining;
+	if (!vayu_qmap_packet_decode(*cursor, available, header, payload,
+	    payload_length)) {
+		return false;
+	}
+	step = VAYU_QMAP_HEADER_LEN + (size_t)header->length;
+	*cursor += step;
+	*remaining = available - step;
+	return true;
+}
+
+#endif /* _SYS_VAYU_CELL_QMAP_H_ */
