+	say("vayu-ipa-qmi: S1 SMP2P: %s ours \"ipa\" %s%#x, modem \"ipa\" %s%#x, firmware %s (%llu ms)\n",
+	    ours_found && (ours & 3) == 3 ? "OK" : "ERROR", ours_found ? "" : "absent ", ours,
+	    theirs_found ? "" : "absent ", theirs, vayu_ipa_firmware_ready() ? "ready" : "NOT READY", waited);
