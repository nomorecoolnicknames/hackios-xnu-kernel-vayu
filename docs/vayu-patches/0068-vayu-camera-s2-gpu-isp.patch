+
+#define GL_DECLARE(ret, name, args)     static ret (*p_gl##name) args;
+GL_FUNCTIONS(GL_DECLARE)
+#undef GL_DECLARE
+
+/* ---- the one context, and its textures --------------------------------------------------------- */
+
+#define GPU_LIBRARIES   { "/redwood/lib/libOSMesa.8.dylib", "libOSMesa.8.dylib", "/usr/lib/libOSMesa.8.dylib" }
+#define GPU_WINDOW      16
+
+struct gpu {
+	int             tried;          /* the library has been looked for */
+	bool            ok;             /* the context and both programs are made */
+	bool            said_failure;
+	void            *library;
+	OSMesaContext   context;
+	unsigned char   window[GPU_WINDOW * GPU_WINDOW * 4];
+
+	GLuint          raw_program, nv12_program;
+	GLuint          raw_texture, lsc_texture, gamma_texture;
+	GLuint          rgb_texture, y_texture, uv_texture;
+	GLuint          raw_fbo, nv12_fbo;
+	GLuint          vao;
+
+	GLint           u_raw[16], u_nv12[8];   /* the uniforms' locations, by name */
+
+	uint32_t        raw_stride, raw_height;
+	uint32_t        width, height;
+	unsigned char   *uv_scratch;
+	size_t          uv_scratch_bytes;
+};
+
+static struct gpu gpu;
+static pthread_mutex_t gpu_lock = PTHREAD_MUTEX_INITIALIZER;
+static __thread struct gpu *gpu_current;
+
+static void
+gpu_say(const char *format, ...)
+{
+	va_list list;
+
+	va_start(list, format);
+	fprintf(stderr, "gpu_isp: ");
+	vfprintf(stderr, format, list);
+	fprintf(stderr, "\n");
+	va_end(list);
+}
+
+/* the library's functions: OSMesa's own out of it, the GL ones by its GetProcAddress (or dlsym) */
+static int
+gpu_load(void)
+{
+	static const char *const names[] = GPU_LIBRARIES;
+	OSMesaContext (*create)(const int *, OSMesaContext);
+	unsigned char (*make_current)(OSMesaContext, void *, unsigned, int, int);
+	void (*destroy)(OSMesaContext);
+	void (*(*get_proc)(const char *))(void);
+	const int attributes[] = {
+		OSMESA_FORMAT, GL_RGBA, OSMESA_DEPTH_BITS, 24, OSMESA_STENCIL_BITS, 8,
+		OSMESA_PROFILE, OSMESA_ES_PROFILE, OSMESA_CONTEXT_MAJOR_VERSION, 3, OSMESA_CONTEXT_MINOR_VERSION, 0,
+		0
+	};
+	const char *path = getenv("HAKIOS_OSMESA");
+	unsigned i;
+
+	for (i = 0; path == NULL && i < sizeof(names) / sizeof(names[0]); i++) {
+		path = names[i];
+		if (access(path, R_OK) != 0) {
+			path = NULL;
+		}
+	}
+	if (path == NULL) {
+		gpu_say("no libOSMesa.8.dylib in the image: the processor's ISP");
+		return 0;
+	}
+	gpu.library = dlopen(path, RTLD_NOW | RTLD_LOCAL);
+	if (gpu.library == NULL) {
+		gpu_say("dlopen(%s): %s", path, dlerror());
+		return 0;
+	}
+	create = (OSMesaContext (*)(const int *, OSMesaContext))dlsym(gpu.library, "OSMesaCreateContextAttribs");
+	make_current = (unsigned char (*)(OSMesaContext, void *, unsigned, int, int))dlsym(gpu.library, "OSMesaMakeCurrent");
+	destroy = (void (*)(OSMesaContext))dlsym(gpu.library, "OSMesaDestroyContext");
+	get_proc = (void (*(*)(const char *))(void))dlsym(gpu.library, "OSMesaGetProcAddress");
+	if (create == NULL || make_current == NULL || get_proc == NULL) {
+		gpu_say("%s is not an off-screen library of Mesa's", path);
+		return 0;
+	}
+	(void)destroy;
+	gpu.context = create(attributes, NULL);
+	if (gpu.context == NULL) {
+		gpu_say("%s: no OpenGL ES 3 context (gpu=1? the kernel's GPU driver)", path);
+		return 0;
+	}
+	if (!make_current(gpu.context, gpu.window, GL_UNSIGNED_BYTE, GPU_WINDOW, GPU_WINDOW)) {
+		gpu_say("%s: the context cannot be made current", path);
+		return 0;
+	}
+	gpu_current = &gpu;
+
+#define GL_LOAD(ret, name, args) \
+	do { \
+		p_gl##name = (ret (*) args)get_proc("gl" #name); \
+		if (p_gl##name == NULL) { \
+			p_gl##name = (ret (*) args)dlsym(gpu.library, "gl" #name); \
+		} \
+		if (p_gl##name == NULL) { \
+			gpu_say("%s has no gl%s", path, #name); \
+			return 0; \
+		} \
+	} while (0);
+	GL_FUNCTIONS(GL_LOAD)
+#undef GL_LOAD
+	gpu_say("%s on %s (%s)", path, (const char *)p_glGetString(GL_RENDERER), (const char *)p_glGetString(GL_VERSION));
+	return 1;
+}
+
+static GLuint
+gpu_shader(GLenum type, const char *text)
+{
+	GLuint shader = p_glCreateShader(type);
+	GLint ok = 0;
+
+	p_glShaderSource(shader, 1, &text, NULL);
+	p_glCompileShader(shader);
+	p_glGetShaderiv(shader, GL_COMPILE_STATUS, &ok);
+	if (!ok) {
+		char log[1024] = "";
+
+		p_glGetShaderInfoLog(shader, sizeof(log) - 1, NULL, log);
+		gpu_say("a %s shader the driver will not take: %s", type == GL_VERTEX_SHADER ? "vertex" : "fragment", log);
+		p_glDeleteShader(shader);
+		return 0;
+	}
+	return shader;
+}
+
+static GLuint
+gpu_program(const char *fragment, const char *what)
+{
+	GLuint vertex = gpu_shader(GL_VERTEX_SHADER, isp_gpu_vertex_shader), frag, program;
+	GLint ok = 0;
+
+	if (vertex == 0) {
+		return 0;
+	}
+	frag = gpu_shader(GL_FRAGMENT_SHADER, fragment);
+	if (frag == 0) {
+		p_glDeleteShader(vertex);
+		return 0;
+	}
+	program = p_glCreateProgram();
+	p_glAttachShader(program, vertex);
+	p_glAttachShader(program, frag);
+	p_glLinkProgram(program);
+	p_glGetProgramiv(program, GL_LINK_STATUS, &ok);
+	p_glDeleteShader(vertex);
+	p_glDeleteShader(frag);
+	if (!ok) {
+		char log[1024] = "";
+
+		p_glGetProgramInfoLog(program, sizeof(log) - 1, NULL, log);
+		gpu_say("the %s program will not link: %s", what, log);
+		p_glDeleteProgram(program);
+		return 0;
+	}
+	return program;
+}
+
+static GLuint
+gpu_texture(GLenum internal, int w, int h, GLenum format, GLenum type, const void *pixels, int integer)
+{
+	GLuint texture = 0;
+
+	p_glGenTextures(1, &texture);
+	p_glBindTexture(GL_TEXTURE_2D, texture);
+	p_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+	p_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+	p_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+	p_glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+	p_glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+	p_glTexImage2D(GL_TEXTURE_2D, 0, (GLint)internal, w, h, 0, format, type, pixels);
+	(void)integer;
+	return texture;
+}
+
+static int
+gpu_begin(void)
+{
+	const GLenum attachments[2] = { GL_COLOR_ATTACHMENT0, GL_COLOR_ATTACHMENT1 };
+
+	if (gpu.ok) {
+		return 1;
+	}
+	if (gpu.tried) {
+		return 0;
+	}
+	gpu.tried = 1;
+	if (!gpu_load()) {
+		return 0;
+	}
+	gpu.raw_program = gpu_program(isp_gpu_raw_shader, "RAW");
+	gpu.nv12_program = gpu_program(isp_gpu_nv12_shader, "NV12");
+	if (gpu.raw_program == 0 || gpu.nv12_program == 0) {
+		return 0;
+	}
+	gpu.vao = 0;
+	p_glGenVertexArrays(1, &gpu.vao);
+	p_glBindVertexArray(gpu.vao);
+	gpu.raw_texture = gpu_texture(GL_R8UI, 1, 1, GL_RED_INTEGER, GL_UNSIGNED_BYTE, NULL, 1);
+	gpu.lsc_texture = gpu_texture(GL_RGB16F, 1, 1, GL_RGB, GL_FLOAT, NULL, 0);
+	gpu.gamma_texture = gpu_texture(GL_R8, 1, 1, GL_RED, GL_UNSIGNED_BYTE, NULL, 0);
+	gpu.rgb_texture = gpu_texture(GL_RGBA8UI, 1, 1, GL_RGBA_INTEGER, GL_UNSIGNED_BYTE, NULL, 1);
+	gpu.y_texture = gpu_texture(GL_R8UI, 1, 1, GL_RED_INTEGER, GL_UNSIGNED_BYTE, NULL, 1);
+	gpu.uv_texture = gpu_texture(GL_RG8UI, 1, 1, GL_RG_INTEGER, GL_UNSIGNED_BYTE, NULL, 1);
+	p_glGenFramebuffers(1, &gpu.raw_fbo);
+	p_glBindFramebuffer(GL_FRAMEBUFFER, gpu.raw_fbo);
+	p_glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, gpu.rgb_texture, 0);
+	if (p_glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE) {
+		gpu_say("the RAW pass's framebuffer is not complete");
+		return 0;
+	}
+	p_glGenFramebuffers(1, &gpu.nv12_fbo);
+	p_glBindFramebuffer(GL_FRAMEBUFFER, gpu.nv12_fbo);
+	p_glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, gpu.y_texture, 0);
+	p_glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT1, GL_TEXTURE_2D, gpu.uv_texture, 0);
+	p_glDrawBuffers(2, attachments);
+	if (p_glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE) {
+		gpu_say("the NV12 pass's framebuffer is not complete");
+		return 0;
+	}
+	p_glBindFramebuffer(GL_FRAMEBUFFER, 0);
+	{
+		static const char *const raw_names[] = { "uRaw", "uRawW", "uRawH", "uBlack", "uLsc", "uLscOn", "uCellsW", "uCellsH",
+			"uGamma", "uRow0", "uRow1", "uRow2", "uRp", "uBp", "uOutW", "uOutH" };
+		static const char *const nv12_names[] = { "uRGB", "uW", "uH", "uSigma", "uAmount", "uVideoRange", NULL, NULL };
+		unsigned i;
+
+		for (i = 0; i < 16; i++) {
+			gpu.u_raw[i] = p_glGetUniformLocation(gpu.raw_program, raw_names[i]);
+		}
+		for (i = 0; i < 8; i++) {
+			gpu.u_nv12[i] = nv12_names[i] != NULL ? p_glGetUniformLocation(gpu.nv12_program, nv12_names[i]) : -1;
+		}
+	}
+	gpu.ok = true;
+	return 1;
+}
+
+/* the lens shading's grid and the tone's table, when the ISP's are not what the GPU last had */
+static void
+gpu_uplink(const struct isp *isp)
+{
+	static const struct isp *last_isp;
+	static uint8_t last_gamma[4096];
+	static float last_gain[3][LSC_H][LSC_W];
+	static bool have;
+
+	if (have && last_isp == isp && memcmp(last_gamma, isp->gamma, sizeof(last_gamma)) == 0 &&
+	    memcmp(last_gain, isp->lsc.gain, sizeof(last_gain)) == 0) {
+		return;
+	}
+	memcpy(last_gamma, isp->gamma, sizeof(last_gamma));
+	memcpy(last_gain, isp->lsc.gain, sizeof(last_gain));
+	last_isp = isp;
+	have = true;
+	{
+		float grid[LSC_H * LSC_W * 3];
+		unsigned x, y;
+
+		for (y = 0; y < LSC_H; y++) {
+			for (x = 0; x < LSC_W; x++) {
+				for (int c = 0; c < 3; c++) {
+					grid[(y * LSC_W + x) * 3 + c] = isp->lsc.on ? isp->lsc.gain[c][y][x] : 1.0f;
+				}
+			}
+		}
+		p_glActiveTexture(GL_TEXTURE0 + 1);
+		p_glBindTexture(GL_TEXTURE_2D, gpu.lsc_texture);
+		p_glTexImage2D(GL_TEXTURE_2D, 0, GL_RGB16F, LSC_W, LSC_H, 0, GL_RGB, GL_FLOAT, grid);
+	}
+	p_glActiveTexture(GL_TEXTURE0 + 2);
+	p_glBindTexture(GL_TEXTURE_2D, gpu.gamma_texture);
+	p_glTexImage2D(GL_TEXTURE_2D, 0, GL_R8, 4096, 1, 0, GL_RED, GL_UNSIGNED_BYTE, isp->gamma);
+	p_glActiveTexture(GL_TEXTURE0);
+}
+
+/* the colour matrix with the white balance's and AE's gains folded in, as camera_isp.c's pipe_init() */
+static void
+gpu_matrix(const struct isp *isp, float rows[3][3])
+{
+	for (int c = 0; c < 3; c++) {
+		for (int j = 0; j < 3; j++) {
+			rows[c][j] = isp->ccm[c][j] * isp->wb[j] * isp->digital * (3836.0f / 959.0f);
+		}
+	}
+}
+
+bool
+isp_gpu_start(void)
+{
+	bool ok;
+
+	pthread_mutex_lock(&gpu_lock);
+	ok = gpu_begin();
+	pthread_mutex_unlock(&gpu_lock);
+	return ok;
+}
+
+bool
+isp_gpu_render_nv12(const struct isp *isp, const struct hakios_camera_frame *f, const uint8_t *raw, uint8_t *y, size_t y_stride,
+    uint8_t *uv, size_t uv_stride, uint32_t width, uint32_t height, bool video_range)
+{
+	static const int red[4] = { 0, 1, 2, 3 }, blue[4] = { 3, 2, 1, 0 };
+	float rows[3][3];
+	uint32_t rw, rh;
+
+	if (!isp->gpu || width == 0 || height == 0 || f == NULL || raw == NULL || y == NULL || uv == NULL) {
+		return false;
+	}
+	if (pthread_mutex_trylock(&gpu_lock) != 0) {
+		return false;           /* (a frame is being made already: this one goes the processor's way) */
+	}
+	if (!gpu_begin()) {
+		pthread_mutex_unlock(&gpu_lock);
+		return false;
+	}
+	if (gpu_current != &gpu) {
+		/* (the library's make-current, out of the context made in gpu_load()) */
+		unsigned char (*make_current)(OSMesaContext, void *, unsigned, int, int) =
+			(unsigned char (*)(OSMesaContext, void *, unsigned, int, int))dlsym(gpu.library, "OSMesaMakeCurrent");
+
+		if (make_current == NULL || !make_current(gpu.context, gpu.window, GL_UNSIGNED_BYTE, GPU_WINDOW, GPU_WINDOW)) {
+			gpu_say("the context cannot be made current on this thread");
+			pthread_mutex_unlock(&gpu_lock);
+			return false;
+		}
+		gpu_current = &gpu;
+	}
+	/* the frame's bytes: four pixels in five, `stride` bytes a line */
+	rw = f->stride;
+	rh = f->height;
+	if (rw == 0 || rh == 0) {
+		pthread_mutex_unlock(&gpu_lock);
+		return false;
+	}
+	p_glActiveTexture(GL_TEXTURE0);
+	p_glBindTexture(GL_TEXTURE_2D, gpu.raw_texture);
+	p_glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+	if (rw != gpu.raw_stride || rh != gpu.raw_height) {
+		p_glTexImage2D(GL_TEXTURE_2D, 0, GL_R8UI, (GLsizei)rw, (GLsizei)rh, 0, GL_RED_INTEGER, GL_UNSIGNED_BYTE, raw);
+		gpu.raw_stride = rw;
+		gpu.raw_height = rh;
+	} else {
+		p_glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, (GLsizei)rw, (GLsizei)rh, GL_RED_INTEGER, GL_UNSIGNED_BYTE, raw);
+	}
+	/* the picture's own targets, when they are another size */
+	if (width != gpu.width || height != gpu.height) {
+		p_glBindTexture(GL_TEXTURE_2D, gpu.rgb_texture);
+		p_glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8UI, (GLsizei)width, (GLsizei)height, 0, GL_RGBA_INTEGER, GL_UNSIGNED_BYTE, NULL);
+		p_glBindTexture(GL_TEXTURE_2D, gpu.y_texture);
+		p_glTexImage2D(GL_TEXTURE_2D, 0, GL_R8UI, (GLsizei)width, (GLsizei)height, 0, GL_RED_INTEGER, GL_UNSIGNED_BYTE, NULL);
+		p_glBindTexture(GL_TEXTURE_2D, gpu.uv_texture);
+		p_glTexImage2D(GL_TEXTURE_2D, 0, GL_RG8UI, (GLsizei)width, (GLsizei)height, 0, GL_RG_INTEGER, GL_UNSIGNED_BYTE, NULL);
+		gpu.width = width;
+		gpu.height = height;
+		free(gpu.uv_scratch);
+		gpu.uv_scratch_bytes = (size_t)width * height * 2;
+		gpu.uv_scratch = malloc(gpu.uv_scratch_bytes);
+		if (gpu.uv_scratch == NULL) {
+			gpu_say("no memory for the picture (%ux%u)", width, height);
+			pthread_mutex_unlock(&gpu_lock);
+			return false;
+		}
+	}
+	gpu_uplink(isp);
+	gpu_matrix(isp, rows);
+
+	/* pass 1: the frame's bytes to R, G, B */
+	p_glUseProgram(gpu.raw_program);
+	p_glBindFramebuffer(GL_FRAMEBUFFER, gpu.raw_fbo);
+	p_glViewport(0, 0, (GLsizei)width, (GLsizei)height);
+	p_glBindVertexArray(gpu.vao);
+	p_glUniform1i(gpu.u_raw[0], 0);
+	p_glUniform1i(gpu.u_raw[1], (GLint)f->width);
+	p_glUniform1i(gpu.u_raw[2], (GLint)f->height);
+	p_glUniform1f(gpu.u_raw[3], (GLfloat)f->black);
+	p_glUniform1i(gpu.u_raw[4], 1);
+	p_glUniform1i(gpu.u_raw[5], isp->lsc.on ? 1 : 0);
+	p_glUniform1i(gpu.u_raw[6], (GLint)(f->width / 2));
+	p_glUniform1i(gpu.u_raw[7], (GLint)(f->height / 2));
+	p_glUniform1i(gpu.u_raw[8], 2);
+	p_glUniform3f(gpu.u_raw[9], rows[0][0], rows[0][1], rows[0][2]);
+	p_glUniform3f(gpu.u_raw[10], rows[1][0], rows[1][1], rows[1][2]);
+	p_glUniform3f(gpu.u_raw[11], rows[2][0], rows[2][1], rows[2][2]);
+	p_glUniform1i(gpu.u_raw[12], red[f->bayer & 3]);
+	p_glUniform1i(gpu.u_raw[13], blue[f->bayer & 3]);
+	p_glUniform1i(gpu.u_raw[14], (GLint)width);
+	p_glUniform1i(gpu.u_raw[15], (GLint)height);
+	p_glDrawArrays(GL_TRIANGLES, 0, 3);
+
+	/* pass 2: those bytes to NV12 (Y and UV at once) */
+	p_glBindFramebuffer(GL_FRAMEBUFFER, gpu.nv12_fbo);
+	p_glUseProgram(gpu.nv12_program);
+	p_glActiveTexture(GL_TEXTURE0);
+	p_glBindTexture(GL_TEXTURE_2D, gpu.rgb_texture);
+	p_glUniform1i(gpu.u_nv12[0], 0);
+	p_glUniform1i(gpu.u_nv12[1], (GLint)width);
+	p_glUniform1i(gpu.u_nv12[2], (GLint)height);
+	p_glUniform1f(gpu.u_nv12[3], isp->gpu_sigma);
+	p_glUniform1f(gpu.u_nv12[4], isp->look.preview_sharp);
+	p_glUniform1i(gpu.u_nv12[5], video_range ? 1 : 0);
+	p_glDrawArrays(GL_TRIANGLES, 0, 3);
+
+	/* Y in place, UV through the picture-sized buffer: each 2x2 block's pair, one column in two */
+	p_glReadBuffer(GL_COLOR_ATTACHMENT0);
+	p_glPixelStorei(GL_PACK_ALIGNMENT, 1);
+	p_glPixelStorei(GL_PACK_ROW_LENGTH, (GLint)(y_stride));
+	p_glReadPixels(0, 0, (GLsizei)width, (GLsizei)height, GL_RED_INTEGER, GL_UNSIGNED_BYTE, y);
+	p_glReadBuffer(GL_COLOR_ATTACHMENT1);
+	p_glPixelStorei(GL_PACK_ROW_LENGTH, (GLint)width);
+	p_glReadPixels(0, 0, (GLsizei)width, (GLsizei)height, GL_RG_INTEGER, GL_UNSIGNED_BYTE, gpu.uv_scratch);
+	for (uint32_t row = 0; row < height / 2; row++) {
+		const uint8_t *in = gpu.uv_scratch + (size_t)row * 2 * width * 2;
+		uint8_t *out = uv + (size_t)row * uv_stride;
+
+		for (uint32_t x = 0; x < width / 2; x++) {
+			out[2 * x] = in[4 * x];
+			out[2 * x + 1] = in[4 * x + 1];
+		}
+	}
+	p_glPixelStorei(GL_PACK_ROW_LENGTH, 0);
+	p_glBindFramebuffer(GL_FRAMEBUFFER, 0);
+
+	if (p_glGetError() != 0 && !gpu.said_failure) {
+		gpu.said_failure = true;
+		gpu_say("OpenGL ES error: this frame may be wrong, and the next ones say if it is");
+	}
+	pthread_mutex_unlock(&gpu_lock);
+	return true;
+}
diff -ruN a/userland/src/camera_isp_gpu_shaders.h b/userland/src/camera_isp_gpu_shaders.h
--- a/userland/src/camera_isp_gpu_shaders.h
+++ b/userland/src/camera_isp_gpu_shaders.h
@@ -0,0 +1,229 @@
+/*
+ * The shaders of the GPU ISP (src/camera_isp_gpu.c), as text: OpenGL ES 3.0, two passes.
+ *
+ * Pass 1, of the sensor's RAW10 frame to 8-bit R, G, B (an RGBA8UI target, so that the bytes are
+ * the bytes): each output pixel's nearest sensor site, its 10 bits out of the four-in-five-bytes
+ * packing, the black level off, the lens shading's grid (17 x 13 gains, bilinear, per cell as
+ * camera_isp.c takes it), Malvar's 5x5 demosaic, the white balance's and AE's gains with the
+ * colour matrix (rows made by camera_isp.c's pipe_init()), sRGB's curve and the tone out of the
+ * 4096-step table.
+ *
+ * Pass 2, of those R, G, B bytes to NV12 (two integer targets: Y as R8UI, UV as RG8UI, the same
+ * draw -- MRT): Y with BT.601's matrix in the 1/65536ths and the rounding camera_isp.c's
+ * nv12_pair() uses, an optional 3x3 bilateral on Y (sigma in codes; 0: none) and an unsharp mask
+ * on it with the stills' threshold of 2 and its +-24 limit; U and V from the sum of the four
+ * pixels of each 2x2 block, the same fixed point. A pixel of a 2x2 block computes its block's
+ * UV for all four of them (the caller keeps one column in two).
+ *
+ * The arithmetic is camera_isp.c's, in the same order, so that tools/cam_gpu_host.c can hold the
+ * shader to a C reference of it (tools/cam_gpu_ref.h) on the host: the two agree to the code.
+ */
+#ifndef CAMERA_ISP_GPU_SHADERS_H
+#define CAMERA_ISP_GPU_SHADERS_H
+
+/* the full-screen triangle: three corners, no buffers */
+static const char isp_gpu_vertex_shader[] =
+	"#version 300 es\n"
+	"void main()\n"
+	"{\n"
+	"	vec2 p = vec2(float((gl_VertexID << 1) & 2), float(gl_VertexID & 2));\n"
+	"	gl_Position = vec4(p * 2.0 - 1.0, 0.0, 1.0);\n"
+	"}\n";
+
+static const char isp_gpu_raw_shader[] =
+	"#version 300 es\n"
+	"precision highp float;\n"
+	"precision highp int;\n"
+	"precision highp usampler2D;\n"
+	"\n"
+	"uniform usampler2D uRaw;      /* the frame's bytes: stride of them a line, height lines */\n"
+	"uniform int uRawW, uRawH;     /* the sensor's pixels */\n"
+	"uniform float uBlack;\n"
+	"uniform sampler2D uLsc;       /* 17 x 13, R, G and B gains */\n"
+	"uniform int uLscOn;\n"
+	"uniform int uCellsW, uCellsH; /* the frame's 2x2 cells */\n"
+	"uniform sampler2D uGamma;     /* 4096 steps, linear to 8 bits */\n"
+	"uniform vec3 uRow0, uRow1, uRow2;      /* the colour matrix with the gains folded in */\n"
+	"uniform int uRp, uBp;         /* where red and blue are in a 2x2 cell (0..3) */\n"
+	"uniform int uOutW, uOutH;\n"
+	"\n"
+	"out uvec4 oRGB;\n"
+	"\n"
+	"/* a pixel's 10 bits: four of them in five bytes, the low two in the fifth */\n"
+	"uint rawAt(int x, int y)\n"
+	"{\n"
+	"	int px = clamp(x, 0, uRawW - 1), py = clamp(y, 0, uRawH - 1);\n"
+	"	int g = px >> 2, b = px & 3;\n"
+	"	uint hi = texelFetch(uRaw, ivec2(g * 5 + b, py), 0).r;\n"
+	"	uint lo = texelFetch(uRaw, ivec2(g * 5 + 4, py), 0).r;\n"
+	"\n"
+	"	return (hi << 2) | ((lo >> (b * 2)) & 3u);\n"
+	"}\n"
+	"\n"
+	"float V(int x, int y)\n"
+	"{\n"
+	"	return max(float(rawAt(x, y)) - uBlack, 0.0);\n"
+	"}\n"
+	"\n"
+	"/* the lens shading's gains at a cell, between the grid's points, as camera_isp.c's lsc_at() */\n"
+	"vec3 LSC(int cx, int cy)\n"
+	"{\n"
+	"	if (uLscOn == 0) {\n"
+	"		return vec3(1.0);\n"
+	"	}\n"
+	"	float u = uCellsW > 1 ? float(cx) / float(uCellsW - 1) : 0.0;\n"
+	"	float v = uCellsH > 1 ? float(cy) / float(uCellsH - 1) : 0.0;\n"
+	"	float gx = u * 16.0, gy = v * 12.0;\n"
+	"	int x = int(gx), y = int(gy);\n"
+	"	float fx = gx - float(x), fy = gy - float(y);\n"
+	"\n"
+	"	x = clamp(x, 0, 15);\n"
+	"	y = clamp(y, 0, 11);\n"
+	"	vec3 a = mix(texelFetch(uLsc, ivec2(x, y), 0).rgb, texelFetch(uLsc, ivec2(x + 1, y), 0).rgb, fx);\n"
+	"	vec3 b = mix(texelFetch(uLsc, ivec2(x, y + 1), 0).rgb, texelFetch(uLsc, ivec2(x + 1, y + 1), 0).rgb, fx);\n"
+	"\n"
+	"	return mix(a, b, fy);\n"
+	"}\n"
+	"\n"
+	"/* 0 red, 1 blue, 2 green: which colour the site at (x, y) is */\n"
+	"int site(int x, int y)\n"
+	"{\n"
+	"	int q = (x & 1) + 2 * (y & 1);\n"
+	"\n"
+	"	return q == uRp ? 0 : q == uBp ? 1 : 2;\n"
+	"}\n"
+	"\n"
+	"/* Malvar, He and Cutler's 5x5 demosaic, in the paper's kernels (units of 1/8) */\n"
+	"vec3 demosaic(int x, int y, float c)\n"
+	"{\n"
+	"	float n = V(x, y - 1), s = V(x, y + 1), w = V(x - 1, y), e = V(x + 1, y);\n"
+	"	float nn = V(x, y - 2), ss = V(x, y + 2), ww = V(x - 2, y), ee = V(x + 2, y);\n"
+	"	float ne = V(x + 1, y - 1), nw = V(x - 1, y - 1), se = V(x + 1, y + 1), sw = V(x - 1, y + 1);\n"
+	"\n"
+	"	if (site(x, y) == 0) {\n"
+	"		float g = (4.0 * c + 2.0 * (n + s + w + e) - (nn + ss + ww + ee)) / 8.0;\n"
+	"		float b = (6.0 * c + 2.0 * (ne + nw + se + sw) - 1.5 * (nn + ss + ww + ee)) / 8.0;\n"
+	"\n"
+	"		return vec3(c, g, b);\n"
+	"	}\n"
+	"	if (site(x, y) == 1) {\n"
+	"		float g = (4.0 * c + 2.0 * (n + s + w + e) - (nn + ss + ww + ee)) / 8.0;\n"
+	"		float r = (6.0 * c + 2.0 * (ne + nw + se + sw) - 1.5 * (nn + ss + ww + ee)) / 8.0;\n"
+	"\n"
+	"		return vec3(r, g, c);\n"
+	"	}\n"
+	"	if (site(x - 1, y) == 0) {          /* green with red either side of it */\n"
+	"		float r = (5.0 * c + 4.0 * (w + e) - (ww + ee) - (n + s) + 0.5 * (nn + ss)) / 8.0;\n"
+	"		float b = (5.0 * c + 4.0 * (n + s) - (nn + ss) - (w + e) + 0.5 * (ww + ee)) / 8.0;\n"
+	"\n"
+	"		return vec3(r, c, b);\n"
+	"	}\n"
+	"	float r = (5.0 * c + 4.0 * (n + s) - (nn + ss) - (w + e) + 0.5 * (ww + ee)) / 8.0;\n"
+	"	float b = (5.0 * c + 4.0 * (w + e) - (ww + ee) - (n + s) + 0.5 * (nn + ss)) / 8.0;\n"
+	"\n"
+	"	return vec3(r, c, b);\n"
+	"}\n"
+	"\n"
+	"float curve(int i)\n"
+	"{\n"
+	"	return float(texelFetch(uGamma, ivec2(clamp(i, 0, 4095), 0), 0).r) * 255.0;   /* (R8 is 0..1) */\n"
+	"}\n"
+	"\n"
+	"void main()\n"
+	"{\n"
+	"	int x = int(gl_FragCoord.x), y = int(gl_FragCoord.y);\n"
+	"	/* the output pixel's nearest sensor site (the picture is the frame, or a whole part of it) */\n"
+	"	float fx = (float(x) + 0.5) * float(uRawW) / float(uOutW) - 0.5;\n"
+	"	float fy = (float(y) + 0.5) * float(uRawH) / float(uOutH) - 0.5;\n"
+	"	int sx = clamp(int(floor(fx + 0.5)), 0, uRawW - 1);\n"
+	"	int sy = clamp(int(floor(fy + 0.5)), 0, uRawH - 1);\n"
+	"	float c = V(sx, sy);\n"
+	"	vec3 rgb = demosaic(sx, sy, c);\n"
+	"	vec3 g = LSC(sx >> 1, sy >> 1);\n"
+	"\n"
+	"	rgb *= g;\n"
+	"	float r = dot(uRow0, rgb), gg = dot(uRow1, rgb), b = dot(uRow2, rgb);\n"
+	"\n"
+	"	oRGB = uvec4(uvec3(uint(curve(int(r + 0.5))), uint(curve(int(gg + 0.5))), uint(curve(int(b + 0.5)))), 255u);\n"
+	"}\n";
+
+static const char isp_gpu_nv12_shader[] =
+	"#version 300 es\n"
+	"precision highp float;\n"
+	"precision highp int;\n"
+	"precision highp usampler2D;\n"
+	"\n"
+	"uniform usampler2D uRGB;      /* pass 1's bytes */\n"
+	"uniform int uW, uH;\n"
+	"uniform float uSigma;         /* the bilateral's range sigma, in codes; 0: no noise reduction */\n"
+	"uniform float uAmount;        /* the unsharp mask's amount; 0: none */\n"
+	"uniform int uVideoRange;      /* 420v (BT.601 video range) rather than 420f */\n"
+	"\n"
+	"layout(location = 0) out uint oY;\n"
+	"layout(location = 1) out uvec2 oUV;\n"
+	"\n"
+	"ivec3 RGB(int x, int y)\n"
+	"{\n"
+	"	uvec4 c = texelFetch(uRGB, ivec2(clamp(x, 0, uW - 1), clamp(y, 0, uH - 1)), 0);\n"
+	"\n"
+	"	return ivec3(c.r, c.g, c.b);\n"
+	"}\n"
+	"\n"
+	"int luma(ivec3 c)\n"
+	"{\n"
+	"	int k0 = uVideoRange != 0 ? 16829 : 19595;\n"
+	"	int k1 = uVideoRange != 0 ? 33039 : 38470;\n"
+	"	int k2 = uVideoRange != 0 ? 6416 : 7471;\n"
+	"	int oy = uVideoRange != 0 ? (16 << 16) : 0;\n"
+	"\n"
+	"	return (k0 * c.r + k1 * c.g + k2 * c.b + oy + (1 << 15)) >> 16;\n"
+	"}\n"
+	"\n"
+	"void main()\n"
+	"{\n"
+	"	int x = int(gl_FragCoord.x), y = int(gl_FragCoord.y);\n"
+	"	int yc = luma(RGB(x, y));\n"
+	"	float blur = float(yc);\n"
+	"\n"
+	"	if (uSigma > 0.0) {         /* 3x3 bilateral on Y */\n"
+	"		float sum = float(yc), wsum = 1.0, ss = 2.0 * uSigma * uSigma;\n"
+	"\n"
+	"		for (int dy = -1; dy <= 1; dy++) {\n"
+	"			for (int dx = -1; dx <= 1; dx++) {\n"
+	"				float yn, d, w;\n"
+	"\n"
+	"				if (dx == 0 && dy == 0) {\n"
+	"					continue;\n"
+	"				}\n"
+	"				yn = float(luma(RGB(x + dx, y + dy)));\n"
+	"				d = yn - float(yc);\n"
+	"				w = 1.0 / (1.0 + d * d / ss);\n"
+	"				sum += w * yn;\n"
+	"				wsum += w;\n"
+	"			}\n"
+	"		}\n"
+	"		blur = sum / wsum;\n"
+	"	}\n"
+	"	float delta = float(yc) - blur;\n"
+	"	float t = abs(delta) > 2.0 ? delta - sign(delta) * 2.0 : 0.0;\n"
+	"	float add = t > 0.0 ? floor(t * uAmount + 0.5) : ceil(t * uAmount - 0.5);\n"
+	"	int outy = int(clamp(float(yc) + clamp(add, -24.0, 24.0), 0.0, 255.0) + 0.5);\n"
+	"\n"
+	"	/* the 2x2 block this pixel is in: its four pixels' sums, the same fixed point as nv12_pair() */\n"
+	"	int bx = (x >> 1) * 2, by = (y >> 1) * 2;\n"
+	"	ivec3 c00 = RGB(bx, by), c10 = RGB(bx + 1, by), c01 = RGB(bx, by + 1), c11 = RGB(bx + 1, by + 1);\n"
+	"	ivec3 sum = c00 + c10 + c01 + c11;\n"
+	"	int k3 = uVideoRange != 0 ? -9714 : -11058;\n"
+	"	int k4 = uVideoRange != 0 ? -19070 : -21710;\n"
+	"	int k5 = uVideoRange != 0 ? 28784 : 32768;\n"
+	"	int k6 = uVideoRange != 0 ? 28784 : 32768;\n"
+	"	int k7 = uVideoRange != 0 ? -24103 : -27439;\n"
+	"	int k8 = uVideoRange != 0 ? -4681 : -5329;\n"
+	"	int cb = (k3 * sum.r + k4 * sum.g + k5 * sum.b + (128 << 18) + (1 << 17) - 1) >> 18;\n"
+	"	int cr = (k6 * sum.r + k7 * sum.g + k8 * sum.b + (128 << 18) + (1 << 17) - 1) >> 18;\n"
+	"\n"
+	"	oY = uint(clamp(outy, 0, 255));\n"
+	"	oUV = uvec2(uint(clamp(cb, 0, 255)), uint(clamp(cr, 0, 255)));\n"
+	"}\n";
+
+#endif
diff -ruN a/userland/src/camera_isp.h b/userland/src/camera_isp.h
--- a/userland/src/camera_isp.h
+++ b/userland/src/camera_isp.h
@@ -133,11 +133,29 @@
 	float           saturation;     /* applied to every colour matrix set (1: none) */
 	float           contrast;       /* the S-curve folded into the gamma table (0: none) */
 	struct isp_fast fast;           /* the preview's half-resolution debayer, the NEON loops */
+	/*
+	 * The GPU ISP (src/camera_isp_gpu.c; boot-arg cam_gpu=1): the picture on the phone's Adreno through
+	 * OpenGL ES 3.0 off-screen, the same arithmetic in shaders. Off by default, and off for good when the
+	 * context cannot be made (the processor's path is the picture then). gpu_sigma is the 3x3 bilateral's
+	 * range sigma in codes (0: none); the unsharp mask's amount is the look's preview_sharp.
+	 */
+	bool            gpu;
+	float           gpu_sigma;
 };
 
 void isp_init(struct isp *isp);
 /* the fast paths (look NULL: the defaults -- both on) */
 void isp_set_fast(struct isp *isp, const struct isp_fast *fast);
+/*
+ * The GPU ISP (src/camera_isp_gpu.c) instead of the processor's (cam_gpu=1): off is the processor's path,
+ * which is also what a GPU path that will not start falls back to. sigma: the bilateral's, in codes (0: none).
+ */
+void isp_set_gpu(struct isp *isp, bool on, float sigma);
+/* the context, the programs and the textures up (log lines say what the driver said); false: no GPU path */
+bool isp_gpu_start(void);
+/* a whole picture through the GPU ISP; false: it could not be made, the processor's path is to make it */
+bool isp_gpu_render_nv12(const struct isp *isp, const struct hakios_camera_frame *f, const uint8_t *raw, uint8_t *y,
+    size_t y_stride, uint8_t *uv, size_t uv_stride, uint32_t width, uint32_t height, bool video_range);
 /* the tone of the picture: an S-curve of contrast c (0 none, ~0.3 gentle) into the gamma table, and saturation s
