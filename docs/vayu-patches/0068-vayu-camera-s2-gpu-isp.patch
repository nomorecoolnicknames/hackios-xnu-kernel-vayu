+typedef int GLint, GLsizei;
+typedef unsigned char GLubyte, GLboolean;
+typedef float GLfloat;
+typedef char GLchar;
+typedef ptrdiff_t GLsizeiptr, GLintptr;
+typedef void GLvoid;
+
+typedef struct osmesa_context *OSMesaContext;
+
