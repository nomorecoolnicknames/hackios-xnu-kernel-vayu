diff -ruN a/userland/tools/cam_gpu_bench.c b/userland/tools/cam_gpu_bench.c
--- a/userland/tools/cam_gpu_bench.c
+++ b/userland/tools/cam_gpu_bench.c
@@ -0,0 +1,216 @@
+/*
+ * cam_gpu_bench: the GPU ISP on the phone, measured against the processor's picture of the same frame
+ * (src/camera_isp_gpu.c; boot-arg cam_gpu=1 is the same path inside Camera.app).
+ *
+ *   cam_gpu_bench [--raw FILE] [--tuning FILE] [--width N] [--height N] [--frames N]
+ *                 [--sigma F] [--amount F] [--video] [--flat] [--out FILE]
+ *
+ * Without --raw the frame is a scene made up as an IMX582's RAW10 (tools/cam_gpu_scene.h; there is
+ * no dump of a real one in artifacts/, see the report): 1920x1080, stride 2400, black 64, bayer 0.
+ * --tuning is the camera's tuning file (the image's /redwood/fw/camera-imx582.isp): the lens shading
+ * and the colour matrix the ISP applies, and the same grid the scene is made against.
+ *
+ * What it prints, one line each (the numbers the report quotes are these):
+ *
+ *   cam_gpu_bench: <renderer>, <GL version>                       the context that was made
+ *   cam_gpu_bench: the processor 1920x1080 in N.N ms a frame      isp_render_nv12() for the reference
+ *   cam_gpu_bench: the GPU 1920x1080 in N.N ms a frame            isp_gpu_render_nv12(), with the readback
+ *   cam_gpu_bench: PSNR Y N.N dB, UV N.N dB                       the GPU's picture against the processor's
+ *
+ * Exit 0: both pictures were made. 1: the GPU path would not start (the line before says why).
+ */
+#include <math.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#include "camera_isp.h"
+#include "cam_gpu_scene.h"
+
+static double
+now_ms(void)
+{
+	struct timespec ts;
+
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return ts.tv_sec * 1e3 + ts.tv_nsec / 1e6;
+}
+
+static double
+psnr(const uint8_t *a, size_t a_stride, const uint8_t *b, size_t b_stride, int w, int h, int channels)
+{
+	double se = 0;
+	size_t n = 0;
+
+	for (int y = 0; y < h; y++) {
+		for (int x = 0; x < w * channels; x++) {
+			double d = (double)a[(size_t)y * a_stride + x] - (double)b[(size_t)y * b_stride + x];
+
+			se += d * d;
+			n++;
+		}
+	}
+	return se == 0 ? 99.0 : 10.0 * log10(255.0 * 255.0 / (se / (double)n));
+}
+
+int
+main(int argc, char **argv)
+{
+	const char *raw_path = NULL, *tuning = "/redwood/fw/camera-imx582.isp", *out_path = NULL;
+	int tuning_given = 0;
+	int width = 1920, height = 1080, frames = 30, video = 0, flat = 0;
+	float sigma = 0, amount = 0;
+	struct scene scene;
+	struct isp isp;
+	struct hakios_camera_frame f;
+	uint8_t *raw, *cpu_y, *cpu_uv, *gpu_y, *gpu_uv;
+	uint32_t stride;
+	double t0, cpu_ms, gpu_ms = 0;
+	int i;
+
+	for (i = 1; i < argc; i++) {
+		if (strcmp(argv[i], "--raw") == 0 && i + 1 < argc) {
+			raw_path = argv[++i];
+		} else if (strcmp(argv[i], "--tuning") == 0 && i + 1 < argc) {
+			tuning = argv[++i];
+			tuning_given = 1;
+		} else if (strcmp(argv[i], "--out") == 0 && i + 1 < argc) {
+			out_path = argv[++i];
+		} else if (strcmp(argv[i], "--width") == 0 && i + 1 < argc) {
+			width = atoi(argv[++i]);
+		} else if (strcmp(argv[i], "--height") == 0 && i + 1 < argc) {
+			height = atoi(argv[++i]);
+		} else if (strcmp(argv[i], "--frames") == 0 && i + 1 < argc) {
+			frames = atoi(argv[++i]);
+		} else if (strcmp(argv[i], "--sigma") == 0 && i + 1 < argc) {
+			sigma = (float)atof(argv[++i]);
+		} else if (strcmp(argv[i], "--amount") == 0 && i + 1 < argc) {
+			amount = (float)atof(argv[++i]);
+		} else if (strcmp(argv[i], "--video") == 0) {
+			video = 1;
+		} else if (strcmp(argv[i], "--flat") == 0) {
+			flat = 1;
+		} else {
+			fprintf(stderr, "usage: %s [--raw FILE] [--tuning FILE] [--width N] [--height N] [--frames N] "
+			    "[--sigma F] [--amount F] [--video] [--flat] [--out FILE]\n", argv[0]);
+			return 2;
+		}
+	}
+	if (width < 64 || height < 64 || (width & 1) || (height & 1)) {
+		fprintf(stderr, "cam_gpu_bench: width and height must be even and at least 64\n");
+		return 2;
+	}
+	stride = (uint32_t)width * 5 / 4;
+	raw = malloc((size_t)stride * height);
+	cpu_y = malloc((size_t)width * height);
+	cpu_uv = malloc((size_t)width * height / 2);
+	gpu_y = malloc((size_t)width * height);
+	gpu_uv = malloc((size_t)width * height / 2);
+	if (raw == NULL || cpu_y == NULL || cpu_uv == NULL || gpu_y == NULL || gpu_uv == NULL) {
+		fprintf(stderr, "cam_gpu_bench: no memory for %dx%d\n", width, height);
+		return 2;
+	}
+	isp_init(&isp);
+	memset(&scene, 0, sizeof(scene));
+	scene.width = width;
+	scene.height = height;
+	scene.detail = !flat;
+	scene.black = 64;
+	if (tuning != NULL && !isp_load_tuning(&isp, tuning)) {
+		if (tuning_given) {
+			fprintf(stderr, "cam_gpu_bench: %s is not a tuning file\n", tuning);
+			return 2;
+		}
+		fprintf(stderr, "cam_gpu_bench: %s is not there: no tuning, a smooth lens shading instead\n", tuning);
+	}
+	if (isp.tuning != NULL) {
+		isp_tune(&isp, 0.6f, 5000);
+	}
+	if (!isp.lsc.on) {
+		/* (the image has no tuning: a smooth falloff, the same in the scene and in the ISP) */
+		for (int y = 0; y < 13; y++) {
+			for (int x = 0; x < 17; x++) {
+				float u = (float)x / 16.0f * 2 - 1, v = (float)y / 12.0f * 2 - 1;
+				float g = 1.0f + 0.45f * (u * u * 0.6f + v * v * 0.4f);
+
+				for (int c = 0; c < 3; c++) {
+					isp.lsc.gain[c][y][x] = g;
+				}
+			}
+		}
+		isp.lsc.on = true;
+	}
+	memcpy(scene.gain, isp.lsc.gain, sizeof(scene.gain));
+	isp_set_tone(&isp, 0.0f, 1.0f);
+	if (raw_path != NULL) {
+		FILE *file = fopen(raw_path, "rb");
+
+		if (file == NULL || fread(raw, 1, (size_t)stride * height, file) != (size_t)stride * height) {
+			fprintf(stderr, "cam_gpu_bench: %s is not %ux%u RAW10 (%u bytes a line)\n", raw_path, width, height, stride);
+			return 2;
+		}
+		fclose(file);
+	} else {
+		scene_make(&scene, raw, stride);
+	}
+	memset(&f, 0, sizeof(f));
+	memcpy(f.magic, "RWFRAME1", 8);
+	f.header_bytes = sizeof(f);
+	f.width = (uint32_t)width;
+	f.height = (uint32_t)height;
+	f.stride = stride;
+	f.format = 1;
+	f.bayer = 0;
+	f.black = 64;
+	f.sensor = 1;
+	f.exposure_lines = 1000;
+	f.line_ns = 13190;
+	f.frame_lines = 2528;
+	f.frame_lines_min = 2528;
+	f.frame_lines_max = 2528;
+	f.gain = f.gain_unity = 256;
+	f.gain_max = 4096;
+	f.focus = HAKIOS_CAMERA_NO_FOCUS;
+
+	/* the processor's picture: isp_render_nv12() without the GPU behind it */
+	isp.gpu = false;
+	t0 = now_ms();
+	isp_render_nv12(&isp, &f, raw, cpu_y, width, cpu_uv, width, (uint32_t)width, (uint32_t)height, 0, (uint32_t)height,
+	    video != 0);
+	cpu_ms = now_ms() - t0;
+	printf("cam_gpu_bench: the processor %dx%d in %.1f ms a frame\n", width, height, cpu_ms);
+
+	/* the GPU's, the same frame and the same ISP state */
+	if (!isp_gpu_start()) {
+		fprintf(stderr, "cam_gpu_bench: the GPU ISP would not start (see the gpu_isp: lines)\n");
+		return 1;
+	}
+	isp_set_gpu(&isp, true, sigma);
+	isp.look.preview_sharp = amount;
+	for (int frame = 0; frame < frames; frame++) {
+		t0 = now_ms();
+		if (!isp_gpu_render_nv12(&isp, &f, raw, gpu_y, width, gpu_uv, width, (uint32_t)width, (uint32_t)height, video != 0)) {
+			fprintf(stderr, "cam_gpu_bench: the GPU ISP made no picture (frame %d)\n", frame);
+			return 1;
+		}
+		gpu_ms += now_ms() - t0;
+	}
+	printf("cam_gpu_bench: the GPU %dx%d in %.1f ms a frame (%d frames, with the readback)\n", width, height, gpu_ms / frames,
+	    frames);
+	printf("cam_gpu_bench: PSNR Y %.2f dB, UV %.2f dB (the GPU's picture against the processor's)\n",
+	    psnr(gpu_y, width, cpu_y, width, width, height, 1), psnr(gpu_uv, width, cpu_uv, width, width / 2, height / 2, 2));
+	if (out_path != NULL) {
+		FILE *file = fopen(out_path, "wb");
+
+		if (file != NULL) {
+			fwrite(gpu_y, 1, (size_t)width * height, file);
+			fwrite(gpu_uv, 1, (size_t)width * height / 2, file);
+			fclose(file);
+			printf("cam_gpu_bench: the GPU's picture in %s (%dx%d NV12)\n", out_path, width, height);
+		}
+	}
+	return 0;
+}
diff -ruN a/userland/tools/cam_gpu_host.c b/userland/tools/cam_gpu_host.c
--- a/userland/tools/cam_gpu_host.c
+++ b/userland/tools/cam_gpu_host.c
@@ -0,0 +1,531 @@
+/*
+ * cam_gpu_host: the GPU ISP's shaders (src/camera_isp_gpu_shaders.h) on this machine, through Mesa's
+ * EGL (a surfaceless OpenGL ES 3 context on llvmpipe/softpipe), held to two things:
+ *
+ *   - the C reference of the same arithmetic (tools/cam_gpu_ref.h): PSNR of the shader's NV12 against
+ *     it says whether the GLSL is right, a driver aside;
+ *   - the phone's own processor path (isp_render_nv12(), the same camera_isp.c the image ships): PSNR
+ *     of the shader's NV12 against that picture says what the GPU's demosaic, tone and colour cost
+ *     against the reference the camera work already has.
+ *
+ * The frame is a scene made up as an IMX582's RAW10 (tools/cam_gpu_scene.h; there is no dump of a real
+ * one in artifacts/), or a file given with --raw: the frame's bytes, 1920x1080, stride 2400, black 64,
+ * bayer 0. --tuning takes a camera's tuning file (fw-poco-x3-pro/camera-imx582.isp) for the lens
+ * shading and the colour matrix; without it the scene's own grid is a smooth falloff and the matrix
+ * is unity.
+ *
+ * Build (host): cc -O2 -I../src -I. cam_gpu_host.c ../src/camera_isp.c -lEGL -lGLESv2 -lm
+ * Run:          ./cam_gpu_host --tuning ../../fw-poco-x3-pro/camera-imx582.isp
+ */
+#include <EGL/egl.h>
+#include <EGL/eglext.h>
+#include <GLES3/gl3.h>
+#include <math.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+#include "camera_isp.h"
+#include "camera_isp_gpu_shaders.h"
+#include "cam_gpu_ref.h"
+#include "cam_gpu_scene.h"
+
+#define PF_420F         0x34323066
+
+static void
+check(const char *where)
+{
+	GLenum e;
+
+	while ((e = glGetError()) != GL_NO_ERROR) {
+		fprintf(stderr, "cam_gpu_host: GL error 0x%x at %s\n", e, where);
+	}
+}
+
+static double
+now_ms(void)
+{
+	struct timespec ts;
+
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return ts.tv_sec * 1e3 + ts.tv_nsec / 1e6;
+}
+
+static double
+psnr(const uint8_t *a, size_t a_stride, const uint8_t *b, size_t b_stride, int w, int h, int channels)
+{
+	double se = 0;
+	size_t n = 0;
+
+	for (int y = 0; y < h; y++) {
+		for (int x = 0; x < w * channels; x++) {
+			double d = (double)a[(size_t)y * a_stride + x] - (double)b[(size_t)y * b_stride + x];
+
+			se += d * d;
+			n++;
+		}
+	}
+	if (se == 0) {
+		return 99.0;
+	}
+	return 10.0 * log10(255.0 * 255.0 / (se / (double)n));
+}
+
+static GLuint
+shader(GLenum type, const char *text)
+{
+	GLuint s = glCreateShader(type);
+	GLint ok = 0;
+
+	glShaderSource(s, 1, &text, NULL);
+	glCompileShader(s);
+	glGetShaderiv(s, GL_COMPILE_STATUS, &ok);
+	if (!ok) {
+		char log[2048] = "";
+
+		glGetShaderInfoLog(s, sizeof(log) - 1, NULL, log);
+		fprintf(stderr, "cam_gpu_host: a shader will not compile: %s\n", log);
+		exit(1);
+	}
+	return s;
+}
+
+static GLuint
+program(const char *fragment)
+{
+	GLuint v = shader(GL_VERTEX_SHADER, isp_gpu_vertex_shader), f = shader(GL_FRAGMENT_SHADER, fragment), p = glCreateProgram();
+	GLint ok = 0;
+
+	glAttachShader(p, v);
+	glAttachShader(p, f);
+	glLinkProgram(p);
+	glGetProgramiv(p, GL_LINK_STATUS, &ok);
+	if (!ok) {
+		char log[2048] = "";
+
+		glGetProgramInfoLog(p, sizeof(log) - 1, NULL, log);
+		fprintf(stderr, "cam_gpu_host: a program will not link: %s\n", log);
+		exit(1);
+	}
+	return p;
+}
+
+static bool
+egl_start(EGLDisplay *display, EGLContext *context, EGLSurface *surface)
+{
+	PFNEGLGETPLATFORMDISPLAYEXTPROC get_platform = (PFNEGLGETPLATFORMDISPLAYEXTPROC)eglGetProcAddress("eglGetPlatformDisplayEXT");
+	EGLConfig config = NULL;
+	EGLint count = 0;
+	const EGLint attributes[] = {
+		EGL_SURFACE_TYPE, EGL_PBUFFER_BIT,
+		EGL_RENDERABLE_TYPE, EGL_OPENGL_ES3_BIT,
+		EGL_RED_SIZE, 8, EGL_GREEN_SIZE, 8, EGL_BLUE_SIZE, 8,
+		EGL_NONE
+	};
+	const EGLint context_attributes[] = { EGL_CONTEXT_MAJOR_VERSION, 3, EGL_CONTEXT_MINOR_VERSION, 0, EGL_NONE };
+	const EGLint pbuffer_attributes[] = { EGL_WIDTH, 16, EGL_HEIGHT, 16, EGL_NONE };
+
+	*display = get_platform != NULL ? get_platform(EGL_PLATFORM_SURFACELESS_MESA, EGL_DEFAULT_DISPLAY, NULL) : EGL_NO_DISPLAY;
+	if (*display == EGL_NO_DISPLAY) {
+		*display = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+	}
+	if (*display == EGL_NO_DISPLAY || !eglInitialize(*display, NULL, NULL)) {
+		fprintf(stderr, "cam_gpu_host: no EGL display: %s\n", eglGetError() == EGL_SUCCESS ? "?" : "eglInitialize failed");
+		return false;
+	}
+	if (!eglBindAPI(EGL_OPENGL_ES_API)) {
+		fprintf(stderr, "cam_gpu_host: eglBindAPI(OpenGL ES) failed\n");
+		return false;
+	}
+	if (!eglChooseConfig(*display, attributes, &config, 1, &count) || count < 1) {
+		fprintf(stderr, "cam_gpu_host: no OpenGL ES 3 configuration\n");
+		return false;
+	}
+	*surface = eglCreatePbufferSurface(*display, config, pbuffer_attributes);
+	*context = eglCreateContext(*display, config, EGL_NO_CONTEXT, context_attributes);
+	if (*context == EGL_NO_CONTEXT || !eglMakeCurrent(*display, *surface, *surface, *context)) {
+		fprintf(stderr, "cam_gpu_host: no OpenGL ES 3 context (0x%x)\n", eglGetError());
+		return false;
+	}
+	return true;
+}
+
+static void
+fill_lsc_synthetic(float gain[3][13][17])
+{
+	for (int y = 0; y < 13; y++) {
+		for (int x = 0; x < 17; x++) {
+			float u = (float)x / 16.0f * 2 - 1, v = (float)y / 12.0f * 2 - 1;
+			float r2 = u * u * 0.6f + v * v * 0.4f;
+			float g = 1.0f + 0.45f * r2;
+
+			for (int c = 0; c < 3; c++) {
+				gain[c][y][x] = g;
+			}
+		}
+	}
+}
+
+int
+main(int argc, char **argv)
+{
+	const char *raw_path = NULL, *tuning = NULL;
+	int width = 1920, height = 1080, frames = 3, video = 0, flat = 0;
+	float sigma = 0, amount = 0;
+	struct scene scene;
+	struct isp isp;
+	struct hakios_camera_frame f;
+	uint8_t *raw, *rgb = NULL;
+	uint8_t *cpu_y, *cpu_uv, *gl_y, *gl_uv, *ref_y, *ref_uv;
+	float rows[3][3];
+	uint32_t stride;
+	EGLDisplay display;
+	EGLContext context;
+	EGLSurface surface;
+	GLuint raw_texture, lsc_texture, gamma_texture, rgb_texture, y_texture, uv_texture, raw_fbo, nv12_fbo, vao, raw_program, nv12_program;
+	uint8_t *uv_scratch;
+	double t0, gl_ms = 0;
+	int i;
+
+	for (i = 1; i < argc; i++) {
+		if (strcmp(argv[i], "--raw") == 0 && i + 1 < argc) {
+			raw_path = argv[++i];
+		} else if (strcmp(argv[i], "--tuning") == 0 && i + 1 < argc) {
+			tuning = argv[++i];
+		} else if (strcmp(argv[i], "--width") == 0 && i + 1 < argc) {
+			width = atoi(argv[++i]);
+		} else if (strcmp(argv[i], "--height") == 0 && i + 1 < argc) {
+			height = atoi(argv[++i]);
+		} else if (strcmp(argv[i], "--frames") == 0 && i + 1 < argc) {
+			frames = atoi(argv[++i]);
+		} else if (strcmp(argv[i], "--sigma") == 0 && i + 1 < argc) {
+			sigma = (float)atof(argv[++i]);
+		} else if (strcmp(argv[i], "--amount") == 0 && i + 1 < argc) {
+			amount = (float)atof(argv[++i]);
+		} else if (strcmp(argv[i], "--video") == 0) {
+			video = 1;
+		} else if (strcmp(argv[i], "--flat") == 0) {
+			flat = 1;
+		} else {
+			fprintf(stderr, "usage: %s [--raw FILE] [--tuning FILE] [--width N] [--height N] [--frames N] "
+			    "[--sigma F] [--amount F] [--video]\n", argv[0]);
+			return 2;
+		}
+	}
+	if (width < 64 || height < 64 || (width & 1) || (height & 1)) {
+		fprintf(stderr, "cam_gpu_host: width and height must be even and at least 64\n");
+		return 2;
+	}
+	stride = (uint32_t)((width * 10 + 7) / 8);
+	/* the sensor's line is 2400 bytes at 1920; a packed line of any width is 5 bytes a four pixels */
+	if ((stride & 1) || stride < (uint32_t)width * 5 / 4) {
+		stride = (uint32_t)width * 5 / 4;
+	}
+	raw = malloc((size_t)stride * height);
+	if (raw == NULL) {
+		return 2;
+	}
+	isp_init(&isp);
+	isp.fast.preview_half = true;
+	isp.fast.neon = false;
+	memset(&scene, 0, sizeof(scene));
+	scene.width = width;
+	scene.height = height;
+	scene.detail = !flat;
+	scene.black = 64;
+	fill_lsc_synthetic(scene.gain);
+	if (tuning != NULL && !isp_load_tuning(&isp, tuning)) {
+		fprintf(stderr, "cam_gpu_host: %s is not a tuning file\n", tuning);
+		return 2;
+	}
+	if (tuning != NULL) {
+		isp_tune(&isp, 0.6f, 5000);
+		if (isp.lsc.on) {
+			memcpy(scene.gain, isp.lsc.gain, sizeof(scene.gain));
+		}
+	} else {
+		isp.lsc.on = true;
+		memcpy(isp.lsc.gain, scene.gain, sizeof(scene.gain));
+	}
+	{
+		static const float grey[9] = { 1.0f, 0, 0, 0, 1.0f, 0, 0, 0, 1.0f };
+
+		isp_set_ccm(&isp, grey);
+		isp_set_tone(&isp, 0.0f, 1.0f);
+	}
+	if (raw_path != NULL) {
+		FILE *file = fopen(raw_path, "rb");
+
+		if (file == NULL || fread(raw, 1, (size_t)stride * height, file) != (size_t)stride * height) {
+			fprintf(stderr, "cam_gpu_host: %s is not %ux%u RAW10 (%u bytes a line)\n", raw_path, width, height, stride);
+			return 2;
+		}
+		fclose(file);
+	} else {
+		scene_make(&scene, raw, stride);
+	}
+	memset(&f, 0, sizeof(f));
+	memcpy(f.magic, "RWFRAME1", 8);
+	f.header_bytes = sizeof(f);
+	f.width = (uint32_t)width;
+	f.height = (uint32_t)height;
+	f.stride = stride;
+	f.format = 1;
+	f.bayer = 0;
+	f.black = 64;
+	f.sensor = 1;
+
+	for (int c = 0; c < 3; c++) {
+		for (int j = 0; j < 3; j++) {
+			rows[c][j] = isp.ccm[c][j] * isp.wb[j] * isp.digital * (3836.0f / 959.0f);
+		}
+	}
+	cpu_y = malloc((size_t)width * height);
+	cpu_uv = malloc((size_t)width * height / 2);
+	gl_y = malloc((size_t)width * height);
+	gl_uv = malloc((size_t)width * height / 2);
+	ref_y = malloc((size_t)width * height);
+	ref_uv = malloc((size_t)width * height / 2);
+	rgb = malloc((size_t)width * height * 3);
+	uv_scratch = malloc((size_t)width * height * 2);
+	if (cpu_y == NULL || cpu_uv == NULL || gl_y == NULL || gl_uv == NULL || ref_y == NULL || ref_uv == NULL || rgb == NULL ||
+	    uv_scratch == NULL) {
+		fprintf(stderr, "cam_gpu_host: no memory for %dx%d\n", width, height);
+		return 2;
+	}
+	/* the processor's picture, the reference the camera work already has */
+	t0 = now_ms();
+	isp_render_nv12(&isp, &f, raw, cpu_y, width, cpu_uv, width, (uint32_t)width, (uint32_t)height, 0, (uint32_t)height, video != 0);
+	printf("cam_gpu_host: isp_render_nv12 %dx%d in %.1f ms\n", width, height, now_ms() - t0);
+	/* the C reference of the shaders */
+	{
+		struct gpu_ref ref;
+
+		memset(&ref, 0, sizeof(ref));
+		ref.raw = raw;
+		ref.raw_w = width;
+		ref.raw_h = height;
+		ref.stride = stride;
+		ref.black = 64;
+		ref.bayer = 0;
+		ref.lsc_on = isp.lsc.on ? 1 : 0;
+		ref.lsc = &isp.lsc.gain[0][0][0];
+		ref.gamma = isp.gamma;
+		ref.rows = &rows[0][0];
+		ref.out_w = width;
+		ref.out_h = height;
+		ref.sigma = sigma;
+		ref.amount = amount;
+		ref.video_range = video;
+		t0 = now_ms();
+		ref_pass1(&ref, rgb);
+		ref_pass2(&ref, rgb, ref_y, width, ref_uv, width);
+		printf("cam_gpu_host: the C reference in %.1f ms\n", now_ms() - t0);
+	}
+
+	if (!egl_start(&display, &context, &surface)) {
+		return 1;
+	}
+	printf("cam_gpu_host: %s / %s\n", glGetString(GL_RENDERER), glGetString(GL_VERSION));
+	raw_program = program(isp_gpu_raw_shader);
+	nv12_program = program(isp_gpu_nv12_shader);
+	glGenVertexArrays(1, &vao);
+	glBindVertexArray(vao);
+	glGenTextures(1, &raw_texture);
+	glBindTexture(GL_TEXTURE_2D, raw_texture);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+	glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+	glTexImage2D(GL_TEXTURE_2D, 0, GL_R8UI, (GLsizei)stride, height, 0, GL_RED_INTEGER, GL_UNSIGNED_BYTE, raw);
+	glGenTextures(1, &lsc_texture);
+	glBindTexture(GL_TEXTURE_2D, lsc_texture);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+	{
+		float grid[13 * 17 * 3];
+
+		for (int y = 0; y < 13; y++) {
+			for (int x = 0; x < 17; x++) {
+				for (int c = 0; c < 3; c++) {
+					grid[(y * 17 + x) * 3 + c] = isp.lsc.on ? isp.lsc.gain[c][y][x] : 1.0f;
+				}
+			}
+		}
+		glTexImage2D(GL_TEXTURE_2D, 0, GL_RGB16F, 17, 13, 0, GL_RGB, GL_FLOAT, grid);
+	}
+	glGenTextures(1, &gamma_texture);
+	glBindTexture(GL_TEXTURE_2D, gamma_texture);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+	glTexImage2D(GL_TEXTURE_2D, 0, GL_R8, 4096, 1, 0, GL_RED, GL_UNSIGNED_BYTE, isp.gamma);
+	glGenTextures(1, &rgb_texture);
+	glBindTexture(GL_TEXTURE_2D, rgb_texture);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+	glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8UI, width, height, 0, GL_RGBA_INTEGER, GL_UNSIGNED_BYTE, NULL);
+	glGenTextures(1, &y_texture);
+	glBindTexture(GL_TEXTURE_2D, y_texture);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+	glTexImage2D(GL_TEXTURE_2D, 0, GL_R8UI, width, height, 0, GL_RED_INTEGER, GL_UNSIGNED_BYTE, NULL);
+	glGenTextures(1, &uv_texture);
+	glBindTexture(GL_TEXTURE_2D, uv_texture);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+	glTexImage2D(GL_TEXTURE_2D, 0, GL_RG8UI, width, height, 0, GL_RG_INTEGER, GL_UNSIGNED_BYTE, NULL);
+	check("textures");
+	glGenFramebuffers(1, &raw_fbo);
+	glBindFramebuffer(GL_FRAMEBUFFER, raw_fbo);
+	glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, rgb_texture, 0);
+	if (glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE) {
+		fprintf(stderr, "cam_gpu_host: the RAW pass's framebuffer is not complete\n");
+		return 1;
+	}
+	{
+		const GLenum attachments[2] = { GL_COLOR_ATTACHMENT0, GL_COLOR_ATTACHMENT1 };
+
+		glGenFramebuffers(1, &nv12_fbo);
+		glBindFramebuffer(GL_FRAMEBUFFER, nv12_fbo);
+		glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, y_texture, 0);
+		glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT1, GL_TEXTURE_2D, uv_texture, 0);
+		glDrawBuffers(2, attachments);
+		if (glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE) {
+			fprintf(stderr, "cam_gpu_host: the NV12 pass's framebuffer is not complete\n");
+			return 1;
+		}
+	}
+	check("framebuffers");
+	for (int frame = 0; frame < frames; frame++) {
+		t0 = now_ms();
+		glUseProgram(raw_program);
+		glActiveTexture(GL_TEXTURE0);
+		glBindTexture(GL_TEXTURE_2D, raw_texture);
+		glActiveTexture(GL_TEXTURE1);
+		glBindTexture(GL_TEXTURE_2D, lsc_texture);
+		glActiveTexture(GL_TEXTURE2);
+		glBindTexture(GL_TEXTURE_2D, gamma_texture);
+		glBindFramebuffer(GL_FRAMEBUFFER, raw_fbo);
+		glViewport(0, 0, width, height);
+		glUniform1i(glGetUniformLocation(raw_program, "uRaw"), 0);
+		glUniform1i(glGetUniformLocation(raw_program, "uRawW"), width);
+		glUniform1i(glGetUniformLocation(raw_program, "uRawH"), height);
+		glUniform1f(glGetUniformLocation(raw_program, "uBlack"), 64.0f);
+		glUniform1i(glGetUniformLocation(raw_program, "uLsc"), 1);
+		glUniform1i(glGetUniformLocation(raw_program, "uLscOn"), isp.lsc.on ? 1 : 0);
+		glUniform1i(glGetUniformLocation(raw_program, "uCellsW"), width / 2);
+		glUniform1i(glGetUniformLocation(raw_program, "uCellsH"), height / 2);
+		glUniform1i(glGetUniformLocation(raw_program, "uGamma"), 2);
+		glUniform3f(glGetUniformLocation(raw_program, "uRow0"), rows[0][0], rows[0][1], rows[0][2]);
+		glUniform3f(glGetUniformLocation(raw_program, "uRow1"), rows[1][0], rows[1][1], rows[1][2]);
+		glUniform3f(glGetUniformLocation(raw_program, "uRow2"), rows[2][0], rows[2][1], rows[2][2]);
+		glUniform1i(glGetUniformLocation(raw_program, "uRp"), 0);
+		glUniform1i(glGetUniformLocation(raw_program, "uBp"), 3);
+		glUniform1i(glGetUniformLocation(raw_program, "uOutW"), width);
+		glUniform1i(glGetUniformLocation(raw_program, "uOutH"), height);
+		glDrawArrays(GL_TRIANGLES, 0, 3);
+		check("pass 1");
+		glBindFramebuffer(GL_FRAMEBUFFER, nv12_fbo);
+		glUseProgram(nv12_program);
+		glActiveTexture(GL_TEXTURE0);
+		glBindTexture(GL_TEXTURE_2D, rgb_texture);
+		glUniform1i(glGetUniformLocation(nv12_program, "uRGB"), 0);
+		glUniform1i(glGetUniformLocation(nv12_program, "uW"), width);
+		glUniform1i(glGetUniformLocation(nv12_program, "uH"), height);
+		glUniform1f(glGetUniformLocation(nv12_program, "uSigma"), sigma);
+		glUniform1f(glGetUniformLocation(nv12_program, "uAmount"), amount);
+		glUniform1i(glGetUniformLocation(nv12_program, "uVideoRange"), video);
+		glDrawArrays(GL_TRIANGLES, 0, 3);
+		glDrawArrays(GL_TRIANGLES, 0, 3);
+		check("pass 2");
+		glReadBuffer(GL_COLOR_ATTACHMENT0);
+		glPixelStorei(GL_PACK_ALIGNMENT, 1);
+		glPixelStorei(GL_PACK_ROW_LENGTH, width);
+		glReadPixels(0, 0, width, height, GL_RED_INTEGER, GL_UNSIGNED_BYTE, gl_y);
+		glReadBuffer(GL_COLOR_ATTACHMENT1);
+		glReadPixels(0, 0, width, height, GL_RG_INTEGER, GL_UNSIGNED_BYTE, uv_scratch);
+		glFinish();
+		gl_ms += now_ms() - t0;
+		if (glGetError() != GL_NO_ERROR) {
+			fprintf(stderr, "cam_gpu_host: an OpenGL ES error in frame %d\n", frame);
+			return 1;
+		}
+		for (int row = 0; row < height / 2; row++) {
+			const uint8_t *in = uv_scratch + (size_t)row * 2 * width * 2;
+			uint8_t *out = gl_uv + (size_t)row * width;
+
+			for (int x = 0; x < width / 2; x++) {
+				out[2 * x] = in[4 * x];
+				out[2 * x + 1] = in[4 * x + 1];
+			}
+		}
+	}
+	printf("cam_gpu_host: the shaders %dx%d in %.1f ms a frame (%.1f with the readback and the copy)\n", width, height,
+	    gl_ms / frames, gl_ms / frames);
+	{
+		double mg = 0, mr = 0, mc = 0;
+
+		for (int k = 0; k < width * height; k++) {
+			mg += gl_y[k];
+			mr += ref_y[k];
+			mc += cpu_y[k];
+		}
+		printf("cam_gpu_host: means Y shaders %.1f reference %.1f processor %.1f\n", mg / (width * height), mr / (width * height),
+		    mc / (width * height));
+	}
+	printf("cam_gpu_host: PSNR shaders against the C reference: Y %.2f dB, UV %.2f dB\n",
+	    psnr(gl_y, width, ref_y, width, width, height, 1), psnr(gl_uv, width, ref_uv, width, width / 2, height / 2, 2));
+	printf("cam_gpu_host: PSNR shaders against isp_render_nv12:   Y %.2f dB, UV %.2f dB\n",
+	    psnr(gl_y, width, cpu_y, width, width, height, 1), psnr(gl_uv, width, cpu_uv, width, width / 2, height / 2, 2));
+	printf("cam_gpu_host: PSNR C reference against isp_render_nv12: Y %.2f dB, UV %.2f dB\n",
+	    psnr(ref_y, width, cpu_y, width, width, height, 1), psnr(ref_uv, width, cpu_uv, width, width / 2, height / 2, 2));
+	{
+		FILE *file = fopen("cam_gpu_host.nv12", "wb");
+
+		if (file != NULL) {
+			fwrite(gl_y, 1, (size_t)width * height, file);
+			fwrite(gl_uv, 1, (size_t)width * height / 2, file);
+			fclose(file);
+			printf("cam_gpu_host: the shaders' picture in cam_gpu_host.nv12 (%dx%d)\n", width, height);
+		}
+	}
+	(void)PF_420F;
+	(void)surface;
+	return 0;
+}
+
+/*
+ * camera_isp.c's GPU path, which this program replaces with its own GL (the shaders are the same, the
+ * setting up is EGL's here instead of OSMesa's): the processor's picture in this program is the
+ * reference, made by isp_render_nv12() with no GPU behind it.
+ */
+bool
+isp_gpu_start(void)
+{
+	return false;
+}
+
+bool
+isp_gpu_render_nv12(const struct isp *isp, const struct hakios_camera_frame *f, const uint8_t *raw, uint8_t *y,
+    size_t y_stride, uint8_t *uv, size_t uv_stride, uint32_t width, uint32_t height, bool video_range)
+{
+	(void)isp;
+	(void)f;
+	(void)raw;
+	(void)y;
+	(void)y_stride;
+	(void)uv;
+	(void)uv_stride;
+	(void)width;
+	(void)height;
+	(void)video_range;
+	return false;
+}
diff -ruN a/userland/tools/cam_gpu_ref.h b/userland/tools/cam_gpu_ref.h
--- a/userland/tools/cam_gpu_ref.h
+++ b/userland/tools/cam_gpu_ref.h
@@ -0,0 +1,230 @@
+/*
+ * The C reference of the GPU ISP's shaders (src/camera_isp_gpu_shaders.h): the same arithmetic, the
+ * same order, so that tools/cam_gpu_host.c can hold the GLSL to something that is not a driver --
+ * and tools/cam_gpu_bench.c can say what the GPU's picture differs from on the phone (a second
+ * frame, the processor's, isp_render_nv12()'s).
+ *
+ * Not the phone's ISP: no OpenGL, no IOSurface, no threading. The inputs are what the shaders get:
+ * the frame's bytes, the lens shading's grid, the tone's table and the colour matrix's rows.
+ */
+#ifndef CAM_GPU_REF_H
+#define CAM_GPU_REF_H
+
+#include <math.h>
+#include <stdint.h>
+#include <string.h>
+
+#define REF_LSC_W       17
+#define REF_LSC_H       13
+
+struct gpu_ref {
+	const uint8_t  *raw;
+	int             raw_w, raw_h;   /* the sensor's pixels */
+	uint32_t        stride;
+	float           black;
+	int             bayer;
+	int             lsc_on;
+	const float    *lsc;            /* [3][REF_LSC_H][REF_LSC_W] */
+	const uint8_t  *gamma;          /* 4096 */
+	const float    *rows;           /* [3][3], the matrix with the gains folded in */
+	int             out_w, out_h;
+	float           sigma, amount;
+	int             video_range;
+};
+
+static inline uint32_t
+ref_raw_at(const struct gpu_ref *r, int x, int y)
+{
+	int px = x < 0 ? 0 : x > r->raw_w - 1 ? r->raw_w - 1 : x;
+	int py = y < 0 ? 0 : y > r->raw_h - 1 ? r->raw_h - 1 : y;
+	int g = px >> 2, b = px & 3;
+	uint32_t hi = r->raw[(size_t)py * r->stride + (size_t)g * 5 + b];
+	uint32_t lo = r->raw[(size_t)py * r->stride + (size_t)g * 5 + 4];
+
+	return (hi << 2) | ((lo >> (b * 2)) & 3u);
+}
+
+static inline float
+ref_V(const struct gpu_ref *r, int x, int y)
+{
+	float v = (float)ref_raw_at(r, x, y) - r->black;
+
+	return v < 0 ? 0 : v;
+}
+
+static inline int
+ref_site(const struct gpu_ref *r, int x, int y)
+{
+	int q = (x & 1) + 2 * (y & 1);
+	int rp = r->bayer == 1 ? 1 : r->bayer == 2 ? 2 : r->bayer == 3 ? 3 : 0;
+	int bp = 3 - rp;
+
+	return q == rp ? 0 : q == bp ? 1 : 2;
+}
+
+static inline void
+ref_demosaic(const struct gpu_ref *r, int x, int y, float c, float rgb[3])
+{
+	float n = ref_V(r, x, y - 1), s = ref_V(r, x, y + 1), w = ref_V(r, x - 1, y), e = ref_V(r, x + 1, y);
+	float nn = ref_V(r, x, y - 2), ss = ref_V(r, x, y + 2), ww = ref_V(r, x - 2, y), ee = ref_V(r, x + 2, y);
+	float ne = ref_V(r, x + 1, y - 1), nw = ref_V(r, x - 1, y - 1), se = ref_V(r, x + 1, y + 1), sw = ref_V(r, x - 1, y + 1);
+	float g = (4.0f * c + 2.0f * (n + s + w + e) - (nn + ss + ww + ee)) / 8.0f;
+
+	if (ref_site(r, x, y) == 0) {
+		rgb[0] = c;
+		rgb[1] = g;
+		rgb[2] = (6.0f * c + 2.0f * (ne + nw + se + sw) - 1.5f * (nn + ss + ww + ee)) / 8.0f;
+	} else if (ref_site(r, x, y) == 1) {
+		rgb[0] = (6.0f * c + 2.0f * (ne + nw + se + sw) - 1.5f * (nn + ss + ww + ee)) / 8.0f;
+		rgb[1] = g;
+		rgb[2] = c;
+	} else if (ref_site(r, x - 1, y) == 0) {
+		rgb[0] = (5.0f * c + 4.0f * (w + e) - (ww + ee) - (n + s) + 0.5f * (nn + ss)) / 8.0f;
+		rgb[1] = c;
+		rgb[2] = (5.0f * c + 4.0f * (n + s) - (nn + ss) - (w + e) + 0.5f * (ww + ee)) / 8.0f;
+	} else {
+		rgb[0] = (5.0f * c + 4.0f * (n + s) - (nn + ss) - (w + e) + 0.5f * (ww + ee)) / 8.0f;
+		rgb[1] = c;
+		rgb[2] = (5.0f * c + 4.0f * (w + e) - (ww + ee) - (n + s) + 0.5f * (nn + ss)) / 8.0f;
+	}
+}
+
+static inline void
+ref_lsc(const struct gpu_ref *r, int cx, int cy, float g[3])
+{
+	int cells_w = r->raw_w / 2, cells_h = r->raw_h / 2;
+	float u = cells_w > 1 ? (float)cx / (float)(cells_w - 1) : 0;
+	float v = cells_h > 1 ? (float)cy / (float)(cells_h - 1) : 0;
+	float gx = u * (REF_LSC_W - 1), gy = v * (REF_LSC_H - 1);
+	int x = (int)gx, y = (int)gy;
+	float fx, fy;
+
+	x = x < 0 ? 0 : x > REF_LSC_W - 2 ? REF_LSC_W - 2 : x;
+	y = y < 0 ? 0 : y > REF_LSC_H - 2 ? REF_LSC_H - 2 : y;
+	fx = gx - x;
+	fy = gy - y;
+	for (int c = 0; c < 3; c++) {
+		const float *t = r->lsc + ((size_t)c * REF_LSC_H + y) * REF_LSC_W + x;
+
+		g[c] = (t[0] * (1 - fx) + t[1] * fx) * (1 - fy) + (t[REF_LSC_W] * (1 - fx) + t[REF_LSC_W + 1] * fx) * fy;
+	}
+}
+
+static inline int
+ref_curve(const struct gpu_ref *r, float v)
+{
+	int i = (int)(v + 0.5f);
+
+	return r->gamma[i < 0 ? 0 : i > 4095 ? 4095 : i];
+}
+
+/* the frame to 8-bit R, G, B (pass 1): rgb is out_w x out_h x 3 */
+static inline void
+ref_pass1(const struct gpu_ref *r, uint8_t *rgb)
+{
+	for (int y = 0; y < r->out_h; y++) {
+		for (int x = 0; x < r->out_w; x++) {
+			float fx = ((float)x + 0.5f) * (float)r->raw_w / (float)r->out_w - 0.5f;
+			float fy = ((float)y + 0.5f) * (float)r->raw_h / (float)r->out_h - 0.5f;
+			int sx = (int)floorf(fx + 0.5f), sy = (int)floorf(fy + 0.5f);
+			float c, v[3], g[3];
+
+			sx = sx < 0 ? 0 : sx > r->raw_w - 1 ? r->raw_w - 1 : sx;
+			sy = sy < 0 ? 0 : sy > r->raw_h - 1 ? r->raw_h - 1 : sy;
+			c = ref_V(r, sx, sy);
+			ref_demosaic(r, sx, sy, c, v);
+			if (r->lsc_on) {
+				ref_lsc(r, sx >> 1, sy >> 1, g);
+			} else {
+				g[0] = g[1] = g[2] = 1;
+			}
+			v[0] *= g[0];
+			v[1] *= g[1];
+			v[2] *= g[2];
+			for (int k = 0; k < 3; k++) {
+				float s = r->rows[k * 3 + 0] * v[0] + r->rows[k * 3 + 1] * v[1] + r->rows[k * 3 + 2] * v[2];
+
+				rgb[((size_t)y * r->out_w + x) * 3 + k] = (uint8_t)ref_curve(r, s);
+			}
+		}
+	}
+}
+
+static inline int
+ref_luma(const struct gpu_ref *r, const uint8_t *rgb, int x, int y)
+{
+	int k0 = r->video_range ? 16829 : 19595, k1 = r->video_range ? 33039 : 38470, k2 = r->video_range ? 6416 : 7471;
+	int oy = r->video_range ? (16 << 16) : 0;
+	const uint8_t *p = rgb + ((size_t)y * r->out_w + x) * 3;
+
+	return (k0 * p[0] + k1 * p[1] + k2 * p[2] + oy + (1 << 15)) >> 16;
+}
+
+/* the R, G, B bytes to NV12 (pass 2) */
+static inline void
+ref_pass2(const struct gpu_ref *r, const uint8_t *rgb, uint8_t *y, size_t y_stride, uint8_t *uv, size_t uv_stride)
+{
+	int k3 = r->video_range ? -9714 : -11058, k4 = r->video_range ? -19070 : -21710, k5 = r->video_range ? 28784 : 32768;
+	int k6 = r->video_range ? 28784 : 32768, k7 = r->video_range ? -24103 : -27439, k8 = r->video_range ? -4681 : -5329;
+
+	for (int row = 0; row < r->out_h; row++) {
+		uint8_t *out = y + (size_t)row * y_stride;
+
+		for (int x = 0; x < r->out_w; x++) {
+			int yc = ref_luma(r, rgb, x, row);
+			float blur = (float)yc;
+
+			if (r->sigma > 0) {
+				float sum = (float)yc, wsum = 1, ss = 2.0f * r->sigma * r->sigma;
+
+				for (int dy = -1; dy <= 1; dy++) {
+					for (int dx = -1; dx <= 1; dx++) {
+						int nx = x + dx, ny = row + dy;
+						float yn, d, w;
+
+						if (dx == 0 && dy == 0) {
+							continue;
+						}
+						nx = nx < 0 ? 0 : nx > r->out_w - 1 ? r->out_w - 1 : nx;
+						ny = ny < 0 ? 0 : ny > r->out_h - 1 ? r->out_h - 1 : ny;
+						yn = (float)ref_luma(r, rgb, nx, ny);
+						d = yn - (float)yc;
+						w = 1.0f / (1.0f + d * d / ss);
+						sum += w * yn;
+						wsum += w;
+					}
+				}
+				blur = sum / wsum;
+			}
+			{
+				float delta = (float)yc - blur;
+				float t = fabsf(delta) > 2.0f ? delta - (delta > 0 ? 2.0f : -2.0f) : 0.0f;
+				float add = t > 0 ? floorf(t * r->amount + 0.5f) : ceilf(t * r->amount - 0.5f);
+				float o = (float)yc + (add < -24 ? -24 : add > 24 ? 24 : add);
+
+				out[x] = (uint8_t)(o < 0 ? 0 : o > 255 ? 255 : (int)(o + 0.5f));
+			}
+		}
+	}
+	for (int row = 0; row < r->out_h / 2; row++) {
+		uint8_t *out = uv + (size_t)row * uv_stride;
+
+		for (int x = 0; x < r->out_w / 2; x++) {
+			int bx = 2 * x, by = 2 * row;
+			const uint8_t *c00 = rgb + ((size_t)by * r->out_w + bx) * 3;
+			const uint8_t *c10 = rgb + ((size_t)by * r->out_w + bx + 1) * 3;
+			const uint8_t *c01 = rgb + ((size_t)(by + 1) * r->out_w + bx) * 3;
+			const uint8_t *c11 = rgb + ((size_t)(by + 1) * r->out_w + bx + 1) * 3;
+			int R = c00[0] + c10[0] + c01[0] + c11[0];
+			int G = c00[1] + c10[1] + c01[1] + c11[1];
+			int B = c00[2] + c10[2] + c01[2] + c11[2];
+			int cb = (k3 * R + k4 * G + k5 * B + (128 << 18) + (1 << 17) - 1) >> 18;
+			int cr = (k6 * R + k7 * G + k8 * B + (128 << 18) + (1 << 17) - 1) >> 18;
+
+			out[2 * x] = (uint8_t)(cb < 0 ? 0 : cb > 255 ? 255 : cb);
+			out[2 * x + 1] = (uint8_t)(cr < 0 ? 0 : cr > 255 ? 255 : cr);
+		}
+	}
+}
+
+#endif
diff -ruN a/userland/tools/cam_gpu_scene.h b/userland/tools/cam_gpu_scene.h
--- a/userland/tools/cam_gpu_scene.h
+++ b/userland/tools/cam_gpu_scene.h
@@ -0,0 +1,147 @@
+/*
+ * A frame for the GPU ISP's tests, when there is no dump of a real one (there is none of the IMX582's
+ * RAW10 in artifacts/: see the report): a scene of colour patches, a grey ramp, lines and a circle,
+ * made into the sensor's own numbers -- sRGB's curve undone, the lens shading's gains divided out (so
+ * that the ISP's grid puts them back), black 64, white 959 above it, a little noise -- and packed as
+ * MIPI RAW10, four pixels in five bytes, the way /dev/hakios-camera hands a frame over (the header's
+ * struct hakios_camera_frame: 1920x1080, stride 2400, bayer 0 (RGGB), format 1).
+ *
+ * The scene is the same on the host (tools/cam_gpu_host.c) and on the phone (tools/cam_gpu_bench.c):
+ * the two compare the same bytes, and the numbers in the report are of these frames.
+ */
+#ifndef CAM_GPU_SCENE_H
+#define CAM_GPU_SCENE_H
+
+#include <math.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define SCENE_LSC_W     17
+#define SCENE_LSC_H     13
+
+struct scene {
+	int             width, height;
+	int             detail;         /* the chart, the bars and the ramp (0: only the smooth background and the circle) */
+	uint32_t        black;
+	float           gain[3][SCENE_LSC_H][SCENE_LSC_W];      /* the lens shading's, as the ISP's grid has it */
+};
+
+/* the 24 patches of a colour chart, in sRGB's 8-bit values */
+static const uint8_t scene_patches[24][3] = {
+	{ 115, 82, 68 }, { 194, 150, 130 }, { 98, 122, 157 }, { 87, 108, 67 }, { 133, 128, 177 }, { 103, 189, 170 },
+	{ 214, 126, 44 }, { 80, 91, 166 }, { 193, 90, 99 }, { 94, 60, 108 }, { 157, 188, 64 }, { 224, 163, 46 },
+	{ 56, 61, 150 }, { 70, 148, 73 }, { 175, 54, 60 }, { 231, 199, 31 }, { 187, 86, 149 }, { 8, 133, 161 },
+	{ 243, 243, 242 }, { 200, 200, 200 }, { 160, 160, 160 }, { 122, 122, 121 }, { 85, 85, 85 }, { 52, 52, 52 },
+};
+
+static float
+scene_srgb_to_linear(float v)
+{
+	return v <= 0.04045f ? v / 12.92f : (float)pow((v + 0.055) / 1.055, 2.4);
+}
+
+/* the lens shading's gain at a cell, bilinear between the grid's points (camera_isp.c's lsc_at()) */
+static float
+scene_gain(const struct scene *s, int c, int cx, int cy, int cells_w, int cells_h)
+{
+	float u = cells_w > 1 ? (float)cx / (float)(cells_w - 1) : 0;
+	float v = cells_h > 1 ? (float)cy / (float)(cells_h - 1) : 0;
+	float gx = u * (SCENE_LSC_W - 1), gy = v * (SCENE_LSC_H - 1);
+	int x = (int)gx, y = (int)gy;
+	float fx, fy;
+
+	x = x < 0 ? 0 : x > SCENE_LSC_W - 2 ? SCENE_LSC_W - 2 : x;
+	y = y < 0 ? 0 : y > SCENE_LSC_H - 2 ? SCENE_LSC_H - 2 : y;
+	fx = gx - x;
+	fy = gy - y;
+	return (s->gain[c][y][x] * (1 - fx) + s->gain[c][y][x + 1] * fx) * (1 - fy) +
+	    (s->gain[c][y + 1][x] * (1 - fx) + s->gain[c][y + 1][x + 1] * fx) * fy;
+}
+
+/* one channel of the scene at (x, y), in sRGB 0..1 */
+static float
+scene_at(const struct scene *s, int x, int y, int c)
+{
+	int w = s->width, h = s->height;
+	float v;
+
+	/* the background: a smooth gradient, brighter to the right and to the middle */
+	v = 0.10f + 0.55f * ((float)x / (float)(w - 1)) * (0.55f + 0.45f * (1.0f - (float)abs(2 * y - h) / (float)h));
+	/* the chart: 6 columns by 4 rows, its left part */
+	if (s->detail) {
+		int px0 = w / 20, py0 = h / 10, pw = (w * 11 / 20) / 6, ph = (h * 3 / 5) / 4;
+		int px = x - px0, py = y - py0;
+
+		if (px >= 0 && py >= 0 && px < 6 * pw && py < 4 * ph) {
+			int patch = (py / ph) * 6 + px / pw;
+
+			/* a border of the background around each patch */
+			if ((px % pw) > 6 && (py % ph) > 6) {
+				v = scene_patches[patch][c] / 255.0f;
+			}
+		}
+	}
+	/* the grey ramp, the lower right */
+	if (s->detail) {
+		int rx = w * 13 / 20, ry = h * 7 / 10;
+
+		if (x >= rx && y >= ry && x < w * 19 / 20 && y < ry + h / 10) {
+			v = (float)(x - rx) / (float)(w * 6 / 20);
+		}
+	}
+	/* lines: 2-pixel bars, to see the demosaic and the unsharp mask work */
+	if (s->detail && y >= h * 3 / 4 && y < h * 3 / 4 + 40 && x >= w / 20 && x < w / 2) {
+		v = ((x / 2) % 2) ? 0.95f : 0.03f;
+	}
+	/* a circle, for the edges */
+	{
+		float dx = (float)(x - w * 3 / 4) / (float)w, dy = (float)(y - h / 4) / (float)h;
+
+		if (dx * dx + dy * dy < 0.0025f) {
+			v = 0.8f;
+		}
+	}
+	return v < 0 ? 0 : v > 1 ? 1 : v;
+}
+
+/* the frame's bytes: four sites in five, `stride` a line */
+static void
+scene_make(const struct scene *s, uint8_t *raw, uint32_t stride)
+{
+	int w = s->width, h = s->height;
+	uint32_t seed = 12345;
+	int cells_w = w / 2, cells_h = h / 2;
+
+	memset(raw, 0, (size_t)stride * h);
+	for (int y = 0; y < h; y++) {
+		uint8_t *line = raw + (size_t)y * stride;
+
+		for (int x = 0; x < w; x++) {
+			int q = (x & 1) + 2 * (y & 1);
+			int c = q == 0 ? 0 : q == 3 ? 2 : 1;      /* bayer 0, RGGB */
+			float v = scene_srgb_to_linear(scene_at(s, x, y, c)), g;
+			int code;
+
+			g = scene_gain(s, c, (x / 2) % cells_w, (y / 2) % cells_h, cells_w, cells_h);
+			v = g > 0.01f ? v / g : v;
+			seed = seed * 1664525u + 1013904223u;
+			code = (int)((float)s->black + v * 959.0f + (float)((int)((seed >> 16) % 7) - 3) + 0.5f);
+			if (code < 0) {
+				code = 0;
+			}
+			if (code > 1023) {
+				code = 1023;
+			}
+			{
+				int group = x >> 2, lane = x & 3;
+				uint8_t *g5 = line + (size_t)group * 5;
+
+				g5[lane] = (uint8_t)(code >> 2);
+				g5[4] = (uint8_t)(g5[4] | ((code & 3) << (lane * 2)));
+			}
+		}
+	}
+}
+
+#endif
