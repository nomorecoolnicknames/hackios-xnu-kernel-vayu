diff -ruN a/userland/src/camera_isp_gpu.c b/userland/src/camera_isp_gpu.c
--- a/userland/src/camera_isp_gpu.c
+++ b/userland/src/camera_isp_gpu.c
@@ -0,0 +1,598 @@
+/*
+ * The GPU ISP (boot-arg cam_gpu=1): the camera's RAW10 frame to NV12 on the phone's Adreno 640,
+ * through OpenGL ES 3.0 off-screen (Mesa's freedreno, the same library and off-screen interface
+ * the window server draws with: lib/libOSMesa.8.dylib, src/gl_osmesa.c).
+ *
+ * Why this file is separate from camera_isp.c: the processor's ISP is the fallback and the
+ * reference (tools/cam_gpu_host.c holds the shaders to a C reference of their arithmetic), and
+ * nothing of OpenGL ES is in the frame path when cam_gpu is not set. camera_isp.c calls
+ * isp_gpu_render_nv12() for a whole picture and takes its false for "the processor's path, then".
+ *
+ * The two passes are in src/camera_isp_gpu_shaders.h. What is here: the context (OSMesa, made
+ * once, on the first frame that asks for it, and made current on whichever thread renders), the
+ * textures (the frame's bytes as R8UI, the lens shading's 17x13 grid, the 4096-step curve, the
+ * colour matrix's rows), one draw a pass, and the reading back: Y as R8UI into its plane, UV as
+ * RG8UI into a buffer (each pixel of a 2x2 block has its block's U and V) and that compacted into
+ * the NV12 plane, one column in two.
+ *
+ * The cost that is not the GPU's: the frame's bytes go up (glTexSubImage2D, 2.6 MB at 1920x1080
+ * RAW10) and the picture comes down (glReadPixels; the Y plane in place, the UV through a buffer
+ * of the picture's size). With an IOSurface's memory as the textures and the targets
+ * (hakios_gl_surface_texture()'s way, the kernel's driver maps the surface) neither would be a
+ * copy; that is the next step, not this one, and this file says what it costs.
+ *
+ * Failure of any of it (no library in the image, no context, a shader the driver will not take)
+ * turns the GPU path off for the rest of the run, with one line saying which, and camera_isp.c
+ * makes the picture as it did before.
+ */
+#include <dlfcn.h>
+#include <math.h>
+#include <pthread.h>
+#include <stdarg.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "camera_isp.h"
+#include "camera_isp_gpu_shaders.h"
+
+/* ---- the OpenGL ES 3.0 functions this file calls, and nothing else ------------------------------ */
+
